  Substitutions specific to this guest. The universal float-elimination set ships
  inside bflat and is applied automatically for -\-libc zisk.
-->
<linker>
  <assembly fullname="System.Private.CoreLib">
    <!-- Nethermind's config binder is the only ChangeType caller in the closure, and the
         guest builds its config objects directly - but reachability alone compiles the
         whole IConvertible conversion matrix. Throwing keeps a future string-bound path loud. -->
    <type fullname="System.Convert">
      <method signature="System.Object ChangeType(System.Object,System.Type)" body="remove" />
      <method signature="System.Object ChangeType(System.Object,System.Type,System.IFormatProvider)" body="remove" />
    </type>
    <!-- The crash-info blob is for a debugger reading a dump; the guest has neither, and a fail-fast exits
         the same way without it. -->
    <type fullname="System.RuntimeExceptionHelpers">
      <method signature="System.Void SerializeCrashInfo(System.Runtime.RhFailFastReason,System.String,System.Exception)" body="stub" />
    </type>
  </assembly>
  <assembly fullname="Nethermind.Evm">
    <!-- Only ZisK's runtime exports the arith256 routines behind DIV, MOD, ADDMOD and MULMOD, so the
         shared build leaves the flag off and this guest turns it on; ILC folds every check it gates. -->
    <type fullname="Nethermind.Evm.ZiskArith256Flag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
    <!-- Only this guest links jump_dest.S, the JUMPDEST bitmap precompile, so the shared build leaves the
         flag off and this guest turns it on; ILC folds the check it gates. -->
    <type fullname="Nethermind.Evm.CodeAnalysis.ZiskJumpDestFlag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
  </assembly>
  <assembly fullname="Nethermind.Serialization.Ssz">
    <!-- Only ZisK's runtime exports the SHA-256 compression precompile merkleization hashes pairs with, so the
         shared build leaves the flag off and this guest turns it on; ILC folds the check it gates. -->
    <type fullname="Nethermind.Serialization.Ssz.Merkleization.ZiskSha256FFlag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
  </assembly>
  <assembly fullname="Nethermind.Core">
    <!-- ZisK runs memmove as a precompile, so Bytes.Copy calls it directly rather than through corelib. -->
    <type fullname="Nethermind.Core.Extensions.ZiskMemmoveFlag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
    <!-- ZisK lowers Zbb's rev8 to one native instruction, so byte swaps take ReverseEndianness. -->
    <type fullname="Nethermind.Core.Extensions.ZkEvmBitOperations">
      <method signature="System.Boolean get_HasByteReverse()" body="stub" value="true" />
    </type>
    <!-- Only a virtual ToString() reaches these, and the guest stringifies a block, header, transaction or
         signature solely into a failure message it never publishes; the formatting closure (DateTime, time
         zones, number formats) is ~180 KB of code. Stubs cannot return a string, so they throw instead. -->
    <type fullname="Nethermind.Core.Block">
      <method signature="System.String ToString(Nethermind.Core.Block/Format)" body="remove" />
    </type>
    <type fullname="Nethermind.Core.BlockHeader">
      <method signature="System.String ToString(System.String)" body="remove" />
    </type>
    <type fullname="Nethermind.Core.Transaction">
      <method signature="System.String ToString(System.String)" body="remove" />
    </type>
    <type fullname="Nethermind.Core.Crypto.Signature">
      <method signature="System.String ToString()" body="remove" />
    </type>
  </assembly>
</linker>
