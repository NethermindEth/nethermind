<Project>
  <PropertyGroup>
    <GmpSourceRoot Condition="'$(GmpSourceRoot)' == ''">$(MSBuildThisFileDirectory)gmp</GmpSourceRoot>
    <MclSourceRoot Condition="'$(MclSourceRoot)' == ''">$(MSBuildThisFileDirectory)mcl</MclSourceRoot>
    <CkzgSourceRoot Condition="'$(CkzgSourceRoot)' == ''">$(MSBuildThisFileDirectory)ckzg</CkzgSourceRoot>
    <BoringSourceRoot Condition="'$(BoringSourceRoot)' == ''">$(MSBuildThisFileDirectory)boringssl</BoringSourceRoot>
    <BoringSourcesManifest Condition="'$(BoringSourcesManifest)' == ''">$(MSBuildThisFileDirectory)boringssl-sources.props</BoringSourcesManifest>
    <GmpBindingsRoot Condition="'$(GmpBindingsRoot)' == ''">$(MSBuildThisFileDirectory)portable-gmp-bindings</GmpBindingsRoot>
    <MclBindingsRoot Condition="'$(MclBindingsRoot)' == ''">$(MSBuildThisFileDirectory)portable-mcl-bindings</MclBindingsRoot>
    <CkzgBindingsRoot Condition="'$(CkzgBindingsRoot)' == ''">$(MSBuildThisFileDirectory)portable-ckzg-bindings</CkzgBindingsRoot>
    <Secp256r1BindingsRoot Condition="'$(Secp256r1BindingsRoot)' == ''">$(MSBuildThisFileDirectory)portable-secp256r1-bindings</Secp256r1BindingsRoot>
    <_PrecompileIncludeFlags>-I&quot;$(GmpSourceRoot)/mini-gmp&quot; -I&quot;$(MclSourceRoot)/include&quot; -I&quot;$(MclSourceRoot)/src&quot; -I&quot;$(CkzgSourceRoot)/src&quot; -I&quot;$(CkzgSourceRoot)/bindings/csharp&quot; -I&quot;$(BlstSourceRoot)/bindings&quot; -I&quot;$(BoringSourceRoot)/include&quot; -DOPENSSL_NO_ASM -DBORINGSSL_IMPLEMENTATION -DOPENSSL_SMALL</_PrecompileIncludeFlags>
    <EmccExtraCFlags>$(EmccExtraCFlags) $(_PrecompileIncludeFlags)</EmccExtraCFlags>
    <EmccExtraLDFlags>$(EmccExtraLDFlags) $(_PrecompileIncludeFlags) -lc++ -lc++abi</EmccExtraLDFlags>
  </PropertyGroup>
  <Import Project="$(BoringSourcesManifest)" Condition="Exists('$(BoringSourcesManifest)')" />
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)Nethermind.GmpBindings.Browser.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Nethermind.MclBindings.Browser.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Nethermind.Crypto.SecP256r1.Browser.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)Ckzg.Bindings.Browser.csproj" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)gmp.c" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)mcl.cpp" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)ckzg.c" />
    <NativeFileReference Include="$(MSBuildThisFileDirectory)secp256r1.cc" />
    <Content Include="$(CkzgSourceRoot)/src/trusted_setup.txt" Link="wwwroot/kzg_trusted_setup.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GmpSourceRoot)/COPYING*" Link="wwwroot/licenses/gmp/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MclSourceRoot)/COPYRIGHT" Link="wwwroot/licenses/mcl/COPYRIGHT" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(CkzgSourceRoot)/LICENSE" Link="wwwroot/licenses/ckzg/LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(BoringSourceRoot)/LICENSE" Link="wwwroot/licenses/boringssl/LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GmpBindingsRoot)/LICENSE;$(GmpBindingsRoot)/THIRD-PARTY-NOTICES" Link="wwwroot/licenses/gmp-bindings/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MclBindingsRoot)/LICENSE;$(MclBindingsRoot)/THIRD-PARTY-NOTICES" Link="wwwroot/licenses/mcl-bindings/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(CkzgBindingsRoot)/LICENSE" Link="wwwroot/licenses/ckzg-bindings/LICENSE" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Secp256r1BindingsRoot)/LICENSE;$(Secp256r1BindingsRoot)/NOTICE" Link="wwwroot/licenses/secp256r1-bindings/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePrecompileSources" BeforeTargets="Build">
    <Error Condition="!Exists('$(GmpSourceRoot)/mini-gmp/mini-gmp-aliases.h') or !Exists('$(MclSourceRoot)/src/fp.cpp') or !Exists('$(CkzgSourceRoot)/src/ckzg.c') or !Exists('$(BoringSourcesManifest)')" Text="Run prepare-precompiles.ps1 and pass its source and binding properties to the browser build." />
  </Target>
  <Target Name="TrackBrowserPrecompileHeaders" AfterTargets="_BrowserWasmWriteRspForLinking">
    <ItemGroup>
      <_WasmLinkDependencies Include="$(GmpSourceRoot)/mini-gmp/*.c;$(GmpSourceRoot)/mini-gmp/*.h;$(MclSourceRoot)/src/fp.cpp;$(MclSourceRoot)/src/**/*.hpp;$(MclSourceRoot)/include/**/*.hpp;$(MclSourceRoot)/include/**/*.h;$(CkzgSourceRoot)/src/**/*.c;$(CkzgSourceRoot)/src/**/*.h;$(CkzgSourceRoot)/bindings/csharp/ckzg_wrap.c;$(CkzgSourceRoot)/bindings/csharp/ckzg_wrap.h;$(BoringSourceRoot)/include/**/*.h;$(BoringSourceRoot)/crypto/**/*.h;$(BoringSourceRoot)/crypto/**/*.cc.inc;$(BoringSourceRoot)/gen/**/*.h" />
    </ItemGroup>
  </Target>
</Project>
