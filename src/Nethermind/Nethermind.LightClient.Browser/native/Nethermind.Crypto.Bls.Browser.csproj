<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Nethermind.Crypto.Bls</AssemblyName>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <Version>1.1.0</Version>
    <RootNamespace>Nethermind.Crypto</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BlstBindingsRoot Condition="'$(BlstBindingsRoot)' == ''">$(MSBuildThisFileDirectory)portable-bindings</BlstBindingsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BlstBindingsRoot)/*.cs" />
  </ItemGroup>
  <Target Name="RequireBindings" BeforeTargets="CoreCompile" Condition="!Exists('$(BlstBindingsRoot)/Bls.cs')">
    <Error Text="Run prepare-native.ps1 and pass its BlstBindingsRoot property to build the browser BLS bindings." />
  </Target>
</Project>
