<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Nethermind.GmpBindings</AssemblyName>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Version>2.0.0</Version>
    <RootNamespace>Nethermind.GmpBindings</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <GmpBindingsRoot Condition="'$(GmpBindingsRoot)' == ''">$(MSBuildThisFileDirectory)portable-gmp-bindings</GmpBindingsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(GmpBindingsRoot)/**/*.cs" />
  </ItemGroup>
  <Target Name="RequireBindings" BeforeTargets="CoreCompile" Condition="!Exists('$(GmpBindingsRoot)/Gmp.cs')">
    <Error Text="Run prepare-precompiles.ps1 and pass its GmpBindingsRoot property to build the browser GMP bindings." />
  </Target>
</Project>
