<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Nethermind.MclBindings</AssemblyName>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Version>2.0.0</Version>
    <RootNamespace>Nethermind.MclBindings</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <MclBindingsRoot Condition="'$(MclBindingsRoot)' == ''">$(MSBuildThisFileDirectory)portable-mcl-bindings</MclBindingsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MclBindingsRoot)/**/*.cs" />
  </ItemGroup>
  <Target Name="RequireBindings" BeforeTargets="CoreCompile" Condition="!Exists('$(MclBindingsRoot)/Mcl.cs')">
    <Error Text="Run prepare-precompiles.ps1 and pass its MclBindingsRoot property to build the browser MCL bindings." />
  </Target>
</Project>
