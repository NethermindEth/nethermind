<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Nethermind.Crypto.SecP256k1</AssemblyName>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <Version>1.7.0</Version>
    <RootNamespace>Nethermind.Crypto</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <SecpBindingsRoot Condition="'$(SecpBindingsRoot)' == ''">$(MSBuildThisFileDirectory)secp-bindings</SecpBindingsRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SecpBindingsRoot)/*.cs" />
  </ItemGroup>
  <Target Name="RequireBindings" BeforeTargets="CoreCompile" Condition="!Exists('$(SecpBindingsRoot)/SecP256k1.cs')">
    <Error Text="Run prepare-native.ps1 and pass its SecpBindingsRoot property to build the browser secp256k1 bindings." />
  </Target>
</Project>
