<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      The native shim (src/native/arkiv-ffi, Rust) is Arkiv's own executor and GolemDB behind a C ABI. A normal build
      does not need Rust: the library is packaged when it has been built, and `-p:BuildArkivNative=true` builds it.
    -->
    <ArkivNativeDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'native', 'arkiv-ffi'))</ArkivNativeDir>
    <ArkivNativeTargetDir Condition="'$(ArkivNativeTargetDir)' == ''">$(ArkivNativeDir)target</ArkivNativeTargetDir>
    <ArkivNativeLibrary Condition="'$(ArkivNativeLibrary)' == ''">$(ArkivNativeTargetDir)/release/libarkiv_ffi.so</ArkivNativeLibrary>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethermind.Api\Nethermind.Api.csproj" />
    <ProjectReference Include="..\Nethermind.Blockchain\Nethermind.Blockchain.csproj" />
    <ProjectReference Include="..\Nethermind.Consensus\Nethermind.Consensus.csproj" />
    <ProjectReference Include="..\Nethermind.Init\Nethermind.Init.csproj" />
    <ProjectReference Include="..\Nethermind.JsonRpc\Nethermind.JsonRpc.csproj" />
    <ProjectReference Include="..\Nethermind.Network\Nethermind.Network.csproj" />
    <ProjectReference Include="..\Nethermind.State\Nethermind.State.csproj" />
    <ProjectReference Include="..\Nethermind.Synchronization\Nethermind.Synchronization.csproj" />
  </ItemGroup>

  <Target Name="BuildArkivNative" BeforeTargets="AssignTargetPaths" Condition="'$(BuildArkivNative)' == 'true'">
    <Exec Command="cargo build --release --locked" WorkingDirectory="$(ArkivNativeDir)" EnvironmentVariables="CARGO_TARGET_DIR=$(ArkivNativeTargetDir)" />
    <ItemGroup>
      <None Include="$(ArkivNativeLibrary)" Link="libarkiv_ffi.so" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(BuildArkivNative)' != 'true' And Exists('$(ArkivNativeLibrary)')">
    <None Include="$(ArkivNativeLibrary)" Link="libarkiv_ffi.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
