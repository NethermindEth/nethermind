<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The cargo workspace, and its target directory in particular, is not part of the C# project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);native/**</DefaultItemExcludes>
    <RustFlatNativeDir>$(MSBuildThisFileDirectory)native/</RustFlatNativeDir>
    <RustFlatLibraryName>libnethermind_flatdb.so</RustFlatLibraryName>
    <RustFlatLibrary>$(RustFlatNativeDir)target/release/$(RustFlatLibraryName)</RustFlatLibrary>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethermind.Core\Nethermind.Core.csproj" />
    <ProjectReference Include="..\Nethermind.Db\Nethermind.Db.csproj" />
    <ProjectReference Include="..\Nethermind.Db.Rocks\Nethermind.Db.Rocks.csproj" />
    <ProjectReference Include="..\Nethermind.State.Flat\Nethermind.State.Flat.csproj" />

    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nethermind.State.Flat.Rust.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nethermind.Runner.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Nethermind.Benchmark</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The native library is optional: without it the default C# backend runs, and the Rust backends fail fast. -->
  <ItemGroup Condition="Exists('$(RustFlatLibrary)')">
    <None Include="$(RustFlatLibrary)" Link="$(RustFlatLibraryName)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Opt in with -p:BuildRustFlat=true; needs cargo on the PATH. -->
  <Target Name="CargoBuildRustFlat" BeforeTargets="BeforeBuild" Condition="'$(BuildRustFlat)' == 'true'">
    <Exec Command="cargo build --release -p flatdb-ffi" WorkingDirectory="$(RustFlatNativeDir)" />
    <ItemGroup>
      <None Remove="$(RustFlatLibrary)" />
      <None Include="$(RustFlatLibrary)" Link="$(RustFlatLibraryName)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
