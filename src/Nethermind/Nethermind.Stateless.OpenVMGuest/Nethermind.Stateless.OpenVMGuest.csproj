<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nethermind.OpenVM.Runtime" />
    <PackageReference Include="Nethermind.Zkvm.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Main, the ZkvmThrow export and the failure protocol are identical in
         all three guests; only WriteOutput differs, and each guest supplies it
         as the other half of the partial class. Compiled in rather than
         referenced: ZkvmThrow is an UnmanagedCallersOnly export the runtime
         looks up in the guest assembly itself. -->
    <Compile Include="..\Nethermind.Stateless.Guest\Program.cs" Link="Guest\Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethermind.Stateless.Executor\Nethermind.Stateless.Executor.csproj" />
  </ItemGroup>

</Project>
