<linker>
  <assembly fullname="Nethermind.Evm.Precompiles">
    <!-- SP1's libzkevm takes BLS12-381 points in zkcrypto's layout rather than EIP-2537's. -->
    <type fullname="Nethermind.Evm.Precompiles.Sp1Bls12381LayoutFlag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
  </assembly>
  <assembly fullname="Nethermind.Evm">
    <!-- mul.S multiplies on the uint256_mul precompile. -->
    <type fullname="Nethermind.Evm.GuestMulFlag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
    <!-- Only SP1's runtime exports the 256-bit modular multiplication precompile MULMOD runs on. -->
    <type fullname="Nethermind.Evm.Sp1Uint256MulModFlag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
  </assembly>
  <assembly fullname="Nethermind.Serialization.Ssz">
    <!-- Only SP1's runtime exports the SHA-256 extend and compress precompiles merkleization hashes pairs with. -->
    <type fullname="Nethermind.Serialization.Ssz.Merkleization.Sp1Sha256Flag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
  </assembly>
  <assembly fullname="Nethermind.Core">
    <!-- SP1 rejects misaligned accesses, so its JIT guards every access it cannot prove aligned; the flag
         rounds pointers already on a boundary down to it, which lets the JIT prove the accesses through them. -->
    <type fullname="Nethermind.Core.Extensions.StrictAlignmentFlag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
    <!-- SP1 hands the guest its input in writable memory, which the witness keying reuses once the input is decoded. -->
    <type fullname="Nethermind.Core.Crypto.Sp1ReusableInputFlag">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
  </assembly>
</linker>
