<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
    <PackageReference Include="FastEnum" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="Nethermind.Crypto.SecP256k1" />
    <PackageReference Include="Nethermind.Numerics.Int256" />
    <PackageReference Include="NonBlocking" />
    <PackageReference Include="Testably.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethermind.Logging\Nethermind.Logging.csproj" />
    <ProjectReference Include="..\Nethermind.Serialization.Ssz\Nethermind.Serialization.Ssz.csproj" />
    <ProjectReference Include="..\Nethermind.Zkvm.Abstractions\Nethermind.Zkvm.Abstractions.csproj" Condition="'$(EnableZkEvm)' == 'true'" />
  </ItemGroup>

  <PropertyGroup>
    <NativeKeccakDir>$(MSBuildThisFileDirectory)..\..\native\nmkeccak\</NativeKeccakDir>
    <NativeKeccakSupported Condition="'$(EnableZkEvm)' != 'true' And $([MSBuild]::IsOSPlatform('Linux')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64' And ('$(RuntimeIdentifier)' == '' Or '$(RuntimeIdentifier)' == 'linux-x64')">true</NativeKeccakSupported>
  </PropertyGroup>

  <Target Name="ResolveNativeKeccakPaths" Condition="'$(NativeKeccakSupported)' == 'true'">
    <PropertyGroup>
      <NativeKeccakOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'libnmkeccak.so'))</NativeKeccakOutput>
    </PropertyGroup>
  </Target>

  <Target Name="BuildNativeKeccak" DependsOnTargets="ResolveNativeKeccakPaths" BeforeTargets="AssignTargetPaths" Condition="'$(NativeKeccakSupported)' == 'true'" Inputs="$(NativeKeccakDir)nmkeccak.c;$(NativeKeccakDir)build.sh;@(NativeKeccakSource)" Outputs="$(NativeKeccakOutput)">
    <Delete Files="$(NativeKeccakOutput)" />
    <Exec Command="command -v &quot;${CC:-gcc}&quot;" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="GccExitCode" />
    </Exec>
    <Exec Condition="'$(GccExitCode)' == '0'" Command="sh &quot;$(NativeKeccakDir)build.sh&quot; &quot;$(NativeKeccakOutput).$$.tmp&quot; &amp;&amp; mv -f &quot;$(NativeKeccakOutput).$$.tmp&quot; &quot;$(NativeKeccakOutput)&quot; || { rm -f &quot;$(NativeKeccakOutput).$$.tmp&quot;; exit 1; }" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="NativeKeccakExitCode" />
    </Exec>
    <Warning Condition="'$(GccExitCode)' != '0' And '$(CC)' != '' And ('$(TARGETARCH)' == '' Or '$(TARGETARCH)' == 'amd64')" Text="libnmkeccak.so was not built (no C compiler found); Keccak-256 uses the C# absorb." />
    <Warning Condition="'$(GccExitCode)' == '0' And '$(NativeKeccakExitCode)' != '0'" Text="libnmkeccak.so was not built (build.sh exit code $(NativeKeccakExitCode)); Keccak-256 uses the C# absorb." />
  </Target>

  <Target Name="IncludeNativeKeccak" AfterTargets="BuildNativeKeccak" BeforeTargets="AssignTargetPaths" Condition="'$(NativeKeccakSupported)' == 'true'">
    <ItemGroup Condition="Exists('$(NativeKeccakOutput)')">
      <None Include="$(NativeKeccakOutput)" Link="libnmkeccak.so" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="TrackNativeKeccakFileWrites" AfterTargets="BuildNativeKeccak" Condition="'$(NativeKeccakSupported)' == 'true'">
    <ItemGroup>
      <FileWrites Include="$(NativeKeccakOutput)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <NativeKeccakSource Include="$(NativeKeccakDir)xkcp\*" />
  </ItemGroup>
</Project>
