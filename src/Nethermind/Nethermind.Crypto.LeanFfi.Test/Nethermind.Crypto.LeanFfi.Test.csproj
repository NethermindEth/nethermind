<Project Sdk="Microsoft.NET.Sdk">

  <!-- Native generation is opt-in; the solution still compiles these tests without Rust. -->
  <Import Project="../tests.props" />

  <PropertyGroup>
    <DefineConstants Condition="'$(BuildLeanFfi)' == 'true'">$(DefineConstants);NATIVE_LEAN_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethermind.Crypto\Nethermind.Crypto.csproj" />
    <ProjectReference Include="..\Nethermind.Core.Test\Nethermind.Core.Test.csproj" />
    <ProjectReference Include="..\Nethermind.Consensus\Nethermind.Consensus.csproj" />
  </ItemGroup>

  <Target Name="GenerateLeanFixtures" BeforeTargets="BeforeBuild" DependsOnTargets="ResolveProjectReferences" Condition="'$(BuildLeanFfi)' == 'true'">
    <PropertyGroup>
      <LeanStartupStubName Condition="$([MSBuild]::IsOSPlatform('Windows'))">lean_startup_stub.dll</LeanStartupStubName>
      <LeanStartupStubName Condition="$([MSBuild]::IsOSPlatform('OSX'))">liblean_startup_stub.dylib</LeanStartupStubName>
      <LeanStartupStubName Condition="'$(LeanStartupStubName)' == ''">liblean_startup_stub.so</LeanStartupStubName>
    </PropertyGroup>
    <Exec Command="cargo build --release --locked --manifest-path &quot;$(MSBuildThisFileDirectory)../../../tools/lean-ffi/Cargo.toml&quot; --example lean_startup_stub" />
    <Exec Command="cargo run --release --locked --manifest-path &quot;$(MSBuildThisFileDirectory)../../../tools/lean-ffi/Cargo.toml&quot; --example fixtures -- &quot;$(MSBuildThisFileDirectory)../../../tools/lean-ffi/target/test-vectors&quot;" />
    <ItemGroup>
      <LeanVectors Include="$(MSBuildThisFileDirectory)../../../tools/lean-ffi/target/test-vectors/*.bin" />
      <LeanVectors Include="$(MSBuildThisFileDirectory)../../../tools/lean-ffi/target/release/examples/$(LeanStartupStubName)" />
    </ItemGroup>
    <Copy SourceFiles="@(LeanVectors)" DestinationFolder="$(OutDir)lean-vectors" SkipUnchangedFiles="true" />
  </Target>
</Project>
