<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../tests.props" />

  <!-- Nethermind.Crypto.Lean ships the library for linux-x64 and linux-arm64; Nethermind.Crypto.Lean.Testing ships the
       matching vectors, fixtures tool and startup stub. Elsewhere the suite compiles and is skipped. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);NATIVE_LEAN_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethermind.Crypto\Nethermind.Crypto.csproj" />
    <ProjectReference Include="..\Nethermind.Core.Test\Nethermind.Core.Test.csproj" />
    <ProjectReference Include="..\Nethermind.Consensus\Nethermind.Consensus.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PackageReference Include="Nethermind.Crypto.Lean.Testing" />
  </ItemGroup>
</Project>
