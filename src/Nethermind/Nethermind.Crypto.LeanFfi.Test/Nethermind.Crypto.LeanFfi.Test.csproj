<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../tests.props" />

  <!-- Nethermind.Crypto.Lean ships the library for linux-x64 and linux-arm64, and on opt-in the matching vectors,
       fixtures tool and startup stub in lean-vectors/. Elsewhere the suite compiles and is skipped. -->
  <!-- The live proving fixtures take several GB a test: only the native-lean CI job (or an explicit opt-in) runs them. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And '$(RunNativeLeanTests)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_LEAN_TESTS</DefineConstants>
    <NethermindCryptoLeanTestAssets>true</NethermindCryptoLeanTestAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nethermind.Crypto\Nethermind.Crypto.csproj" />
    <ProjectReference Include="..\Nethermind.Core.Test\Nethermind.Core.Test.csproj" />
    <ProjectReference Include="..\Nethermind.Consensus\Nethermind.Consensus.csproj" />
  </ItemGroup>
</Project>
