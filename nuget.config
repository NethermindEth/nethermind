<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Temporary for the EIP-8288 prototype: Nethermind.Crypto.Lean is not yet on nuget.org. Restore is pinned by the lock-file hash. -->
    <add key="nugettest.org" value="https://apiint.nugettest.org/v3/index.json" />
  </packageSources>
  <auditSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nugettest.org">
      <package pattern="Nethermind.Crypto.Lean" />
    </packageSource>
  </packageSourceMapping>
</configuration>
