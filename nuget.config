<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- PoC only: a local lean-bindings feed; a release maps Nethermind.Crypto.Lean* to nugettest.org or nuget.org. -->
    <add key="lean-local" value="/home/manuel/Work/Nethermind/Projects/lean-bindings.worktrees/poc-owner/artifacts-feed" />
    <!--<add key="nugettest.org" value="https://apiint.nugettest.org/v3/index.json" />-->
  </packageSources>
  <auditSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="lean-local">
      <package pattern="Nethermind.Crypto.Lean" />
      <package pattern="Nethermind.Crypto.Lean.Testing" />
    </packageSource>
    <!--<packageSource key="nugettest.org">
      <package pattern="" />
    </packageSource>-->
  </packageSourceMapping>
</configuration>
