<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="nugettest.org" value="https://apiint.nugettest.org/v3/index.json" />
  </packageSources>
  <auditSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- The experimental EIP-8288 native backend and its test assets are staged on nugettest.org. -->
    <packageSource key="nugettest.org">
      <package pattern="Nethermind.Crypto.Lean" />
      <package pattern="Nethermind.Crypto.Lean.Testing" />
    </packageSource>
  </packageSourceMapping>
</configuration>
