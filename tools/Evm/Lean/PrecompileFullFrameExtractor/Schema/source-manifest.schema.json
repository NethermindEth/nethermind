{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kernel",
    "roslynVersion",
    "admissionSha256",
    "sources",
    "members",
    "dependencies",
    "oracles",
    "ir",
    "lean"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kernel": {
      "const": "standard-mainnet-amsterdam-precompile-full-frame-stage-c"
    },
    "roslynVersion": {
      "type": "string"
    },
    "admissionSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/definitions/pin"
      }
    },
    "members": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "$ref": "#/definitions/member"
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 53,
      "maxItems": 53,
      "items": {
        "$ref": "#/definitions/pin"
      }
    },
    "oracles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/oracle"
      },
      "minItems": 18,
      "maxItems": 18
    },
    "ir": {
      "$ref": "#/definitions/artifact"
    },
    "lean": {
      "$ref": "#/definitions/artifact"
    }
  },
  "definitions": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role",
        "symbols"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "production",
            "stageA",
            "oracle",
            "proof",
            "target",
            "artifact",
            "local"
          ]
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "owner",
        "member",
        "kind",
        "sha256",
        "statementSha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "member": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "statementSha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "address",
        "path",
        "sha256",
        "namespace",
        "symbol"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "address": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "namespace": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
