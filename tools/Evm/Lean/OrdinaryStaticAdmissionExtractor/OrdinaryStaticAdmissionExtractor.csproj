  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Nethermind.Evm.Lean.OrdinaryStaticAdmissionExtractor.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
