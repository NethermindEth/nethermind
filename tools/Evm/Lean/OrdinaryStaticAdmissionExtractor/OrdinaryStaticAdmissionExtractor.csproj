<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Nethermind.Evm.Lean.OrdinaryStaticAdmissionExtractor</AssemblyName>
    <RootNamespace>Nethermind.Evm.Lean.OrdinaryStaticAdmissionExtractor</RootNamespace>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Test/**/*.cs" />
