    | location =>
        have selection : Control.Spec.shouldReadTransparent (transparentPreservesOperand node)
            (node.mode == .value) = false := by rw [preserves, mode]; rfl
        rw [mode] at selection
        rw [selection]
        simp [step, popOperands, applyNode, expression, mode]
    | readOnlyLocation =>
        have selection : Control.Spec.shouldReadTransparent (transparentPreservesOperand node)
            (node.mode == .value) = false := by rw [preserves, mode]; rfl
        rw [mode] at selection
        rw [selection]
        simp [step, popOperands, applyNode, expression, mode]

