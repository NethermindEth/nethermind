def expectedLocalOperand (constructing : Bool) (receiver : Operand) (mode : OperandMode)
    (returned receiverValue : Value) : Operand :=
  if constructing then
    if mode == .value then .immediate receiverValue else receiver
  else .immediate returned

theorem generatedLocalReturn_resume_step (program : Program) (input : Input)
    (machine : Machine) (caller callee : FrameId) (constructing : Bool)
    (receiver : Operand) (mode : OperandMode) (returned receiverValue : Value)
    (tail : List Task)
    (readable : constructing = true → mode = .value →
      readOperand { machine with work := tail, returned := none } receiver =
        .ok receiverValue) :
    let decision := Control.Generated.SelectLocalReturn constructing (mode == .value)
    decision = Control.Spec.localReturnTag
      (Control.Spec.selectLocalReturn constructing (mode == .value)) ∧
    step program input
        { machine with
          work := Task.resume caller callee (.local constructing receiver mode) :: tail
          returned := some returned } =
      StepResult.next { machine with
        work := tail
        returned := none
        operands := expectedLocalOperand constructing receiver mode returned receiverValue ::
          machine.operands } := by
  dsimp only
  constructor
  · exact Control.extracted_selectLocalReturn_correct constructing (mode == .value)
  · cases constructing with
    | false =>
        cases mode <;> simp [step, expectedLocalOperand]
    | true =>
        cases mode with
        | value =>
            have read := readable rfl rfl
            simp [step, expectedLocalOperand, read]
        | location => simp [step, expectedLocalOperand]
        | readOnlyLocation => simp [step, expectedLocalOperand]

theorem generatedFinishBlock_return_local_two_step (program : Program) (input : Input)
    (machine : Machine) (frame : RuntimeFrame) (block : Block)
    (skipped tail : List Task) (caller : FrameId) (constructing : Bool)
    (receiver : Operand) (mode : OperandMode) (receiverValue : Value)
    (present : findFrame? machine frame.id = some frame)
    (inside : block.exit ≠ .outside)
    (returns : (controlFinish block frame.carried).kind = Control.Spec.returnTag)
    (nearest : ResumeFree skipped)
    (readable : constructing = true → mode = .value →
      readOperand { machine with work := tail, returned := none } receiver =
        .ok receiverValue) :
    let result := generatedControlFinish block frame.carried
    let resume := Task.resume caller frame.id (.local constructing receiver mode)
    let resumed := { machine with work := resume :: tail, returned := some result.cursor.carried }
    result.kind = Control.Spec.returnTag ∧
      result.cursor.ordinal = block.ordinal ∧
      result.cursor.carried = frame.carried ∧
      Control.Generated.SelectLocalReturn constructing (mode == .value) =
        Control.Spec.localReturnTag
          (Control.Spec.selectLocalReturn constructing (mode == .value)) ∧
      step program input
          { machine with work := Task.finishBlock frame.id frame.functionSymbol block ::
              (skipped ++ resume :: tail) } = StepResult.next resumed ∧
      step program input resumed = StepResult.next { machine with
        work := tail
        returned := none
        operands := expectedLocalOperand constructing receiver mode result.cursor.carried
          receiverValue :: machine.operands } := by
  dsimp only
  obtain ⟨kindResult, ordinal, carried, finishStep⟩ :=
    generatedFinishBlock_return_resume_step program input machine frame block skipped tail
      caller (.local constructing receiver mode) present inside returns nearest
  obtain ⟨decision, resumeStep⟩ := generatedLocalReturn_resume_step program input machine
    caller frame.id constructing receiver mode (generatedControlFinish block frame.carried).cursor.carried
    receiverValue tail readable
  exact ⟨kindResult, ordinal, carried, decision, finishStep, resumeStep⟩

def NonConvertingTransparent (node : Node) : Prop :=
  node.kind = .argument ∨ node.kind = .declarationExpression ∨ node.kind = .expressionStatement

def transparentPreservesOperand (node : Node) : Bool :=
  node.kind == .argument || node.kind == .declarationExpression

theorem generatedTransparent_entry_step (program : Program) (input : Input)
    (machine : Machine) (frame : FrameId) (node child : Node) (tail : List Task) (fuel : Nat)
    (wrapper : NonConvertingTransparent node) (children : node.children = [child])
    (admitted : nodeTagsValid node = true) (bounded : fuel + 1 ≤ 9223372036854775807) :
    let result := Control.Generated.Tick ((fuel + 1 : Nat) : Int)
    result.exhausted = false ∧ result.remainingFuel = (fuel : Int) ∧
      step program input
          { machine with work := Task.eval frame node :: tail, csharpFuel := fuel + 1 } =
        StepResult.next { machine with
          work := Task.eval frame child :: Task.apply frame node 1 :: tail
          csharpFuel := result.remainingFuel.toNat } := by
  dsimp only
  rw [Control.extracted_tick_correct (fuel + 1) bounded]
  simp only [Control.encodeTick, Control.Spec.tick]
  constructor
  · trivial
  constructor
  · trivial
  rcases wrapper with kind | kind | kind <;>
    simp [step, tick, admitted, children, kind] <;> rfl

theorem generatedTransparent_completion_step (program : Program) (input : Input)
    (machine : Machine) (frame : FrameId) (node : Node) (tail : List Task)
    (operand : Operand) (operands : List Operand) (value : Value)
    (wrapper : NonConvertingTransparent node)
    (readable : Control.Spec.shouldReadTransparent (transparentPreservesOperand node)
        (node.mode == .value) = true →
      readOperand { machine with work := tail, operands := operands } operand = .ok value) :
    let reads := Control.Generated.ShouldReadTransparent (transparentPreservesOperand node)
      (node.mode == .value)
    reads = Control.Spec.shouldReadTransparent (transparentPreservesOperand node)
      (node.mode == .value) ∧
      step program input { machine with
          work := Task.apply frame node 1 :: tail, operands := operand :: operands } =
        StepResult.next { machine with
          work := tail
          operands := (if reads then Operand.immediate value else operand) :: operands } := by
  dsimp only
  rw [Control.extracted_shouldReadTransparent_correct]
  constructor
  · rfl
  rcases wrapper with argument | declaration | expression
  · simp [step, popOperands, applyNode, argument, transparentPreservesOperand,
      Control.Spec.shouldReadTransparent]
  · simp [step, popOperands, applyNode, declaration, transparentPreservesOperand,
      Control.Spec.shouldReadTransparent]
  · have preserves : transparentPreservesOperand node = false := by
      rw [transparentPreservesOperand, expression]
      rfl
    cases mode : node.mode with
    | value =>
        have selection : Control.Spec.shouldReadTransparent (transparentPreservesOperand node)
            (node.mode == .value) = true := by rw [preserves, mode]; rfl
        have read := readable selection
