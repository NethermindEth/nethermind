def generatedConsumeStateGasPartialGas (count : Nat) (gas : Gas)
    (result : Eip803x.Generated.StateGasChargeKernel.StateGasChargeResult) : Gas :=
  { value := if 0 < count then result.value else gas.value
    stateReservoir := if 1 < count then result.stateReservoir else gas.stateReservoir
    stateGasUsed := if 2 < count then result.stateGasUsed else gas.stateGasUsed
    stateGasSpill := if 3 < count then result.stateGasSpill else gas.stateGasSpill
    stateGasSpillRefunded := if 4 < count then result.stateGasSpillRefunded else gas.stateGasSpillRefunded }

def generatedConsumeStateGasPartialCell (count : Nat) (cell : Cell) (gas : Gas)
    (result : Eip803x.Generated.StateGasChargeKernel.StateGasChargeResult) : Cell :=
  let current := generatedConsumeStateGasPartialGas count gas result
  { cell with value := gasValue current.value current.stateReservoir current.stateGasUsed current.stateGasSpill current.stateGasSpillRefunded }

def generatedConsumeStateGasPartialFrame (count : Nat) (frame : RuntimeFrame)
    (result : Eip803x.Generated.StateGasChargeKernel.StateGasChargeResult) : RuntimeFrame :=
  if count = 0 then frame else { frame with carried :=
    match count with
    | 1 => .unsigned result.value
    | 2 => .signed result.stateReservoir
    | 3 => .signed result.stateGasUsed
    | 4 => .signed result.stateGasSpill
    | _ => .signed result.stateGasSpillRefunded }

