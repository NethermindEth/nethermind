    let evaluations := block.operations.flatMap (fun node =>
        [Task.eval frame.id node, Task.setLast frame.id]) ++
      (match block.branchValue with
       | none => []
       | some node => [Task.eval frame.id node, Task.setLast frame.id])
    step program input { machine with
        frames := [frame, { frame with carried := other }]
        work := Task.enterBlock frame.id frame.functionSymbol ordinal :: tail
        csharpFuel := fuel + 1 } =
