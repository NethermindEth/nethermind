def _root_.Option.toExcept (value : Option α) (message : String) : Except String α :=
  match value with
  | some value => pure value
  | none => throw message

def _root_.List.get? (values : List α) (index : Nat) : Option α := values[index]?

private def expectedPrefixIntegrity : String :=
  "7e53ced6f9a6e008ab21357359cd94c7af660977807b9c2f7a298daad36f4e7a"

private def uint64Max : Nat := 2 ^ 64 - 1
private def uint256Modulus : Nat := 2 ^ 256
private def int64Min : Int := -(2 ^ 63)
private def int64Max : Int := 2 ^ 63 - 1

structure Cell where
  id : CellId
  frame : FrameId
  symbol : String
  provenance : String
  value : Value
  alias : Option Location

structure RuntimeFrame where
  id : FrameId
  functionSymbol : String
  thisOperand : Operand
  cells : List (String × CellId)
  captures : List (Int × Operand)
  carried : Value

inductive ResumeKind where
  | local (constructing : Bool) (receiver : Operand) (mode : OperandMode)
  | staticField (nodeMode : OperandMode) (symbol provenance : String)

inductive Task where
  | enterBlock (frame : FrameId) (functionSymbol : String) (ordinal : Int)
  | eval (frame : FrameId) (node : Node)
  | apply (frame : FrameId) (node : Node) (childCount : Nat)
  | setLast (frame : FrameId)
  | finishBlock (frame : FrameId) (functionSymbol : String) (block : Block)
  | startPattern (frame : FrameId) (constant : Node) (negated : Bool)
  | finishPattern (input : Value) (negated : Bool)
  | resume (caller : FrameId) (callee : FrameId) (kind : ResumeKind)

structure Machine where
  work : List Task
  operands : List Operand
  frames : List RuntimeFrame
  cells : List Cell
  statics : List (String × CellId)
  tape : List Exchange
  requestsRev : List Request
  returned : Option Value
  nextFrame : FrameId
  nextCell : CellId
  csharpFuel : Nat

inductive StepResult where
  | next (machine : Machine)
  | done (execution : Execution)

private def valueKind : Value → String
  | .unit => "unit"
  | .null typeName => "null " ++ typeName
  | .boolean _ => "bool"
  | .unsigned _ => "ulong"
  | .signed _ => "long"
  | .uint256 _ => "UInt256"
  | .enum typeName _ => "enum " ++ typeName
  | .address _ => "address"
  | .bytes _ => "bytes"
  | .reference typeName _ => "reference " ++ typeName
  | .struct typeName _ => "struct " ++ typeName

private def requests (machine : Machine) : List Request := machine.requestsRev.reverse

private def reject (reason : String) (machine : Machine) : StepResult :=
  .done {
    outcome := .rejected reason (requests machine) machine.tape
    remainingCSharpFuel := machine.csharpFuel, rejection := some .unexpected }

private def rejectExternal (reason : Rejection) (machine : Machine) : StepResult :=
  .done {
    outcome := .rejected reason.detail (requests machine) machine.tape
    remainingCSharpFuel := machine.csharpFuel, rejection := some reason.code }

private def liftRuntime (value : Except String α) : Except Rejection α :=
  value.mapError (fun detail => { code := .unexpected, detail })

private def findFunction? (program : Program) (symbol : String) : Option Function :=
  program.functions.find? (fun function => function.signature.symbol == symbol)

private def findBlock? (function : Function) (ordinal : Int) : Option Block :=
  if ordinal < 0 then none else function.blocks.find? (fun block => block.ordinal == Int.toNat ordinal)

private def findFrame? (machine : Machine) (id : FrameId) : Option RuntimeFrame :=
  machine.frames.find? (fun frame => frame.id == id)

private def findCell? (machine : Machine) (id : CellId) : Option Cell :=
  machine.cells.find? (fun cell => cell.id == id)

private def replaceFrame (machine : Machine) (replacement : RuntimeFrame) : Machine :=
  { machine with frames := machine.frames.map (fun frame => if frame.id == replacement.id then replacement else frame) }

private def replaceCell (machine : Machine) (replacement : Cell) : Machine :=
  { machine with cells := machine.cells.map (fun cell => if cell.id == replacement.id then replacement else cell) }

private def setFrameCarried (machine : Machine) (frameId : FrameId) (value : Value) : Except String Machine := do
  let frame ← findFrame? machine frameId |>.toExcept s!"missing frame {frameId}"
  pure (replaceFrame machine { frame with carried := value })

private def setCapture (machine : Machine) (frameId : FrameId) (capture : Int) (value : Operand) : Except String Machine := do
  let frame ← findFrame? machine frameId |>.toExcept s!"missing frame {frameId}"
  let captures := (capture, value) :: frame.captures.filter (fun item => item.1 != capture)
  pure (replaceFrame machine { frame with captures := captures })

private def allocateCell
    (machine : Machine) (frame : FrameId) (symbol provenance : String) (value : Value)
    (alias : Option Location := none) : Machine × CellId :=
  let id := machine.nextCell
  ({ machine with
      cells := { id, frame, symbol, provenance, value, alias } :: machine.cells
      nextCell := id + 1 }, id)

private def bindCell (machine : Machine) (frameId : FrameId) (symbol : String) (cell : CellId) : Except String Machine := do
  let frame ← findFrame? machine frameId |>.toExcept s!"missing frame {frameId}"
  let bindings := (symbol, cell) :: frame.cells.filter (fun item => item.1 != symbol)
  pure (replaceFrame machine { frame with cells := bindings })

private def allocateBinding
    (machine : Machine) (frameId : FrameId) (symbol provenance : String) (value : Value)
    (alias : Option Location := none) : Except String (Machine × Location) := do
  let (machine, id) := allocateCell machine frameId symbol provenance value alias
  let machine ← bindCell machine frameId symbol id
  pure (machine, { root := id, fields := [], readOnly := false, provenance })

private def field? : List (String × Value) → String → Option Value
  | [], _ => none
  | (name, value) :: tail, wanted => if name == wanted then some value else field? tail wanted

private def setField : List (String × Value) → String → Value → List (String × Value)
  | [], name, replacement => [(name, replacement)]
  | (name, value) :: tail, wanted, replacement =>
      if name == wanted then (name, replacement) :: tail
      else (name, value) :: setField tail wanted replacement

private def readFields : Value → List String → Except String Value
  | value, [] => pure value
  | .struct typeName fields, name :: tail => do
      let value ← field? fields name |>.toExcept s!"missing field {typeName}.{name}"
      readFields value tail
  | value, _ => throw s!"field read from {valueKind value}"

private def writeFields : Value → List String → Value → Except String Value
  | _, [], replacement => pure replacement
  | .struct typeName fields, [name], replacement =>
      pure (.struct typeName (setField fields name replacement))
  | .struct typeName fields, name :: tail, replacement => do
      let old ← field? fields name |>.toExcept s!"missing field {typeName}.{name}"
      let updated ← writeFields old tail replacement
      pure (.struct typeName (setField fields name updated))
  | value, _, _ => throw s!"field write to {valueKind value}"

private def readLocationBase : Nat → Machine → Location → Except String Value
  | 0, _, _ => throw "location alias cycle"
  | hops + 1, machine, location => do
      let cell ← findCell? machine location.root |>.toExcept s!"missing cell {location.root}"
      match cell.alias with
      | some alias =>
          readLocationBase hops machine { alias with fields := alias.fields ++ location.fields }
      | none => readFields cell.value location.fields

private def readLocation (machine : Machine) (location : Location) : Except String Value :=
  readLocationBase (machine.cells.length + 1) machine location

private def resolveLocationAux : Nat → Machine → Location → Except String Location
  | 0, _, _ => throw "location alias cycle"
  | hops + 1, machine, location => do
      let cell ← findCell? machine location.root |>.toExcept s!"missing cell {location.root}"
      match cell.alias with
      | some alias =>
          resolveLocationAux hops machine
            { alias with fields := alias.fields ++ location.fields, readOnly := location.readOnly || alias.readOnly }
      | none =>
          let suffix := if location.fields.isEmpty then "" else "." ++ String.intercalate "." location.fields
          pure { location with provenance := cell.provenance ++ suffix }

private def resolveLocation (machine : Machine) (location : Location) : Except String Location :=
  resolveLocationAux (machine.cells.length + 1) machine location

private def readOperand (machine : Machine) : Operand → Except String Value
  | .immediate value => pure value
  | .location location => readLocation machine location

private theorem readLocationBase_cells_eq (left right : Machine)
    (cells : left.cells = right.cells) (fuel : Nat) (location : Location) :
    readLocationBase fuel left location = readLocationBase fuel right location := by
  induction fuel generalizing location with
  | zero => rfl
  | succ fuel ih => simp only [readLocationBase, findCell?, cells, ih]

theorem readOperand_cells_eq (left right : Machine) (cells : left.cells = right.cells)
    (operand : Operand) : readOperand left operand = readOperand right operand := by
  cases operand with
  | immediate value => rfl
  | location location =>
      simp only [readOperand, readLocation, cells,
        readLocationBase_cells_eq left right cells]

private def writeLocationAux : Nat → Machine → Location → Value → Except String Machine
  | 0, _, _, _ => throw "location alias cycle"
  | hops + 1, machine, location, value => do
      if location.readOnly then throw s!"readonly location {location.provenance}"
      let cell ← findCell? machine location.root |>.toExcept s!"missing cell {location.root}"
      match cell.alias with
      | some alias =>
          let target := { alias with fields := alias.fields ++ location.fields }
          writeLocationAux hops machine target value
      | none =>
          let updated ← writeFields cell.value location.fields value
          pure (replaceCell machine { cell with value := updated })

private def writeLocation (machine : Machine) (location : Location) (value : Value) : Except String Machine :=
  writeLocationAux (machine.cells.length + 1) machine location value

private theorem writeLocationAux_prepend_success
    (before after : Machine) (addedCells : List Cell)
    (disjoint : ∀ added ∈ addedCells, ∀ cell ∈ before.cells, added.id ≠ cell.id)
    (fuel more : Nat) (location : Location) (value : Value)
    (enough : fuel ≤ more)
    (succeeded : writeLocationAux fuel before location value = .ok after) :
    writeLocationAux more { before with cells := addedCells ++ before.cells } location value =
      .ok { after with cells := addedCells ++ after.cells } := by
  induction fuel generalizing more location with
  | zero => simp [writeLocationAux] at succeeded
  | succ fuel induction =>
      cases more with
      | zero => omega
      | succ more =>
          cases readonly : location.readOnly with
          | true => simp [writeLocationAux, readonly, bind, Except.bind] at succeeded
          | false =>
              cases found : findCell? before location.root with
              | none =>
                  simp [writeLocationAux, readonly, found, Option.toExcept, bind, Except.bind] at succeeded
              | some cell =>
                  have identity : cell.id = location.root := by
                    simpa using List.find?_some found
                  have absent : addedCells.find? (fun candidate => candidate.id == location.root) = none := by
                    apply List.find?_eq_none.mpr
                    intro candidate member
                    simp only [beq_iff_eq]
                    intro equal
                    exact disjoint candidate member cell (List.mem_of_find?_eq_some found)
                      (equal.trans identity.symm)
                  have found' : findCell? { before with cells := addedCells ++ before.cells } location.root = some cell := by
                    simpa only [findCell?, List.find?_append, absent, Option.or] using found
                  cases alias : cell.alias with
                  | some target =>
                      simp only [writeLocationAux, readonly, Bool.false_eq_true, ↓reduceIte, found,
                        Option.toExcept, bind, Except.bind, pure, Except.pure, alias] at succeeded
                      simp only [writeLocationAux, readonly, Bool.false_eq_true, ↓reduceIte, found',
                        Option.toExcept, bind, Except.bind, pure, Except.pure, alias]
                      exact induction more _ (by omega) succeeded
                  | none =>
                      cases changed : writeFields cell.value location.fields value with
                      | error detail =>
                          simp [writeLocationAux, readonly, found, alias, changed,
                            Option.toExcept, bind, Except.bind, pure, Except.pure] at succeeded
                      | ok updated =>
                          have afterEq : replaceCell before { cell with value := updated } = after := by
                            simpa [writeLocationAux, readonly, found, alias, changed,
                              Option.toExcept, bind, Except.bind, pure, Except.pure] using succeeded
                          subst after
                          have untouched : addedCells.map (fun candidate =>
                              if candidate.id = cell.id then { cell with value := updated, alias := none } else candidate) = addedCells := by
                            conv => rhs; rw [← List.map_id addedCells]
                            apply List.map_congr_left
                            intro candidate member
                            simp [disjoint candidate member cell (List.mem_of_find?_eq_some found)]
                          simp [writeLocationAux, readonly, found', alias, changed,
                            Option.toExcept, bind, Except.bind, pure, Except.pure,
                            replaceCell, List.map_append, untouched]

private theorem writeLocationAux_cells_eq_success
    (left right after : Machine) (same : left.cells = right.cells)
    (fuel : Nat) (location : Location) (value : Value)
    (succeeded : writeLocationAux fuel left location value = .ok after) :
    writeLocationAux fuel right location value = .ok { right with cells := after.cells } := by
  induction fuel generalizing location with
  | zero => simp [writeLocationAux] at succeeded
  | succ fuel induction =>
      cases readonly : location.readOnly with
      | true => simp [writeLocationAux, readonly, bind, Except.bind] at succeeded
      | false =>
          cases found : findCell? left location.root with
          | none =>
              simp [writeLocationAux, readonly, found, Option.toExcept, bind, Except.bind] at succeeded
          | some cell =>
              have found' : findCell? right location.root = some cell := by
                simpa only [findCell?, ← same] using found
              cases alias : cell.alias with
              | some target =>
                  simp only [writeLocationAux, readonly, Bool.false_eq_true, ↓reduceIte, found,
                    Option.toExcept, bind, Except.bind, pure, Except.pure, alias] at succeeded
                  simp only [writeLocationAux, readonly, Bool.false_eq_true, ↓reduceIte, found',
                    Option.toExcept, bind, Except.bind, pure, Except.pure, alias]
                  exact induction _ succeeded
              | none =>
                  cases changed : writeFields cell.value location.fields value with
                  | error detail =>
                      simp [writeLocationAux, readonly, found, alias, changed,
                        Option.toExcept, bind, Except.bind, pure, Except.pure] at succeeded
                  | ok updated =>
                      have afterEq : replaceCell left { cell with value := updated } = after := by
                        simpa [writeLocationAux, readonly, found, alias, changed,
                          Option.toExcept, bind, Except.bind, pure, Except.pure] using succeeded
                      subst after
                      simp [writeLocationAux, readonly, found', alias, changed,
                        Option.toExcept, bind, Except.bind, pure, Except.pure, replaceCell, same]

private theorem writeLocation_cells_eq_success
    (left right after : Machine) (same : left.cells = right.cells)
    (location : Location) (value : Value)
    (succeeded : writeLocation left location value = .ok after) :
    writeLocation right location value = .ok { right with cells := after.cells } := by
  unfold writeLocation at succeeded ⊢
  rw [← same]
  exact writeLocationAux_cells_eq_success left right after same _ location value succeeded

private def writeOperand (machine : Machine) (operand : Operand) (value : Value) : Except String Machine :=
  match operand with
  | .location location => writeLocation machine location value
  | .immediate _ => throw "value operand is not writable"

private def valueEqFuel : Nat → Value → Value → Bool
  | 0, _, _ => false
  | _fuel + 1, .unit, .unit => true
  | _fuel + 1, .null _, .null _ => true
  | _fuel + 1, .boolean left, .boolean right => left == right
  | _fuel + 1, .unsigned left, .unsigned right => left == right
  | _fuel + 1, .signed left, .signed right => left == right
  | _fuel + 1, .uint256 left, .uint256 right => left == right
  | _fuel + 1, .enum leftType left, .enum rightType right => leftType == rightType && left == right
  | _fuel + 1, .address left, .address right => left == right
  | _fuel + 1, .bytes left, .bytes right => left == right
  | _fuel + 1, .reference leftType left, .reference rightType right => leftType == rightType && left == right
  | fuel + 1, .struct leftType left, .struct rightType right =>
      leftType == rightType && left.length == right.length &&
        left.all (fun item => field? right item.1 |>.any (valueEqFuel fuel item.2))
  | _ + 1, _, _ => false

private def valueEq (left right : Value) : Bool :=
  valueEqFuel 256 left right

private def asBool : Value → Except String Bool
  | .boolean value => .ok value
  | value => .error s!"expected bool, got {valueKind value}"

private def asUnsigned : Value → Except String Nat
  | .unsigned value => pure value
  | value => throw s!"expected ulong, got {valueKind value}"

private def asSigned : Value → Except String Int
  | .signed value | .enum _ value => pure value
  | value => throw s!"expected long, got {valueKind value}"

private def asUInt256 : Value → Except String Nat
  | .uint256 value => pure value
  | value => throw s!"expected UInt256, got {valueKind value}"

private def asAddress : Value → Except String String
  | .address value => pure value
  | value => throw s!"expected address, got {valueKind value}"

private def valueField (value : Value) (name : String) : Except String Value :=
  match value with
  | .struct typeName fields => field? fields name |>.toExcept s!"missing field {typeName}.{name}"
  | value => throw s!"field projection from {valueKind value}"

private def gasValue (value : Nat) (reservoir used spill refunded : Int) : Value :=
  .struct "global::Nethermind.Evm.GasPolicy.EthereumGasPolicy"
    [("Value", .unsigned value), ("StateReservoir", .signed reservoir),
     ("StateGasUsed", .signed used), ("StateGasSpill", .signed spill),
     ("StateGasSpillRefunded", .signed refunded)]

private def intrinsicValue (input : Intrinsic) : Value :=
  .struct "global::Nethermind.Evm.GasPolicy.IntrinsicGas<TGasPolicy>"
    [("Standard", gasValue input.standard.value input.standard.stateReservoir input.standard.stateGasUsed
      input.standard.stateGasSpill input.standard.stateGasSpillRefunded),
     ("FloorGas", gasValue input.floorGas.value input.floorGas.stateReservoir input.floorGas.stateGasUsed
      input.floorGas.stateGasSpill input.floorGas.stateGasSpillRefunded)]

private def defaultValue : String → Value
  | "" | "void" => .unit
  | "bool" => .boolean false
  | "int" => .enum "int" 0
  | "ulong" => .unsigned 0
  | "long" => .signed 0
  | "TGasPolicy" => gasValue 0 0 0 0 0
  | "global::Nethermind.Evm.GasPolicy.EthereumGasPolicy" => gasValue 0 0 0 0 0
  | "global::Nethermind.Int256.UInt256" => .uint256 0
  | "global::System.ReadOnlyMemory<byte>" => .bytes []
  | "global::Nethermind.Evm.EvmExceptionType" => .enum "global::Nethermind.Evm.EvmExceptionType" 0
  | "global::Nethermind.Evm.TransactionProcessing.TransactionResult.ErrorType" =>
      .enum "global::Nethermind.Evm.TransactionProcessing.TransactionResult.ErrorType" 0
  | "global::Nethermind.Evm.TransactionProcessing.TransactionResult" =>
      .struct "global::Nethermind.Evm.TransactionProcessing.TransactionResult"
        [("Error", .enum "global::Nethermind.Evm.TransactionProcessing.TransactionResult.ErrorType" 0),
         ("EvmExceptionType", .enum "global::Nethermind.Evm.EvmExceptionType" 0),
         ("ErrorDescription", .null "string")]
  | "global::Nethermind.Evm.TransactionSubstate" =>
      .struct "global::Nethermind.Evm.TransactionSubstate"
        [("_logs", .null "global::Nethermind.Core.Collections.JournalCollection<global::Nethermind.Core.LogEntry>"),
         ("_destroyList", .null "global::Nethermind.Core.Collections.JournalSet<global::Nethermind.Core.Address>"),
         ("Output", .bytes []), ("Refund", .signed 0), ("ShouldRevert", .boolean false),
         ("EvmExceptionType", .enum "global::Nethermind.Evm.EvmExceptionType" 0),
         ("Error", .null "string"),
         ("_logger", .null "global::Nethermind.Logging.ILogger")]
  | typeName => .null typeName

private def literalValue (typeName : String) : Literal → Value
  | .none => defaultValue typeName
  | .null => .null typeName
  | .boolean value => .boolean value
  | .unsigned value => if typeName == "ulong" then .unsigned value else .enum typeName value
  | .signed value => if typeName == "long" then .signed value else .enum typeName value
  | .text value => .reference typeName value

private def conversionValue (typeName : String) (value : Value) : Except String Value :=
  match typeName, value with
  | "int", .enum "byte" value => pure (.enum "int" value)
  | "ulong", .signed value | "ulong", .enum _ value =>
      pure (.unsigned (Eip803x.Generated.TransactionGasInitializationKernel.wrapUInt64 value))
  | "long", .enum _ value => pure (.signed value)
  | "global::Nethermind.Evm.EvmExceptionType", .enum _ value =>
      pure (.enum "global::Nethermind.Evm.EvmExceptionType" value)
  | _, value => pure value

theorem literalValue_string_exact (value : String) :
    literalValue "string" (.text value) = .reference "string" value := by
  rfl

theorem conversionValue_evmException_exact (value : Int) :
    conversionValue "global::Nethermind.Evm.EvmExceptionType" (.enum "int" value) =
      .ok (.enum "global::Nethermind.Evm.EvmExceptionType" value) := by
  rfl

theorem conversionValue_byte_to_int_exact (value : Int) :
    conversionValue "int" (.enum "byte" value) = .ok (.enum "int" value) := by
  rfl

theorem defaultValue_int_exact :
    defaultValue "int" = .enum "int" 0 := by
  rfl

theorem defaultValue_transactionResult_exact :
    defaultValue "global::Nethermind.Evm.TransactionProcessing.TransactionResult" =
      .struct "global::Nethermind.Evm.TransactionProcessing.TransactionResult"
        [("Error", .enum "global::Nethermind.Evm.TransactionProcessing.TransactionResult.ErrorType" 0),
         ("EvmExceptionType", .enum "global::Nethermind.Evm.EvmExceptionType" 0),
         ("ErrorDescription", .null "string")] := by
  rfl

private def localName (symbol : String) : String :=
  match (symbol.splitOn "::local:").get? 1 with
  | none => ""
  | some tail => (tail.splitOn "@").head?.getD ""

private def rootBindingValue? (input : Input) (name : String) : Option Value :=
  match name with
  | "restore" => some (.boolean input.restore)
  | "commit" => some (.boolean input.commit)
  | "deleteCallerAccount" => some (.boolean input.deleteCallerAccount)
  | "opcodeGasPrice" => some (.uint256 input.opcodeGasPrice)
  | "premiumPerGas" => some (.uint256 input.premiumPerGas)
  | "senderReservedGasPayment" => some (.uint256 input.senderReservedGasPayment)
  | "blobBaseFee" => some (.uint256 input.blobBaseFee)
  | _ => none

private def parameterValue? (input : Input) (parameter : Parameter) : Option Value :=
  match parameter.name with
  | "tx" => some (.reference parameter.typeName "tx")
  | "tracer" => some (.reference parameter.typeName "tracer")
  | "opts" => some (.reference parameter.typeName "opts")
  | "header" => some (.reference parameter.typeName "header")
  | "spec" => some (.reference parameter.typeName "spec")
  | "intrinsicGas" => some (intrinsicValue input.intrinsic)
  | _ => none

private def createFrame
    (machine : Machine) (function : Function) (thisOperand : Operand)
    (bindings : List (Parameter × Operand × ArgumentMode)) : Except String (Machine × FrameId) := do
  let frameId := machine.nextFrame
  let frame : RuntimeFrame :=
    { id := frameId, functionSymbol := function.signature.symbol, thisOperand
      cells := [], captures := [], carried := .unit }
  let machine := { machine with frames := frame :: machine.frames, nextFrame := frameId + 1 }
  let machine ← bindings.foldlM (fun machine item => do
    let (parameter, operand, argumentMode) := item
    match parameter.refKind with
    | .ref | .out | .inRef | .refReadOnly | .refReadOnlyParameter =>
        let (machine, location) ← match operand with
          | .location location => pure (machine, location)
          | .immediate value =>
              if parameter.refKind == .ref || parameter.refKind == .out then
                throw s!"argument location required: {parameter.name}"
              let provenancePrefix := if argumentMode == .readOnlyTemporary then "temporary:" else "readonly-expression:"
              let provenance := provenancePrefix ++ parameter.symbol
              let (machine, id) := allocateCell machine frameId parameter.symbol provenance value
              let location : Location := { root := id, fields := [], readOnly := true, provenance }
              pure (machine, location)
        let (machine, id) := allocateCell machine frameId parameter.symbol parameter.symbol (defaultValue parameter.typeName) (some location)
        bindCell machine frameId parameter.symbol id
    | .none =>
        let value ← readOperand machine operand
        let (machine, id) := allocateCell machine frameId parameter.symbol parameter.symbol value
        bindCell machine frameId parameter.symbol id) machine
  pure (machine, frameId)

theorem createFrame_writable_immediate_rejected (machine : Machine) (function : Function)
    (thisOperand : Operand) (parameter : Parameter) (value : Value) (mode : ArgumentMode)
    (tail : List (Parameter × Operand × ArgumentMode))
    (writable : parameter.refKind = .ref ∨ parameter.refKind = .out) :
    createFrame machine function thisOperand ((parameter, .immediate value, mode) :: tail) =
      .error s!"argument location required: {parameter.name}" := by
  rcases writable with writable | writable <;> simp [createFrame, writable] <;> rfl

theorem createFrame_reference_location_alias (machine : Machine) (function : Function)
    (thisOperand : Operand) (parameter : Parameter) (location : Location) (mode : ArgumentMode)
    (reference : parameter.refKind ≠ .none) :
    let frameId := machine.nextFrame
    let frame : RuntimeFrame :=
      { id := frameId, functionSymbol := function.signature.symbol, thisOperand
        cells := [], captures := [], carried := .unit }
    let entered := { machine with frames := frame :: machine.frames, nextFrame := frameId + 1 }
    let (allocated, cellId) := allocateCell entered frameId parameter.symbol parameter.symbol
      (defaultValue parameter.typeName) (some location)
    createFrame machine function thisOperand [(parameter, .location location, mode)] = (do
      let bound ← bindCell allocated frameId parameter.symbol cellId
      pure (bound, frameId)) := by
  cases kind : parameter.refKind <;> simp [createFrame, kind] at reference ⊢ <;> rfl

theorem createFrame_readonly_immediate_temporary (machine : Machine) (function : Function)
    (thisOperand : Operand) (parameter : Parameter) (value : Value) (mode : ArgumentMode)
    (readonly : parameter.refKind = .inRef ∨ parameter.refKind = .refReadOnly ∨
      parameter.refKind = .refReadOnlyParameter) :
    let frameId := machine.nextFrame
    let frame : RuntimeFrame :=
      { id := frameId, functionSymbol := function.signature.symbol, thisOperand
        cells := [], captures := [], carried := .unit }
    let entered := { machine with frames := frame :: machine.frames, nextFrame := frameId + 1 }
    let provenance := (if mode == .readOnlyTemporary then "temporary:" else "readonly-expression:") ++
      parameter.symbol
    let (temporary, temporaryId) := allocateCell entered frameId parameter.symbol provenance value
    let location : Location := { root := temporaryId, fields := [], readOnly := true, provenance }
    let (allocated, cellId) := allocateCell temporary frameId parameter.symbol parameter.symbol
      (defaultValue parameter.typeName) (some location)
    createFrame machine function thisOperand [(parameter, .immediate value, mode)] = (do
      let bound ← bindCell allocated frameId parameter.symbol cellId
      pure (bound, frameId)) := by
  rcases readonly with readonly | readonly | readonly <;> simp [createFrame, readonly] <;> rfl

theorem createFrame_value_copy (machine : Machine) (function : Function)
    (thisOperand : Operand) (parameter : Parameter) (operand : Operand) (mode : ArgumentMode)
    (byValue : parameter.refKind = .none) :
    let frameId := machine.nextFrame
    let frame : RuntimeFrame :=
      { id := frameId, functionSymbol := function.signature.symbol, thisOperand
        cells := [], captures := [], carried := .unit }
    let entered := { machine with frames := frame :: machine.frames, nextFrame := frameId + 1 }
    createFrame machine function thisOperand [(parameter, operand, mode)] = (do
      let value ← readOperand entered operand
      let (allocated, cellId) := allocateCell entered frameId parameter.symbol parameter.symbol value
      let bound ← bindCell allocated frameId parameter.symbol cellId
      pure (bound, frameId)) := by
  simp [createFrame, byValue]

def CallContextPreserved (before after : Machine) : Prop :=
  after.work = before.work ∧ after.operands = before.operands ∧
    after.statics = before.statics ∧ after.tape = before.tape ∧
    after.requestsRev = before.requestsRev ∧ after.returned = before.returned ∧
    after.csharpFuel = before.csharpFuel

theorem CallContextPreserved.trans (first middle last : Machine)
    (left : CallContextPreserved first middle) (right : CallContextPreserved middle last) :
    CallContextPreserved first last := by
  simp_all [CallContextPreserved]

def CallFrameEstablished (before after : Machine) (frameId : FrameId)
    (function : Function) (receiver : Operand) : Prop :=
  CallContextPreserved before after ∧ frameId = before.nextFrame ∧
    after.nextFrame = frameId + 1 ∧
    ∃ frame, findFrame? after frameId = some frame ∧ frame.id = frameId ∧
      frame.functionSymbol = function.signature.symbol ∧ frame.thisOperand = receiver ∧
      frame.carried = .unit ∧ frame.captures = []

private theorem foldlM_except_preserves {α β ε : Type} (predicate : β → Prop)
    (action : β → α → Except ε β) (items : List α) (initial result : β)
    (initialValid : predicate initial)
    (actionValid : ∀ before item after, predicate before →
      action before item = .ok after → predicate after)
    (succeeded : items.foldlM action initial = .ok result) : predicate result := by
  induction items generalizing initial with
  | nil =>
      have equal : initial = result := by simpa [List.foldlM_nil, pure, Except.pure] using succeeded
      exact equal ▸ initialValid
  | cons item items induction =>
      simp only [List.foldlM_cons] at succeeded
      cases applied : action initial item with
      | error reason => simp [applied, bind, Except.bind] at succeeded
      | ok next =>
          simp only [applied, bind, Except.bind] at succeeded
          exact induction next (actionValid initial item next initialValid applied) succeeded

private theorem findFrame_replaceFrame (machine : Machine) (frame replacement : RuntimeFrame)
    (frameId : FrameId) (present : findFrame? machine frameId = some frame)
    (replacementId : replacement.id = frameId) :
    findFrame? (replaceFrame machine replacement) frameId = some replacement := by
  have frameIdEq : frame.id = frameId := by
    simpa [findFrame?] using List.find?_some present
  unfold findFrame? replaceFrame
  rw [List.find?_map]
  simp only [Function.comp_def]
  have predicate : (fun candidate : RuntimeFrame =>
      (if candidate.id == replacement.id then replacement else candidate).id == frameId) =
      (fun candidate => candidate.id == frameId) := by
    funext candidate
    by_cases equal : candidate.id = frameId <;> simp [replacementId, equal]
  rw [predicate]
  change Option.map _ (findFrame? machine frameId) = _
  rw [present]
  simp [frameIdEq, replacementId]

private theorem callFrameEstablished_allocateCell (before current : Machine) (frameId : FrameId)
    (function : Function) (receiver : Operand)
    (established : CallFrameEstablished before current frameId function receiver)
    (owner : FrameId) (symbol provenance : String) (value : Value) (alias : Option Location) :
    CallFrameEstablished before (allocateCell current owner symbol provenance value alias).1
      frameId function receiver := by
  simpa [CallFrameEstablished, CallContextPreserved, allocateCell, findFrame?] using established

private theorem callFrameEstablished_bindCell (before current after : Machine) (frameId : FrameId)
    (function : Function) (receiver : Operand)
    (established : CallFrameEstablished before current frameId function receiver)
    (symbol : String) (cell : CellId)
    (succeeded : bindCell current frameId symbol cell = .ok after) :
    CallFrameEstablished before after frameId function receiver := by
  obtain ⟨context, idEq, nextEq, frame, present, frameIdEq, symbolEq, receiverEq, carriedEq, capturesEq⟩ := established
  simp only [bindCell, present, Option.toExcept, bind, Except.bind, pure, Except.pure] at succeeded
  cases succeeded
  let updated : RuntimeFrame := { frame with
    cells := (symbol, cell) :: frame.cells.filter (fun item => item.1 != symbol) }
  refine ⟨?_, idEq, nextEq, updated, ?_, frameIdEq, symbolEq, receiverEq, carriedEq, capturesEq⟩
  · simpa [CallContextPreserved, replaceFrame] using context
  · exact findFrame_replaceFrame current frame _ frameId present frameIdEq

theorem createFrame_success_establishes (before after : Machine) (function : Function)
    (receiver : Operand) (bindings : List (Parameter × Operand × ArgumentMode)) (frameId : FrameId)
    (succeeded : createFrame before function receiver bindings = .ok (after, frameId)) :
    CallFrameEstablished before after frameId function receiver := by
  unfold createFrame at succeeded
  dsimp only at succeeded
  generalize folded : bindings.foldlM (m := Except String) (s := Machine) _ _ = result at succeeded
  cases result with
  | error reason => simp [bind, Except.bind] at succeeded
  | ok bound =>
      simp only [bind, Except.bind, pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at succeeded
      obtain ⟨rfl, rfl⟩ := succeeded
      apply foldlM_except_preserves
        (CallFrameEstablished before · before.nextFrame function receiver) _ bindings _ bound
        ?_ ?_ folded
      · refine ⟨⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩, rfl, rfl, ?_⟩
        let initialFrame : RuntimeFrame :=
          { id := before.nextFrame, functionSymbol := function.signature.symbol,
            thisOperand := receiver, cells := [], captures := [], carried := .unit }
        exact ⟨initialFrame, by simp [initialFrame, findFrame?], rfl, rfl, rfl, rfl, rfl⟩
      · intro current item next established applied
        rcases item with ⟨parameter, operand, mode⟩
        cases kind : parameter.refKind <;>
          simp only [kind] at applied
        all_goals
          try {
            cases read : readOperand current operand with
            | error reason => simp [read, bind, Except.bind] at applied
            | ok value =>
                simp only [read, bind, Except.bind] at applied
                exact callFrameEstablished_bindCell before _ next before.nextFrame function receiver
                  (callFrameEstablished_allocateCell before current before.nextFrame function receiver
                    established before.nextFrame parameter.symbol parameter.symbol value none)
                  parameter.symbol _ applied
          }
        all_goals
          cases operand with
          | location location =>
              simp only [bind, Except.bind, pure, Except.pure] at applied
              exact callFrameEstablished_bindCell before _ next before.nextFrame function receiver
                (callFrameEstablished_allocateCell before current before.nextFrame function receiver
                  established before.nextFrame parameter.symbol parameter.symbol
                    (defaultValue parameter.typeName) (some location))
                parameter.symbol _ applied
          | immediate value =>
              simp [bind, Except.bind, pure, Except.pure] at applied
              all_goals
                exact callFrameEstablished_bindCell before _ next before.nextFrame function receiver
                  (callFrameEstablished_allocateCell before _ before.nextFrame function receiver
                    (callFrameEstablished_allocateCell before current before.nextFrame function receiver
                      established before.nextFrame parameter.symbol _ value none)
                    before.nextFrame parameter.symbol parameter.symbol
                      (defaultValue parameter.typeName) _)
                  parameter.symbol _ applied

def ParameterCellCount (binding : Parameter × Operand × ArgumentMode) : Nat :=
  match binding.1.refKind, binding.2.1 with
  | .none, _ | _, .location _ => 1
  | _, .immediate _ => 2

def ParameterCellsAllocated (before after : Machine) (frameId : FrameId) (count : Nat) : Prop :=
  ∃ added : List Cell,
    after.cells = added ++ before.cells ∧ added.length = count ∧
    after.nextCell = before.nextCell + count ∧
    added.map (·.id) = (List.range count).reverse.map (before.nextCell + ·) ∧
    ∀ cell ∈ added, cell.frame = frameId ∧
      before.nextCell ≤ cell.id ∧ cell.id < after.nextCell

private theorem parameterCellsAllocated_allocateCell
    (before current : Machine) (frameId count : Nat)
    (allocated : ParameterCellsAllocated before current frameId count)
    (symbol provenance : String) (value : Value) (alias : Option Location) :
    ParameterCellsAllocated before
      (allocateCell current frameId symbol provenance value alias).1 frameId (count + 1) := by
  obtain ⟨added, cells, length, next, ids, bounds⟩ := allocated
  refine ⟨{ id := current.nextCell, frame := frameId, symbol, provenance, value, alias } :: added,
    ?_, ?_, ?_, ?_, ?_⟩
  · simp [allocateCell, cells]
  · simp [length]
  · simp [allocateCell, next, Nat.add_assoc]
  · simp [List.range_succ, ids, next]
  · intro cell member
    rcases List.mem_cons.mp member with rfl | member
    · change frameId = frameId ∧ before.nextCell ≤ current.nextCell ∧
        current.nextCell < current.nextCell + 1
      exact ⟨rfl, next ▸ Nat.le_add_right _ _, Nat.lt_succ_self _⟩
    · obtain ⟨owner, lower, upper⟩ := bounds cell member
      refine ⟨owner, lower, ?_⟩
      change cell.id < current.nextCell + 1
      exact Nat.lt_trans upper (Nat.lt_succ_self _)

private theorem parameterCellsAllocated_bindCell
    (before current after : Machine) (frameId count : Nat)
    (allocated : ParameterCellsAllocated before current frameId count)
    (symbol : String) (cellId : CellId)
    (bound : bindCell current frameId symbol cellId = .ok after) :
    ParameterCellsAllocated before after frameId count := by
  unfold bindCell at bound
  cases found : findFrame? current frameId with
  | none => simp [found, Option.toExcept, bind, Except.bind] at bound
  | some frame =>
      simp only [found, Option.toExcept, bind, Except.bind, pure, Except.pure,
        Except.ok.injEq] at bound
      subst after
      simpa [ParameterCellsAllocated, replaceFrame] using allocated

private theorem foldlM_except_counts {α β ε : Type} (predicate : Nat → β → Prop)
    (weight : α → Nat) (action : β → α → Except ε β)
    (items : List α) (initial result : β) (count : Nat)
    (initialValid : predicate count initial)
    (actionValid : ∀ before item after count, predicate count before →
      action before item = .ok after → predicate (count + weight item) after)
    (succeeded : items.foldlM action initial = .ok result) :
    predicate (count + (items.map weight).sum) result := by
  induction items generalizing initial count with
  | nil =>
      have equal : initial = result := by simpa [List.foldlM_nil, pure, Except.pure] using succeeded
      simpa [equal] using initialValid
  | cons item items induction =>
      simp only [List.foldlM_cons] at succeeded
      cases applied : action initial item with
      | error reason => simp [applied, bind, Except.bind] at succeeded
      | ok next =>
          simp only [applied, bind, Except.bind] at succeeded
          simpa [Nat.add_assoc] using induction next (count + weight item)
            (actionValid initial item next count initialValid applied) succeeded

theorem createFrame_success_cellAllocation (before after : Machine) (function : Function)
    (receiver : Operand) (bindings : List (Parameter × Operand × ArgumentMode)) (frameId : FrameId)
    (succeeded : createFrame before function receiver bindings = .ok (after, frameId)) :
    ParameterCellsAllocated before after frameId (bindings.map ParameterCellCount).sum := by
  unfold createFrame at succeeded
  dsimp only at succeeded
  generalize folded : bindings.foldlM (m := Except String) (s := Machine) _ _ = result at succeeded
  cases result with
  | error reason => simp [bind, Except.bind] at succeeded
  | ok bound =>
      simp only [bind, Except.bind, pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at succeeded
      obtain ⟨rfl, rfl⟩ := succeeded
      suffices ParameterCellsAllocated before bound before.nextFrame
          (0 + (bindings.map ParameterCellCount).sum) by simpa using this
      apply foldlM_except_counts
        (fun count current => ParameterCellsAllocated before current before.nextFrame count)
        ParameterCellCount _ bindings _ bound 0 ?_ ?_ folded
      · exact ⟨[], rfl, rfl, by simp, by simp, by simp⟩
      · intro current item next count allocated applied
        rcases item with ⟨parameter, operand, mode⟩
        cases kind : parameter.refKind <;>
          simp only [kind] at applied
        all_goals
          try {
            cases read : readOperand current operand with
            | error reason => simp [read, bind, Except.bind] at applied
            | ok value =>
                simp only [read, bind, Except.bind] at applied
                simpa [ParameterCellCount, kind] using
                  parameterCellsAllocated_bindCell before _ next before.nextFrame (count + 1)
                    (parameterCellsAllocated_allocateCell before current before.nextFrame count
                      allocated parameter.symbol parameter.symbol value none)
                    parameter.symbol _ applied
          }
        all_goals
          cases operand with
          | location location =>
              simp only [bind, Except.bind, pure, Except.pure] at applied
              simpa [ParameterCellCount, kind] using
                parameterCellsAllocated_bindCell before _ next before.nextFrame (count + 1)
                  (parameterCellsAllocated_allocateCell before current before.nextFrame count
                    allocated parameter.symbol parameter.symbol
                    (defaultValue parameter.typeName) (some location))
                  parameter.symbol _ applied
          | immediate value =>
              simp [bind, Except.bind, pure, Except.pure] at applied
              all_goals
                simpa [ParameterCellCount, kind, Nat.add_assoc] using
                  parameterCellsAllocated_bindCell before _ next before.nextFrame (count + 1 + 1)
                    (parameterCellsAllocated_allocateCell before _ before.nextFrame (count + 1)
                      (parameterCellsAllocated_allocateCell before current before.nextFrame count
                        allocated parameter.symbol _ value none)
                      parameter.symbol parameter.symbol (defaultValue parameter.typeName) _)
                    parameter.symbol _ applied

theorem ParameterCellsAllocated.preserves_cell (before after : Machine) (frameId count : Nat)
    (allocated : ParameterCellsAllocated before after frameId count)
    (fresh : ∀ cell ∈ before.cells, cell.id < before.nextCell)
    (id : CellId) (cell : Cell) (found : findCell? before id = some cell) :
    findCell? after id = some cell := by
  obtain ⟨added, cells, _, _, _, bounds⟩ := allocated
  have identity : cell.id = id := by simpa using List.find?_some found
  have absent : added.find? (fun candidate => candidate.id == id) = none := by
    apply List.find?_eq_none.mpr
    intro candidate member
    have lower := (bounds candidate member).2.1
    have upper := fresh cell (List.mem_of_find?_eq_some found)
    simp only [beq_iff_eq]
    intro equal
    rw [equal, ← identity] at lower
    exact Nat.not_lt_of_ge lower upper
  simpa only [findCell?, cells, List.find?_append, absent, Option.or] using found

private theorem readLocationBase_preserves_success (before after : Machine)
    (lookups : ∀ id cell, findCell? before id = some cell → findCell? after id = some cell)
    (fuel more : Nat) (location : Location) (value : Value)
    (enough : fuel ≤ more) (read : readLocationBase fuel before location = .ok value) :
    readLocationBase more after location = .ok value := by
  induction fuel generalizing more location with
  | zero => simp [readLocationBase] at read
  | succ fuel induction =>
      cases more with
      | zero => omega
      | succ more =>
          cases found : findCell? before location.root with
          | none => simp [readLocationBase, found, Option.toExcept, bind, Except.bind] at read
          | some cell =>
              have preserved := lookups location.root cell found
              cases alias : cell.alias with
              | none =>
                  simpa [readLocationBase, found, preserved, Option.toExcept, bind, Except.bind,
                    pure, Except.pure, alias]
                    using read
              | some target =>
                  simp only [readLocationBase, found, Option.toExcept, bind, Except.bind,
                    pure, Except.pure, alias] at read
                  simp only [readLocationBase, preserved, Option.toExcept, bind, Except.bind,
                    pure, Except.pure, alias]
                  exact induction more _ (by omega) read

theorem ParameterCellsAllocated.preserves_read (before after : Machine) (frameId count : Nat)
    (allocated : ParameterCellsAllocated before after frameId count)
    (fresh : ∀ cell ∈ before.cells, cell.id < before.nextCell)
    (operand : Operand) (value : Value) (read : readOperand before operand = .ok value) :
    readOperand after operand = .ok value := by
  cases operand with
  | immediate immediate => exact read
  | location location =>
      have lookups := ParameterCellsAllocated.preserves_cell before after frameId count allocated fresh
      obtain ⟨added, cells, _, _, _⟩ := allocated
      exact readLocationBase_preserves_success before after lookups
        _ _ location value (by simp [cells]) read

theorem createFrame_success_preserves_read (before after : Machine) (function : Function)
    (receiver : Operand) (bindings : List (Parameter × Operand × ArgumentMode)) (frameId : FrameId)
    (succeeded : createFrame before function receiver bindings = .ok (after, frameId))
    (fresh : ∀ cell ∈ before.cells, cell.id < before.nextCell)
    (operand : Operand) (value : Value) (read : readOperand before operand = .ok value) :
    readOperand after operand = .ok value :=
  ParameterCellsAllocated.preserves_read before after frameId _
    (createFrame_success_cellAllocation before after function receiver bindings frameId succeeded)
    fresh operand value read

theorem createFrame_mixed_parameters_exact (before : Machine) (function : Function)
    (receiver : Operand) (reference readonly copied : Parameter) (location : Location)
    (temporaryValue : Value) (operand : Operand) (copiedValue : Value)
    (referenceMode readonlyMode copiedMode : ArgumentMode)
    (referenceKind : reference.refKind ≠ .none)
    (readonlyKind : readonly.refKind = .inRef ∨ readonly.refKind = .refReadOnly ∨
      readonly.refKind = .refReadOnlyParameter)
    (copiedKind : copied.refKind = .none)
    (symbols : reference.symbol ≠ readonly.symbol ∧ reference.symbol ≠ copied.symbol ∧
      readonly.symbol ≠ copied.symbol)
    (freshFrame : ∀ frame ∈ before.frames, frame.id ≠ before.nextFrame)
    (freshCells : ∀ cell ∈ before.cells, cell.id < before.nextCell)
    (read : readOperand before operand = .ok copiedValue) :
    let provenance := (if readonlyMode == .readOnlyTemporary then "temporary:" else "readonly-expression:") ++
      readonly.symbol
    let referenceCell : Cell :=
      { id := before.nextCell, frame := before.nextFrame, symbol := reference.symbol,
        provenance := reference.symbol, value := defaultValue reference.typeName, alias := some location }
    let temporaryCell : Cell :=
      { id := before.nextCell + 1, frame := before.nextFrame, symbol := readonly.symbol,
        provenance, value := temporaryValue, alias := none }
    let readonlyCell : Cell :=
      { id := before.nextCell + 2, frame := before.nextFrame, symbol := readonly.symbol,
        provenance := readonly.symbol, value := defaultValue readonly.typeName,
        alias := some { root := before.nextCell + 1, fields := [], readOnly := true, provenance } }
    let copiedCell : Cell :=
      { id := before.nextCell + 3, frame := before.nextFrame, symbol := copied.symbol,
        provenance := copied.symbol, value := copiedValue, alias := none }
    let frame : RuntimeFrame :=
      { id := before.nextFrame, functionSymbol := function.signature.symbol, thisOperand := receiver,
        cells := [(copied.symbol, copiedCell.id), (readonly.symbol, readonlyCell.id),
          (reference.symbol, referenceCell.id)], captures := [], carried := .unit }
    createFrame before function receiver
      [(reference, .location location, referenceMode),
       (readonly, .immediate temporaryValue, readonlyMode), (copied, operand, copiedMode)] =
      .ok ({ before with
          frames := frame :: before.frames,
          cells := [copiedCell, readonlyCell, temporaryCell, referenceCell] ++ before.cells,
          nextFrame := before.nextFrame + 1, nextCell := before.nextCell + 4 }, before.nextFrame) := by
  let provenance := (if readonlyMode == .readOnlyTemporary then "temporary:" else "readonly-expression:") ++
    readonly.symbol
  let added : List Cell :=
    [{ id := before.nextCell + 2, frame := before.nextFrame, symbol := readonly.symbol,
       provenance := readonly.symbol, value := defaultValue readonly.typeName,
       alias := some { root := before.nextCell + 1, fields := [], readOnly := true, provenance } },
     { id := before.nextCell + 1, frame := before.nextFrame, symbol := readonly.symbol,
       provenance, value := temporaryValue, alias := none },
     { id := before.nextCell, frame := before.nextFrame, symbol := reference.symbol,
       provenance := reference.symbol, value := defaultValue reference.typeName, alias := some location }]
  let prepared := { before with cells := added ++ before.cells, nextCell := before.nextCell + 3 }
  have allocated : ParameterCellsAllocated before prepared before.nextFrame 3 := by
    refine ⟨added, rfl, rfl, rfl, ?_, ?_⟩
    · simp [added, List.range_succ]
    ·
      intro cell member
      simp only [added, List.mem_cons, List.not_mem_nil, or_false] at member
      rcases member with rfl | rfl | rfl <;>
        simp [prepared, Nat.lt_add_one]
  have copiedRead : readOperand prepared operand = .ok copiedValue :=
    ParameterCellsAllocated.preserves_read before prepared before.nextFrame 3 allocated freshCells
      operand copiedValue read
  have readAfter : ∀ current : Machine, current.cells = added ++ before.cells →
      readOperand current operand = .ok copiedValue := by
    intro current cells
    rw [readOperand_cells_eq current prepared cells]
    exact copiedRead
  obtain ⟨symbols12, symbols13, symbols23⟩ := symbols
  rcases readonlyKind with readonlyKind | readonlyKind | readonlyKind <;>
    cases kind : reference.refKind <;>
    simp only [kind, ne_eq, not_true_eq_false] at referenceKind
  all_goals
    simp [createFrame, kind, readonlyKind, copiedKind, allocateCell, bindCell, findFrame?, replaceFrame,
      Option.toExcept, bind, Except.bind, pure, Except.pure,
      symbols12, symbols13, symbols23, Nat.add_assoc,
      show ∀ current : Machine, current.cells = added ++ before.cells →
        readOperand current operand = .ok copiedValue from readAfter,
      added, provenance]
  all_goals
    conv => rhs; rw [← List.map_id before.frames]
    apply List.map_congr_left
    intro old member
    simp [Function.comp_def, freshFrame old member]

theorem createFrame_mixed_parameter_lookups (before after : Machine) (function : Function)
    (receiver : Operand) (reference readonly copied : Parameter) (location : Location)
    (temporaryValue : Value) (operand : Operand) (copiedValue : Value)
    (referenceMode readonlyMode copiedMode : ArgumentMode)
    (referenceKind : reference.refKind ≠ .none)
    (readonlyKind : readonly.refKind = .inRef ∨ readonly.refKind = .refReadOnly ∨
      readonly.refKind = .refReadOnlyParameter)
    (copiedKind : copied.refKind = .none)
    (symbols : reference.symbol ≠ readonly.symbol ∧ reference.symbol ≠ copied.symbol ∧
      readonly.symbol ≠ copied.symbol)
    (freshFrame : ∀ frame ∈ before.frames, frame.id ≠ before.nextFrame)
    (freshCells : ∀ cell ∈ before.cells, cell.id < before.nextCell)
    (read : readOperand before operand = .ok copiedValue)
    (succeeded : createFrame before function receiver
      [(reference, .location location, referenceMode),
       (readonly, .immediate temporaryValue, readonlyMode), (copied, operand, copiedMode)] =
      .ok (after, before.nextFrame)) :
    ∃ frame, findFrame? after before.nextFrame = some frame ∧
      frame.cells.find? (fun item => item.1 == reference.symbol) =
        some (reference.symbol, before.nextCell) ∧
      frame.cells.find? (fun item => item.1 == readonly.symbol) =
        some (readonly.symbol, before.nextCell + 2) ∧
      frame.cells.find? (fun item => item.1 == copied.symbol) =
        some (copied.symbol, before.nextCell + 3) ∧
      (findCell? after before.nextCell).map (·.alias) = some (some location) ∧
      (findCell? after (before.nextCell + 1)).map (·.value) = some temporaryValue ∧
      (findCell? after (before.nextCell + 3)).map (·.value) = some copiedValue := by
  have exactState := createFrame_mixed_parameters_exact before function receiver reference readonly copied
    location temporaryValue operand copiedValue referenceMode readonlyMode copiedMode referenceKind readonlyKind
    copiedKind symbols freshFrame freshCells read
  rw [succeeded] at exactState
  simp only [Except.ok.injEq, Prod.mk.injEq, and_true] at exactState
  rw [exactState]
  obtain ⟨symbols12, symbols13, symbols23⟩ := symbols
  simp [findFrame?, findCell?, Ne.symm symbols12, Ne.symm symbols13, Ne.symm symbols23]

def parameterAllocationOrder (first : CellId) : List String → List (String × CellId)
  | [] => []
  | symbol :: symbols => (symbol, first) :: parameterAllocationOrder (first + 1) symbols

private theorem parameterAllocationOrder_symbols (first : CellId) (symbols : List String) :
    (parameterAllocationOrder first symbols).map (·.1) = symbols := by
  induction symbols generalizing first with
  | nil => rfl
  | cons symbol symbols induction => simp [parameterAllocationOrder, induction]

private theorem parameterAllocationOrder_reverse_find (first : CellId) (symbols : List String)
    (index : Nat) (symbol : String) (unique : symbols.Nodup)
    (selected : symbols[index]? = some symbol) :
    (parameterAllocationOrder first symbols).reverse.find? (fun binding => binding.1 == symbol) =
      some (symbol, first + index) := by
  induction symbols generalizing first index with
  | nil => simp at selected
  | cons head symbols induction =>
      obtain ⟨absent, unique⟩ := List.nodup_cons.mp unique
      cases index with
      | zero =>
          have equal : head = symbol := by simpa using selected
          subst head
          have missing : (parameterAllocationOrder (first + 1) symbols).reverse.find?
              (fun binding => binding.1 == symbol) = none := by
            apply List.find?_eq_none.mpr
            intro binding member
            have memberSymbol : binding.1 ∈ symbols := by
              rw [← parameterAllocationOrder_symbols (first + 1) symbols]
              exact List.mem_map.mpr ⟨binding, List.mem_reverse.mp member, rfl⟩
            simpa using fun equal : binding.1 = symbol => absent (equal ▸ memberSymbol)
          simp [parameterAllocationOrder, List.find?_append, missing]
      | succ index =>
          have remaining : symbols[index]? = some symbol := by simpa using selected
          have found := induction (first + 1) index unique remaining
          simpa [parameterAllocationOrder, List.find?_append, Nat.add_assoc, Nat.add_comm,
            Nat.add_left_comm] using found

private theorem find_binding_filter (bindings : List (String × CellId)) (symbol wanted : String)
    (different : symbol ≠ wanted) :
    (bindings.filter (fun binding => binding.1 != symbol)).find? (fun binding => binding.1 == wanted) =
      bindings.find? (fun binding => binding.1 == wanted) := by
  rw [List.find?_filter]
  congr 1
  funext binding
  by_cases same : binding.1 = wanted <;> simp [same, Ne.symm different]

private theorem find_binding_replaced (bindings : List (String × CellId)) (symbol : String)
    (cellId : CellId) (wanted : String) :
    ((symbol, cellId) :: bindings.filter (fun binding => binding.1 != symbol)).find?
        (fun binding => binding.1 == wanted) =
      ((symbol, cellId) :: bindings).find? (fun binding => binding.1 == wanted) := by
  by_cases equal : symbol = wanted
  · simp [equal]
  · simp [equal, find_binding_filter bindings symbol wanted equal]

private def bindValueParameter (frameId : FrameId) (machine : Machine)
    (binding : Parameter × Operand × ArgumentMode) : Except String Machine := do
  let value ← readOperand machine binding.2.1
  let (machine, cellId) := allocateCell machine frameId binding.1.symbol binding.1.symbol value
  bindCell machine frameId binding.1.symbol cellId

private theorem valueParameterFold_layout (before after : Machine) (frameId : FrameId)
    (bindings : List (Parameter × Operand × ArgumentMode)) (frame : RuntimeFrame)
    (present : findFrame? before frameId = some frame)
    (succeeded : bindings.foldlM (bindValueParameter frameId) before = .ok after) :
    let layout := (parameterAllocationOrder before.nextCell (bindings.map (fun binding => binding.1.symbol))).reverse
    ∃ added finalFrame,
      after.cells = added ++ before.cells ∧
      added.map (fun cell => (cell.symbol, cell.id)) = layout ∧
      (∀ cell ∈ added, cell.alias = none) ∧
      findFrame? after frameId = some finalFrame ∧
      ∀ symbol, finalFrame.cells.find? (fun binding => binding.1 == symbol) =
        (layout ++ frame.cells).find? (fun binding => binding.1 == symbol) := by
  induction bindings generalizing before frame with
  | nil =>
      have equal : before = after := by simpa [List.foldlM_nil, pure, Except.pure] using succeeded
      subst before
      exact ⟨[], frame, rfl, rfl, by simp, present, by simp [parameterAllocationOrder]⟩
  | cons binding bindings induction =>
      have identity : frame.id = frameId := by simpa [findFrame?] using List.find?_some present
      rcases binding with ⟨parameter, operand, mode⟩
      simp only [List.foldlM_cons, bindValueParameter] at succeeded
      cases read : readOperand before operand with
      | error reason => simp [read, bind, Except.bind] at succeeded
      | ok value =>
          let cell : Cell :=
            { id := before.nextCell, frame := frameId, symbol := parameter.symbol,
              provenance := parameter.symbol, value, alias := none }
          let allocated := { before with cells := cell :: before.cells, nextCell := before.nextCell + 1 }
          let replacement := { frame with cells :=
            (parameter.symbol, before.nextCell) :: frame.cells.filter (fun binding => binding.1 != parameter.symbol) }
          let next := replaceFrame allocated replacement
          have nextPresent : findFrame? next frameId = some replacement := by
            exact findFrame_replaceFrame allocated frame replacement frameId present identity
          have frameFound : before.frames.find? (fun candidate => candidate.id == frameId) = some frame := present
          have remaining : bindings.foldlM (bindValueParameter frameId) next = .ok after := by
            simpa [read, bindCell, allocateCell, findFrame?, frameFound, Option.toExcept,
              bind, Except.bind, pure, Except.pure, next, allocated, replacement, cell] using succeeded
          obtain ⟨added, finalFrame, cells, layout, aliases, finalPresent, lookups⟩ :=
            induction next replacement nextPresent remaining
          refine ⟨added ++ [cell], finalFrame, ?_, ?_, ?_, finalPresent, ?_⟩
          · simp only [next, replaceFrame, allocated] at cells
            simpa only [List.append_assoc, List.singleton_append] using cells
          · simp [parameterAllocationOrder, next, replaceFrame, allocated, cell, layout]
          · intro candidate member
            rcases List.mem_append.mp member with member | member
            · exact aliases candidate member
            · have equal : candidate = cell := by simpa using member
              simp [equal, cell]
          · intro symbol
            have lookup := lookups symbol
            simpa [parameterAllocationOrder, next, replaceFrame, allocated, replacement,
              List.append_assoc, List.find?_append, find_binding_replaced] using lookup

private theorem foldlM_except_congr_on {α β ε : Type}
    (left right : β → α → Except ε β) (items : List α) (initial : β)
    (agree : ∀ item ∈ items, ∀ state, left state item = right state item) :
    items.foldlM left initial = items.foldlM right initial := by
  induction items generalizing initial with
  | nil => rfl
  | cons item items induction =>
      have first := agree item (by simp) initial
      have rest : ∀ item ∈ items, ∀ state, left state item = right state item := by
        intro candidate member state
        exact agree candidate (by simp [member]) state
      simp only [List.foldlM_cons, first]
      cases applied : right initial item <;> simp [bind, Except.bind, induction _ rest]

theorem createFrame_success_byValue_layout (before after : Machine) (function : Function)
    (receiver : Operand) (bindings : List (Parameter × Operand × ArgumentMode)) (frameId : FrameId)
    (byValue : ∀ binding ∈ bindings, binding.1.refKind = .none)
    (succeeded : createFrame before function receiver bindings = .ok (after, frameId)) :
    let layout := (parameterAllocationOrder before.nextCell (bindings.map (fun binding => binding.1.symbol))).reverse
    ParameterCellsAllocated before after frameId bindings.length ∧
      ∃ frame added,
        findFrame? after frameId = some frame ∧ after.cells = added ++ before.cells ∧
        added.map (fun cell => (cell.symbol, cell.id)) = layout ∧
        (∀ cell ∈ added, cell.alias = none) ∧
        ∀ symbol, frame.cells.find? (fun binding => binding.1 == symbol) =
          layout.find? (fun binding => binding.1 == symbol) := by
  have allocated := createFrame_success_cellAllocation before after function receiver bindings frameId succeeded
  have counts : bindings.map ParameterCellCount = bindings.map (fun _ => 1) := by
    apply List.map_congr_left
    intro binding member
    simp [ParameterCellCount, byValue binding member]
  have exactCount : ParameterCellsAllocated before after frameId bindings.length := by
    simpa [counts, List.map_const', List.sum_replicate_nat] using allocated
  refine ⟨exactCount, ?_⟩
  unfold createFrame at succeeded
  dsimp only at succeeded
  generalize folded : bindings.foldlM (m := Except String) (s := Machine) _ _ = result at succeeded
  cases result with
  | error reason => simp [bind, Except.bind] at succeeded
  | ok bound =>
      simp only [bind, Except.bind, pure, Except.pure, Except.ok.injEq, Prod.mk.injEq] at succeeded
      obtain ⟨rfl, rfl⟩ := succeeded
      let frame : RuntimeFrame :=
        { id := before.nextFrame, functionSymbol := function.signature.symbol, thisOperand := receiver,
          cells := [], captures := [], carried := .unit }
      let entered := { before with frames := frame :: before.frames, nextFrame := before.nextFrame + 1 }
      have specialized : bindings.foldlM (bindValueParameter before.nextFrame) entered = .ok bound := by
        apply Eq.trans ?_ folded
        apply foldlM_except_congr_on
        intro binding member state
        rcases binding with ⟨parameter, operand, mode⟩
        have kind : parameter.refKind = .none := byValue (parameter, operand, mode) member
        simp [bindValueParameter, kind]
      obtain ⟨added, finalFrame, cells, layout, aliases, present, lookups⟩ :=
        valueParameterFold_layout entered bound before.nextFrame bindings frame
          (by simp [entered, frame, findFrame?]) specialized
      exact ⟨finalFrame, added, present, cells, layout, aliases, by simpa [frame] using lookups⟩

private def initializeRoot (program : Program) (input : Input) (tape : List Exchange) (fuel : Nat) : Except String Machine := do
  let function ← findFunction? program program.entry |>.toExcept "missing entry function"
  let initial : Machine :=
    { work := [], operands := [], frames := [], cells := [], statics := [], tape
      requestsRev := [], returned := none, nextFrame := 0, nextCell := 0, csharpFuel := fuel }
  let rootId := initial.nextFrame
  let root : RuntimeFrame :=
    { id := rootId, functionSymbol := function.signature.symbol
      thisOperand := .immediate (.reference function.signature.declaringType "processor")
      cells := [], captures := [], carried := .unit }
  let machine := { initial with frames := [root], nextFrame := rootId + 1 }
  let machine ← function.signature.parameters.foldlM (fun machine parameter => do
    let value ← parameterValue? input parameter |>.toExcept s!"unsupported entry parameter {parameter.name}"
    let (machine, id) := allocateCell machine rootId parameter.symbol parameter.symbol value
    bindCell machine rootId parameter.symbol id) machine
  let machine ← function.bindings.foldlM (fun machine binding =>
    match rootBindingValue? input (localName binding.1) with
    | none => pure machine
    | some value => do
        let (machine, id) := allocateCell machine rootId binding.1 binding.1 value
        bindCell machine rootId binding.1 id) machine
  pure { machine with work := [.enterBlock rootId function.signature.symbol function.entryBlock] }

private def int64Valid (value : Int) : Bool := int64Min <= value && value <= int64Max
private def gasValid (gas : Gas) : Bool :=
  gas.value <= uint64Max && int64Valid gas.stateReservoir && int64Valid gas.stateGasUsed &&
    int64Valid gas.stateGasSpill && int64Valid gas.stateGasSpillRefunded

def commonDomain (input : Input) : Bool :=
  input.tx.recipient.isSome && !input.tx.hasAuthorizationList && input.spec.eip8037Enabled && !input.spec.eip7708Enabled &&
  !input.tracer.state && !input.tracer.actions && !input.tracer.code && !input.tracer.logs &&
  !input.restore && input.commit && !input.warmup && !input.isCodeOverridable && !input.forceSimpleTransferDisabled &&
  input.tx.gasLimit <= 2 ^ 63 - 1 && input.tx.value < uint256Modulus && input.opcodeGasPrice < uint256Modulus &&
  input.premiumPerGas < uint256Modulus && input.senderReservedGasPayment < uint256Modulus && input.blobBaseFee < uint256Modulus &&
  input.executionGasLimitCap == 16777216 && input.newAccountStateCost == 183600 &&
  gasValid input.intrinsic.standard && gasValid input.intrinsic.floorGas && input.intrinsic.standard.stateReservoir >= 0 &&
  input.intrinsic.standard.value <= input.executionGasLimitCap &&
  input.tx.gasLimit >= input.intrinsic.standard.value + Int.toNat input.intrinsic.standard.stateReservoir

theorem commonDomain_initialization_refinementValid (input : Input)
    (h : commonDomain input = true) :
    Eip803x.Refinement.TransactionGasInitialization.RefinementValid
      input.tx.gasLimit input.intrinsic.standard.value
      input.intrinsic.standard.stateReservoir input.executionGasLimitCap := by
  simp [commonDomain, gasValid, int64Valid, uint64Max, int64Min, int64Max] at h
  unfold Eip803x.Refinement.TransactionGasInitialization.RefinementValid
    Eip803x.Refinement.TransactionGasInitialization.FitsUInt64
    Eip803x.Refinement.TransactionGasInitialization.FitsInt64
    Eip803x.Generated.TransactionGasInitializationKernel.uint64Max
    Eip803x.Generated.TransactionGasInitializationKernel.uint64Modulus
    Eip803x.Generated.TransactionGasInitializationKernel.int64Min
    Eip803x.Generated.TransactionGasInitializationKernel.int64Max
    Eip803x.Generated.TransactionGasInitializationKernel.int64SignBit
  refine ⟨by omega, by omega, by omega, by omega, by omega, by omega, by omega, by omega, ?_⟩
  constructor
  · omega
  · have availableLe :
        input.tx.gasLimit -
            (input.intrinsic.standard.value + Int.toNat input.intrinsic.standard.stateReservoir) ≤
          input.tx.gasLimit := Nat.sub_le _ _
    have reservoirLe :
        input.tx.gasLimit -
              (input.intrinsic.standard.value + Int.toNat input.intrinsic.standard.stateReservoir) -
            min (input.executionGasLimitCap - input.intrinsic.standard.value)
              (input.tx.gasLimit -
                (input.intrinsic.standard.value + Int.toNat input.intrinsic.standard.stateReservoir)) ≤
          input.tx.gasLimit :=
      Nat.le_trans (Nat.sub_le _ _) availableLe
    omega

