private theorem findCell_replaceCell_other (before : Machine) (replacement : Cell)
    (cell : Cell) (found : findCell? before cell.id = some cell)
    (different : cell.id ≠ replacement.id) :
    findCell? (replaceCell before replacement) cell.id = some cell := by
  unfold findCell? at found ⊢
  unfold replaceCell
  rw [List.find?_map]
  have predicates : (fun candidate : Cell =>
      (if candidate.id == replacement.id then replacement else candidate).id == cell.id) =
      (fun candidate : Cell => candidate.id == cell.id) := by
    funext candidate
    by_cases same : candidate.id = replacement.id
    · simp [same]
    · simp [same]
  simp only [Function.comp_def]
  rw [predicates, found]
  simp [different]

private theorem findCell_replaceCell_same (before : Machine) (old replacement : Cell)
    (found : findCell? before old.id = some old) (identity : replacement.id = old.id) :
    findCell? (replaceCell before replacement) old.id = some replacement := by
  unfold findCell? at found ⊢
  unfold replaceCell
  rw [List.find?_map]
  have predicates : (fun candidate : Cell =>
      (if candidate.id == replacement.id then replacement else candidate).id == old.id) =
      (fun candidate : Cell => candidate.id == old.id) := by
    funext candidate
    by_cases same : candidate.id = old.id <;> simp [identity, same]
  simp only [Function.comp_def]
  rw [predicates, found]
  simp [identity]

