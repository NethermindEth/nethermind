def PostRefundCallArgument.Ready (argument : PostRefundCallArgument)
    (before : Machine) (frame : RuntimeFrame) (cells : String → CellId)
    (values : String → Value) : Prop :=
  frame.cells.find? (fun item => item.1 == argument.source.symbol) =
    some (argument.source.symbol, cells argument.source.symbol) ∧
  (argument.readOnly = false → readLocation before (argument.location cells) =
    .ok (values argument.source.symbol))

private theorem postRefund_argument_exact
    (program : Program) (input : Input) (argument : PostRefundCallArgument)
    (before : Machine) (frame : RuntimeFrame) (cells : String → CellId)
    (values : String → Value) (tail : List Task) (operandTail : List Operand) (fuel : Nat)
    (present : findFrame? before frame.id = some frame)
    (ready : argument.Ready before frame cells values) :
    steps program input 4 {before with
      work := .eval frame.id (postRefundArgumentNode argument) :: tail,
      operands := operandTail, csharpFuel := fuel+2} =
      .next {before with
        work := tail,
        operands := argument.operand cells values :: operandTail, csharpFuel := fuel} := by
  let wrapper := postRefundArgumentNode argument
  let source := postRefundArgumentNodeSource argument
  let pending := Task.apply frame.id wrapper 1 :: tail
  let popped : Machine := {before with work := pending, operands := operandTail, csharpFuel := fuel}
  have wrapperValid : nodeTagsValid wrapper = true := by
    cases argument with
    | mk source isLocal readOnly name => cases isLocal <;> cases readOnly <;> rfl
  have sourceValid : nodeTagsValid source = true := by
    cases argument with
    | mk source isLocal readOnly name => cases isLocal <;> cases readOnly <;> rfl
  have sourceNotPattern : source.kind ≠ .isPattern := by
    cases h : argument.isLocal <;> simp [source, postRefundArgumentNodeSource, h, Node.kind]
  have first := eval_nonpattern_step program input {before with operands := operandTail}
    frame.id wrapper tail (fuel+1) wrapperValid (by change OperationKind.argument ≠ .isPattern; decide)
  have second := eval_nonpattern_step program input {before with operands := operandTail}
    frame.id source pending fuel sourceValid sourceNotPattern
  have poppedPresent : findFrame? popped frame.id = some frame := present
  have poppedRead : argument.readOnly = false →
      readLocation popped (argument.location cells) = .ok (values argument.source.symbol) := by
    intro isValue
    exact (readOperand_cells_eq popped before rfl (.location (argument.location cells))).trans
      (ready.2 isValue)
  have applied : applyNode program input popped frame.id source [] =
      .next {popped with operands := argument.operand cells values :: operandTail} := by
    have binding := ready.1
    cases hlocal : argument.isLocal <;> cases hreadonly : argument.readOnly
    all_goals
      simp only [source, postRefundArgumentNodeSource, hlocal, hreadonly,
        Bool.false_eq_true, if_false, if_true, Node.kind, Node.symbol, Node.mode,
        applyNode, poppedPresent, binding, BEq.rfl]
    all_goals
      first
      | simp only [PostRefundCallArgument.operand, PostRefundCallArgument.location,
          hreadonly, if_true, popped]
        rfl
      | have readable := poppedRead hreadonly
        simp only [PostRefundCallArgument.location, hreadonly] at readable
        change (match readLocation popped
          {root := cells argument.source.symbol, fields := [], readOnly := false,
            provenance := argument.source.symbol} with
          | .ok value => StepResult.next {popped with operands := .immediate value :: operandTail}
          | .error reason => reject reason popped) = _
        rw [readable]
        simp only [PostRefundCallArgument.operand, hreadonly, Bool.false_eq_true, if_false]
  have third : step program input {before with
      work := .apply frame.id source 0 :: pending, operands := operandTail, csharpFuel := fuel} =
      .next {popped with operands := argument.operand cells values :: operandTail} := by
    exact applied
  have fourth : step program input
      {popped with operands := argument.operand cells values :: operandTail} =
      .next {before with
        work := tail,
        operands := argument.operand cells values :: operandTail, csharpFuel := fuel} := by
    simp [popped, pending, wrapper, postRefundArgumentNode, step, popOperands, applyNode, Node.kind]
  have firstExact : step program input {before with
      work := .eval frame.id wrapper :: tail, operands := operandTail, csharpFuel := fuel+2} =
      .next {before with
        work := .eval frame.id source :: pending,
        operands := operandTail, csharpFuel := fuel+1} := by
    simpa only [wrapper, postRefundArgumentNode, Node.children, source, pending,
      List.map_cons, List.map_nil, List.length_cons, List.length_nil,
      List.cons_append, List.nil_append, Nat.add_assoc] using first
  have secondExact : step program input {before with
      work := .eval frame.id source :: pending,
      operands := operandTail, csharpFuel := fuel+1} =
      .next {before with
        work := .apply frame.id source 0 :: pending,
        operands := operandTail, csharpFuel := fuel} := by
    simpa only [source, postRefundArgumentNodeSource, Node.children, List.map_nil,
      List.length_nil, List.nil_append, List.cons_append] using second
  change steps program input 4 {before with
    work := .eval frame.id wrapper :: tail, operands := operandTail, csharpFuel := fuel+2} = _
  simp only [steps, firstExact, secondExact, third, fourth]

private theorem postRefund_arguments_exact
    (program : Program) (input : Input) (arguments : List PostRefundCallArgument)
    (before : Machine) (frame : RuntimeFrame) (cells : String → CellId)
    (values : String → Value) (tail : List Task) (operandTail : List Operand) (fuel : Nat)
    (present : findFrame? before frame.id = some frame)
    (ready : ∀ argument ∈ arguments, argument.Ready before frame cells values) :
    steps program input (4*arguments.length) {before with
      work := arguments.map (fun argument => Task.eval frame.id (postRefundArgumentNode argument)) ++ tail,
      operands := operandTail, csharpFuel := fuel+2*arguments.length} =
      .next {before with
        work := tail,
        operands := (arguments.map (fun argument => argument.operand cells values)).reverse ++ operandTail,
        csharpFuel := fuel} := by
  induction arguments generalizing operandTail with
  | nil => rfl
  | cons argument arguments induction =>
      have first := postRefund_argument_exact program input argument before frame cells values
        (arguments.map (fun argument => Task.eval frame.id (postRefundArgumentNode argument)) ++ tail)
        operandTail (fuel+2*arguments.length) present (ready argument (by simp))
      have rest := induction (argument.operand cells values :: operandTail)
        (fun next member => ready next (by simp [member]))
      rw [show 4*(argument :: arguments).length = 4+4*arguments.length by simp; omega,
        steps_add]
      have normalized : fuel+2*(argument :: arguments).length = (fuel+2*arguments.length)+2 := by
        simp
        omega
      simp only [List.map_cons, List.cons_append, normalized]
      rw [first]
      simpa only [List.map_cons, List.reverse_cons, List.append_assoc, List.singleton_append] using rest

private def postRefundCallContinuation (reportAccess : Bool) (frameId : FrameId)
    (tail : List Task) : List Task :=
  [.apply frameId (postRefundStatementNode (generatedExecuteSimpleTransferPostRefundCallNode reportAccess)) 1,
   .setLast frameId] ++
  (if reportAccess then [] else [.eval frameId postRefundFinalizeNode, .setLast frameId]) ++
  [.finishBlock frameId Generated.function24.signature.symbol
    (generatedExecuteSimpleTransferPostRefundCallBlock reportAccess)] ++ tail

/-- The pending invocation is intentionally not applied; no callee or host effect is assumed. -/
def generatedExecuteSimpleTransferPostRefundCallFrontier
    (reportAccess : Bool) (before : Machine) (frame : RuntimeFrame)
    (receiver : Value) (cells : String → CellId) (values : String → Value)
    (tail : List Task) (fuel : Nat) : Machine :=
  let arguments := generatedExecuteSimpleTransferPostRefundCallArguments reportAccess
  { replaceFrame before frame with
    work := .apply frame.id (generatedExecuteSimpleTransferPostRefundCallNode reportAccess)
      (arguments.length+1) :: postRefundCallContinuation reportAccess frame.id tail,
    operands := (arguments.map (fun argument => argument.operand cells values)).reverse ++
      .immediate receiver :: before.operands,
    csharpFuel := fuel }

private theorem postRefund_receiver_exact
    (program : Program) (input : Input) (before : Machine) (frame : RuntimeFrame)
    (receiver : Value) (tail : List Task) (operandTail : List Operand) (fuel : Nat)
    (present : findFrame? before frame.id = some frame)
    (readable : readOperand before frame.thisOperand = .ok receiver) :
    steps program input 2 {before with
      work := .eval frame.id postRefundReceiverNode :: tail,
      operands := operandTail, csharpFuel := fuel+1} =
      .next {before with
        work := tail, operands := .immediate receiver :: operandTail,
        csharpFuel := fuel} := by
  let prepared : Machine := {before with work := tail, operands := operandTail, csharpFuel := fuel}
  have present' : findFrame? prepared frame.id = some frame := present
  have readable' : readOperand prepared frame.thisOperand = .ok receiver :=
    (readOperand_cells_eq prepared before rfl frame.thisOperand).trans readable
  have evaluated := eval_nonpattern_step program input {before with operands := operandTail}
    frame.id postRefundReceiverNode tail fuel rfl (by decide)
  have applied : step program input {before with
      work := .apply frame.id postRefundReceiverNode 0 :: tail,
      operands := operandTail, csharpFuel := fuel} =
      .next {before with
        work := tail, operands := .immediate receiver :: operandTail,
        csharpFuel := fuel} := by
    change applyNode program input prepared frame.id postRefundReceiverNode [] = _
    simp only [applyNode, postRefundReceiverNode, Node.kind, Node.operator, Node.mode,
      BEq.rfl, present', readable']
    rfl
  have evaluated' : step program input {before with
      work := .eval frame.id postRefundReceiverNode :: tail,
      operands := operandTail, csharpFuel := fuel+1} =
      .next {before with
        work := .apply frame.id postRefundReceiverNode 0 :: tail,
        operands := operandTail, csharpFuel := fuel} := by
    simpa only [postRefundReceiverNode, Node.children, List.map_nil, List.length_nil,
      List.nil_append, List.cons_append] using evaluated
  simp only [steps, evaluated', applied]

