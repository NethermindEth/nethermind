    simp only [Control.encodeFinishResult, Control.encodeCursor]
    unfold controlFinish
    rw [cursor]
  · rw [extracted]
    simpa [Control.encodeFinishResult, Control.encodeCursor] using
      finishBlock_jump_step program input machine frame block tail present branches jumps

theorem generatedFinishBlock_return_resume_step (program : Program) (input : Input)
    (machine : Machine) (frame : RuntimeFrame) (block : Block)
    (skipped tail : List Task) (caller : FrameId) (kind : ResumeKind)
