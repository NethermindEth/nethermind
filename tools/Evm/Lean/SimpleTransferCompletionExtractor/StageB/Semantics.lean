-- Entering a block normalizes every duplicate ID to the first selected frame.
example (program : Program) (input : Input) (machine : Machine)
    (frame : RuntimeFrame) (function : Function) (block : Block) (ordinal : Int)
    (tail : List Task) (fuel : Nat) (other : Value)
    (functionPresent : findFunction? program frame.functionSymbol = some function)
    (blockPresent : findBlock? function ordinal = some block)
