private def run (program : Program) (input : Input) (tape : List Exchange) (csharpFuel microFuel : Nat) : Execution :=
  if !programValid program then {
    outcome := .rejected "program admission failed" [] tape
    remainingCSharpFuel := csharpFuel, rejection := some .unexpected }
  else if csharpFuel == 0 || csharpFuel > program.fuelBound then
    {
      outcome := .rejected "C# fuel outside admitted bound" [] tape
      remainingCSharpFuel := csharpFuel, rejection := some .fuelDomain }
  else if !commonDomain input then {
    outcome := .rejected "input domain failed" [] tape
    remainingCSharpFuel := csharpFuel, rejection := some .inputDomain }
  else match initializeRoot program input tape csharpFuel with
    | .error reason => {
        outcome := .rejected reason [] tape
        remainingCSharpFuel := csharpFuel, rejection := some .unexpected }
    | .ok machine =>
        let rec loop : Nat → Machine → Execution
          | 0, machine => {
              outcome := .microFuelExhausted (requests machine) machine.tape
              remainingCSharpFuel := machine.csharpFuel }
          | fuel + 1, machine => match step program input machine with
            | .done outcome => outcome
            | .next machine => loop fuel machine
        loop microFuel machine

def runGenerated (input : Input) (tape : List Exchange) (csharpFuel microFuel : Nat) : Outcome :=
  (run Generated.program input tape csharpFuel microFuel).outcome

def runGeneratedObserved (input : Input) (tape : List Exchange) (csharpFuel microFuel : Nat) : Execution :=
  run Generated.program input tape csharpFuel microFuel

