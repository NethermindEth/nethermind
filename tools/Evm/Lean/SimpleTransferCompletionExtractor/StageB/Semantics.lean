private def controlCondition : ConditionKind → String
  | .none => "None"
  | .whenTrue => "WhenTrue"
  | .whenFalse => "WhenFalse"

private def controlValue : Value → Option Bool
  | .boolean value => some value
  | _ => none

private def controlEdge : Option Edge → Option Control.Spec.Edge
  | none => none
  | some edge => some { destination := edge.destination, returns := edge.semantics == "Return" }

@[simp] private theorem controlEdge_none : controlEdge none = none := rfl

@[simp] private theorem controlEdge_some (edge : Edge) :
    controlEdge (some edge) =
      some { destination := edge.destination, returns := edge.semantics == "Return" } := rfl

private def controlExit : ExitKind → Int
  | .branch => Control.Spec.branchExit
  | .returnValue => Control.Spec.returnExit
  | .suspend => Control.Spec.suspendExit
  | .outside => Control.Spec.outsideExit

def controlFinish (block : Block) (carried : Value) : Control.Spec.FinishResult Value :=
  Control.Spec.finishBlock (controlExit block.exit)
    { ordinal := block.ordinal, carried := carried }
    (controlCondition block.condition) (controlValue carried)
    (controlEdge block.fallThrough) (controlEdge block.conditional)

private def generatedIsBoolean : Value → Bool
  | .boolean _ => true
  | _ => false

private def generatedBoolean : Value → Bool
  | .boolean value => value
  | _ => false

private def generatedHasEdge : Option Edge → Bool
  | some _ => true
  | none => false

private def generatedEdgeDestination : Option Edge → Int
  | some edge => edge.destination
  | none => -1

private def generatedEdgeReturns : Option Edge → Bool
  | some edge => edge.semantics == "Return"
  | none => false

def generatedControlFinish (block : Block) (carried : Value) :
    Control.Generated.FinishResult Value :=
  Control.Generated.FinishBlock (controlExit block.exit)
    { ordinal := block.ordinal, carried := carried }
    (controlCondition block.condition) (generatedIsBoolean carried) (generatedBoolean carried)
    (generatedHasEdge block.fallThrough) (generatedEdgeDestination block.fallThrough)
      (generatedEdgeReturns block.fallThrough)
    (generatedHasEdge block.conditional) (generatedEdgeDestination block.conditional)
      (generatedEdgeReturns block.conditional)

private theorem generatedValue_projection (value : Value) :
    (if generatedIsBoolean value then some (generatedBoolean value) else none) =
      controlValue value := by
  cases value <;> rfl

private theorem generatedEdge_projection (edge : Option Edge) :
    Control.edge (generatedHasEdge edge) (generatedEdgeDestination edge)
      (generatedEdgeReturns edge) = controlEdge edge := by
  cases edge <;> rfl

private theorem generatedControlFinish_correct (block : Block) (carried : Value) :
    generatedControlFinish block carried =
      Control.encodeFinishResult (controlFinish block carried) := by
  simpa [generatedControlFinish, controlFinish, Control.encodeCursor,
    generatedValue_projection, generatedEdge_projection] using
    Control.extracted_finishBlock_correct (controlExit block.exit)
      ({ ordinal := block.ordinal, carried := carried } : Control.Spec.BlockCursor Value)
      (controlCondition block.condition) (generatedIsBoolean carried) (generatedBoolean carried)
      (generatedHasEdge block.fallThrough) (generatedEdgeDestination block.fallThrough)
      (generatedEdgeReturns block.fallThrough) (generatedHasEdge block.conditional)
      (generatedEdgeDestination block.conditional) (generatedEdgeReturns block.conditional)

private def finishDecision : Except String (Option Edge) → Control.Spec.Decision
  | .error _ => .invalidCondition
  | .ok none => .missingEdge
  | .ok (some edge) => Control.Spec.finish (controlEdge (some edge))

@[simp] private theorem finishDecision_ok (edge : Option Edge) :
    finishDecision (.ok edge) = Control.Spec.finish (controlEdge edge) := by
  cases edge <;> rfl

@[simp] private theorem finishDecision_error (reason : String) :
    finishDecision (.error reason) = Control.Spec.Decision.invalidCondition := rfl

@[simp] private theorem controlEdge_if (condition : Prop) [Decidable condition]
    (whenTrue whenFalse : Option Edge) :
    controlEdge (if condition then whenTrue else whenFalse) =
      if condition then controlEdge whenTrue else controlEdge whenFalse := by
  by_cases condition <;> simp_all

@[simp] private theorem controlFinish_if (condition : Prop) [Decidable condition]
    (whenTrue whenFalse : Option Control.Spec.Edge) :
    Control.Spec.finish (if condition then whenTrue else whenFalse) =
      if condition then Control.Spec.finish whenTrue else Control.Spec.finish whenFalse := by
  by_cases condition <;> simp_all

@[simp] private theorem controlFinish_none :
    Control.Spec.finish none = Control.Spec.Decision.missingEdge := rfl

@[simp] private theorem controlFinish_some (edge : Edge) :
    Control.Spec.finish (controlEdge (some edge)) =
      if edge.destination < 0 then
        if edge.semantics == "Return" then Control.Spec.Decision.returnValue
        else Control.Spec.Decision.invalidEdge
      else Control.Spec.Decision.jump edge.destination := by
  rfl

private theorem finishEdge_decision (block : Block) (carried : Value) :
    finishDecision (finishEdge block carried) =
      Control.Spec.selectEdge (controlCondition block.condition) (controlValue carried)
        (controlEdge block.fallThrough) (controlEdge block.conditional) := by
  cases block with
  | mk ordinal operations branchValue condition exit fallThrough conditional =>
      cases condition <;> cases carried <;> cases fallThrough <;> cases conditional <;>
        simp [finishEdge, controlCondition, controlValue,
          asBool, Control.Spec.selectEdge]

private theorem finishEdge_of_controlFinish_jump (block : Block) (carried : Value)
    (jumps : (controlFinish block carried).kind = Control.Spec.jumpTag) :
    ∃ edge, finishEdge block carried = .ok (some edge) ∧
      edge.destination = (controlFinish block carried).cursor.ordinal ∧
      ¬edge.destination < 0 := by
  obtain ⟨destination, selected, cursor⟩ := Control.Spec.finishBlock_jump
    (controlExit block.exit) ({ ordinal := block.ordinal, carried := carried } : Control.Spec.BlockCursor Value)
    (controlCondition block.condition) (controlValue carried)
    (controlEdge block.fallThrough) (controlEdge block.conditional) jumps
  have decision := finishEdge_decision block carried
  rw [selected] at decision
  cases result : finishEdge block carried with
  | error reason => simp [finishDecision, result] at decision
  | ok edgeOption =>
      cases edgeOption with
      | none => simp [finishDecision, result] at decision
      | some edge =>
          by_cases negative : edge.destination < 0
          · by_cases returns : edge.semantics == "Return" <;>
              simp [finishDecision, result, controlEdge, Control.Spec.finish, negative, returns] at decision
          · have edgeDestination : edge.destination = destination := by
              simpa [finishDecision, result, controlEdge, Control.Spec.finish, negative] using decision
            have cursorDestination : (controlFinish block carried).cursor.ordinal = destination := by
              change (Control.Spec.finishBlock (controlExit block.exit)
                { ordinal := block.ordinal, carried := carried }
                (controlCondition block.condition) (controlValue carried)
                (controlEdge block.fallThrough) (controlEdge block.conditional)).cursor.ordinal = destination
              exact congrArg Control.Spec.BlockCursor.ordinal cursor
            exact ⟨edge, rfl, edgeDestination.trans cursorDestination.symm, negative⟩

private theorem finishEdge_of_controlFinish_return (block : Block) (carried : Value)
    (returns : (controlFinish block carried).kind = Control.Spec.returnTag) :
    block.exit = .returnValue ∨
      ∃ edge, block.exit ≠ .suspend ∧ finishEdge block carried = .ok (some edge) ∧
        edge.destination < 0 ∧ edge.semantics = "Return" := by
  obtain ⟨_cursor, direct | ⟨notSuspend, selected⟩⟩ := Control.Spec.finishBlock_return
    (controlExit block.exit) ({ ordinal := block.ordinal, carried } : Control.Spec.BlockCursor Value)
    (controlCondition block.condition) (controlValue carried)
    (controlEdge block.fallThrough) (controlEdge block.conditional) returns
  · left
    cases exit : block.exit <;>
      simp [exit, controlExit, Control.Spec.returnExit, Control.Spec.branchExit,
        Control.Spec.suspendExit, Control.Spec.outsideExit] at direct ⊢
  · right
    have runtimeNotSuspend : block.exit ≠ .suspend := by
      cases exit : block.exit <;>
        simp [exit, controlExit, Control.Spec.suspendExit, Control.Spec.branchExit,
          Control.Spec.returnExit, Control.Spec.outsideExit] at notSuspend ⊢
    have decision := finishEdge_decision block carried
    rw [selected] at decision
    cases result : finishEdge block carried with
    | error reason => simp [finishDecision, result] at decision
    | ok edgeOption =>
        cases edgeOption with
        | none => simp [finishDecision, result] at decision
        | some edge =>
            by_cases negative : edge.destination < 0
            · by_cases returnsEdge : edge.semantics == "Return"
              · have semantics : edge.semantics = "Return" := by simpa using returnsEdge
                exact ⟨edge, runtimeNotSuspend, rfl, negative, semantics⟩
              · simp [finishDecision, result, controlEdge, Control.Spec.finish,
                  negative, returnsEdge] at decision
            · simp [finishDecision, result, controlEdge, Control.Spec.finish,
                negative] at decision

private theorem finishBlock_return_step (program : Program) (input : Input)
    (machine : Machine) (frame : RuntimeFrame) (block : Block) (tail : List Task)
    (present : findFrame? machine frame.id = some frame)
    (returns : (controlFinish block frame.carried).kind = Control.Spec.returnTag) :
    step program input
        { machine with work := Task.finishBlock frame.id frame.functionSymbol block :: tail } =
      scheduleReturn { machine with work := tail } frame.carried := by
  obtain direct | ⟨edge, notSuspend, selected, negative, returnsEdge⟩ :=
    finishEdge_of_controlFinish_return block frame.carried returns
  · simp [step, findFrame?] at present ⊢
    rw [present]
    simp [direct]
  · simp [step, findFrame?] at present ⊢
    rw [present]
    simp [notSuspend, selected, negative, returnsEdge]

theorem finishBlock_jump_step (program : Program) (input : Input)
    (machine : Machine) (frame : RuntimeFrame) (block : Block) (tail : List Task)
    (present : findFrame? machine frame.id = some frame)
    (branches : block.exit = .branch)
    (jumps : (controlFinish block frame.carried).kind = Control.Spec.jumpTag) :
    step program input { machine with work := Task.finishBlock frame.id frame.functionSymbol block :: tail } =
      StepResult.next { machine with work :=
        (Task.enterBlock frame.id frame.functionSymbol (controlFinish block frame.carried).cursor.ordinal) :: tail } := by
  obtain ⟨edge, selected, destination, nonnegative⟩ :=
    finishEdge_of_controlFinish_jump block frame.carried jumps
  have cursorNonnegative : ¬(controlFinish block frame.carried).cursor.ordinal < 0 := by
    rw [← destination]
    exact nonnegative
  simp [step, findFrame?] at present ⊢
  rw [present]
  simp [branches, selected, cursorNonnegative, destination]

theorem generatedFinishBlock_jump_step (program : Program) (input : Input)
    (machine : Machine) (frame : RuntimeFrame) (block : Block) (tail : List Task)
    (present : findFrame? machine frame.id = some frame)
    (branches : block.exit = .branch)
    (jumps : (controlFinish block frame.carried).kind = Control.Spec.jumpTag) :
    let result := generatedControlFinish block frame.carried
