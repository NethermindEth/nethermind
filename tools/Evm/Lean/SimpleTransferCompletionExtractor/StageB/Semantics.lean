private def nodeTagsValidFuel : Nat → Node → Bool
  | 0, _ => false
  | fuel + 1, .mk kind _ _ operator _ _ _ primitive _ _ _ binding call additional children =>
      let callValid := match call with
        | none => primitive == .unsupported || (primitive == .boolNot && kind == .unary && operator == "Not;checked=False;lifted=False")
        | some call => primitive == call.target.primitive && exactPrimitiveSymbol primitive call.target.member.symbol
      kind != .returnValue && callValid && binding.additionalMembers.all (fun symbol => symbol.length > 0) &&
        additional.all (fun target => exactPrimitiveSymbol target.primitive target.member.symbol) &&
        children.all (nodeTagsValidFuel fuel)

private def nodeTagsValid (node : Node) : Bool := nodeTagsValidFuel 2048 node

private def programValid (program : Program) : Bool :=
  program.schemaVersion == 1 && program.prefixIntegrity == expectedPrefixIntegrity && program.fuelBound > 0 &&
  program.functions.any (fun function => function.signature.symbol == program.entry) &&
  program.functions.all (fun function => function.blocks.all (fun block =>
    block.operations.all nodeTagsValid && block.branchValue.all nodeTagsValid))

inductive NodeReturnFree : Node → Prop where
  | mk (node : Node) (kind : node.kind ≠ .returnValue)
      (children : ∀ child ∈ node.children, NodeReturnFree child) : NodeReturnFree node

theorem NodeReturnFree.notReturn {node : Node} (free : NodeReturnFree node) :
    node.kind ≠ .returnValue := by
  cases free with
  | mk _ kind _ => exact kind

theorem NodeReturnFree.child {node : Node} (free : NodeReturnFree node)
    (child : Node) (member : child ∈ node.children) : NodeReturnFree child := by
  cases free with
  | mk _ _ children => exact children child member

def ProgramReturnFree (program : Program) : Prop :=
  ∀ function ∈ program.functions, ∀ block ∈ function.blocks,
    (∀ node ∈ block.operations, NodeReturnFree node) ∧
    (∀ node, block.branchValue = some node → NodeReturnFree node)

private theorem nodeTagsValidFuel_returnFree (fuel : Nat) (node : Node)
    (valid : nodeTagsValidFuel fuel node = true) : NodeReturnFree node := by
  induction fuel generalizing node with
  | zero => simp [nodeTagsValidFuel] at valid
  | succ fuel induction =>
      cases node with
      | mk kind typeName symbol operator constant conversion literal primitive implicit completes mode binding call additional children =>
          simp only [nodeTagsValidFuel, Bool.and_eq_true] at valid
          refine NodeReturnFree.mk _ ?_ ?_
          · simpa [Node.kind] using valid.1.1.1.1
          · intro child member
            exact induction child (List.all_eq_true.mp valid.2 child member)

theorem nodeTagsValid_return_rejected (node : Node) (returns : node.kind = .returnValue) :
    nodeTagsValid node = false := by
  cases valid : nodeTagsValid node with
  | false => rfl
  | true => exact False.elim ((nodeTagsValidFuel_returnFree 2048 node valid).notReturn returns)

theorem nodeTagsValid_returnChild_rejected (node child : Node)
    (member : child ∈ node.children) (returns : child.kind = .returnValue) :
    nodeTagsValid node = false := by
  cases valid : nodeTagsValid node with
  | false => rfl
  | true =>
      exact False.elim (((nodeTagsValidFuel_returnFree 2048 node valid).child child member).notReturn returns)

theorem programValid_returnFree (program : Program) (valid : programValid program = true) :
    ProgramReturnFree program := by
  simp only [programValid, Bool.and_eq_true] at valid
  intro function member block blockMember
  have blocks := List.all_eq_true.mp valid.2 function member
  have nodes := List.all_eq_true.mp blocks block blockMember
  simp only [Bool.and_eq_true] at nodes
  constructor
  · intro node member
    exact nodeTagsValidFuel_returnFree 2048 node (List.all_eq_true.mp nodes.1 node member)
  · intro node present
    have validNode := nodes.2
    rw [present] at validNode
    exact nodeTagsValidFuel_returnFree 2048 node validNode

private def popOperands (count : Nat) (stack : List Operand) : Option (List Operand × List Operand) :=
  let values := stack.take count
  if values.length == count then some (values.reverse, stack.drop count) else none

private def patternLeafFuel? : Nat → Node → Except String (Node × Bool)
  | 0, _ => throw "pattern depth exceeded"
  | fuel + 1, node =>
      match node.kind, node.children with
      | .constantPattern, [constant] => pure (constant, false)
      | .negatedPattern, [child] => do
          let (constant, negated) ← patternLeafFuel? fuel child
          pure (constant, !negated)
      | _, _ => throw "unsupported pattern shape"

private def patternLeaf? (node : Node) : Except String (Node × Bool) :=
  patternLeafFuel? 256 node

private def argument? (call : Call) (ordinal : Nat) : Option Argument :=
  call.arguments.find? (fun argument => argument.ordinal == ordinal)

private def operand? (operands : List Operand) (index : Int) : Option Operand :=
  if index < 0 then none else operands.get? (Int.toNat index)

private def readArguments (machine : Machine) (call : Call) (operands : List Operand) : Except String (List Value) := do
  if call.arguments.isEmpty then operands.mapM (readOperand machine)
  else
    call.arguments.mergeSort (fun left right => left.ordinal <= right.ordinal) |>.mapM (fun argument => do
      let operand ← operands.get? argument.child |>.toExcept s!"missing argument child {argument.child}"
      readOperand machine operand)

private def takeReply (machine : Machine) (request : Request) (accept : Reply → Option α) : Except Rejection (Machine × α) := do
  let exchange ← match machine.tape.head? with
    | some value => pure value
    | none => throw { code := .tapeEmpty, detail := "response tape is empty" }
  if exchange.request != request then throw { code := .tapeRequest, detail := s!"response request mismatch: {repr request}" }
  let value ← match accept exchange.reply with
    | some value => pure value
    | none => throw { code := .tapeReply, detail := s!"response type mismatch: {repr request}" }
  pure ({ machine with tape := machine.tape.tail, requestsRev := request :: machine.requestsRev }, value)

private def tick (machine : Machine) : Except Outcome Machine :=
  match machine.csharpFuel with
  | 0 => throw (.fuelExhausted (requests machine) machine.tape)
  | fuel + 1 => pure { machine with csharpFuel := fuel }

private def seekResume? : List Task → Option (Task × List Task)
  | [] => none
  | (task@(.resume ..)) :: tail => some (task, tail)
  | _ :: tail => seekResume? tail

def ResumeFree : List Task → Prop
  | [] => True
  | (.resume ..) :: _ => False
  | _ :: tail => ResumeFree tail

private def scheduleReturn (machine : Machine) (value : Value) : StepResult :=
  match seekResume? machine.work with
  | none => .done {
      outcome := .returned value (requests machine) machine.tape
      remainingCSharpFuel := machine.csharpFuel }
  | some (resume, tail) => .next { machine with work := resume :: tail, returned := some value }

private theorem seekResume?_append_resume (skipped tail : List Task)
    (resume : Task) (isResume : ∃ caller callee kind, resume = .resume caller callee kind)
    (free : ResumeFree skipped) :
    seekResume? (skipped ++ resume :: tail) = some (resume, tail) := by
  obtain ⟨caller, callee, kind, rfl⟩ := isResume
  induction skipped with
  | nil => rfl
  | cons task skipped induction =>
      cases task <;> simp_all [ResumeFree, seekResume?]

private theorem seekResume?_none (tasks : List Task) (free : ResumeFree tasks) :
    seekResume? tasks = none := by
  induction tasks with
  | nil => rfl
  | cons task tasks induction =>
      cases task <;> simp_all [ResumeFree, seekResume?]

private def projection
    (input : Input) (machine : Machine) (frameId : FrameId) (node : Node) (call : Call)
    (receiver : Operand) : Except String (Machine × Operand) := do
  let receiverValue ← readOperand machine receiver
  let member := call.target.member
  if node.mode != .value && call.target.primitive == .txValueRef then
    let (machine, id) := allocateCell machine frameId member.symbol "tx.ValueRef" (.uint256 input.tx.value)
    pure (machine, .location { root := id, fields := [], readOnly := true, provenance := "tx.ValueRef" })
  else if node.mode != .value && receiverValue matches .struct .. then
    let location ← match receiver with
      | .location location => pure location
      | _ => throw "struct field location has no receiver location"
    pure (machine, .location {
      root := location.root,
      fields := location.fields ++ [member.name],
      readOnly := node.mode == .readOnlyLocation,
      provenance := location.provenance ++ "." ++ member.name })
  else
    let existingField := match receiverValue with
      | .struct _ fields => field? fields member.name
      | _ => none
    let value ← match existingField with
    | some value => pure value
    | none => match call.target.primitive with
      | .txSender => pure (.address input.tx.sender)
      | .txRecipient => pure (input.tx.recipient.map Value.address |>.getD (.null member.typeName))
      | .txValue | .txValueRef => pure (.uint256 input.tx.value)
      | .txData => pure (.bytes input.tx.data)
      | .txGasLimit => pure (.unsigned input.tx.gasLimit)
      | .txAuthorizationList => pure (if input.tx.hasAuthorizationList then .reference member.typeName "authorization-list" else .null member.typeName)
      | .specEip8037 => pure (.boolean input.spec.eip8037Enabled)
      | .specEip7708 => pure (.boolean input.spec.eip7708Enabled)
      | .tracerState => pure (.boolean input.tracer.state)
      | .tracerActions => pure (.boolean input.tracer.actions)
      | .tracerCode => pure (.boolean input.tracer.code)
      | .tracerLogs => pure (.boolean input.tracer.logs)
      | .tracerAccess => pure (.boolean input.tracer.access)
      | .processorWorld => pure (.reference member.typeName "world-state")
      | .processorCodeRepository => pure (.reference member.typeName "code-repository")
      | .processorCodeOverridable => pure (.boolean input.isCodeOverridable)
      | .processorLogger => pure (.reference member.typeName "logger")
      | .forceSimpleTransferDisabled => pure (.boolean input.forceSimpleTransferDisabled)
      | .defaultTxGasLimitCap => pure (.unsigned input.executionGasLimitCap)
      | .newAccountState => pure (.signed input.newAccountStateCost)
      | .uint256Zero => pure (.uint256 0)
      | .nullTracer => pure (.reference member.typeName "null-tracer")
      | .uint256IsZero => pure (.boolean ((← asUInt256 receiverValue) == 0))
      | .codeInfoIsEmpty => valueField receiverValue "IsEmpty"
      | .structField => valueField receiverValue member.name
      | .unsupported =>
          if member.kind == .field && node.literal != .none then pure (literalValue member.typeName node.literal)
          else throw s!"unsupported projection {member.symbol}"
      | primitive => throw s!"unsupported projection primitive {repr primitive}"
    pure (machine, .immediate value)

private def writeArgument
    (machine : Machine) (call : Call) (operands : List Operand) (ordinal : Nat) (value : Value) : Except String Machine := do
  let argument ← argument? call ordinal |>.toExcept s!"missing out argument {ordinal}"
  let operand ← operands.get? argument.child |>.toExcept s!"missing out child {argument.child}"
  writeOperand machine operand value

private def externalCall
    (_input : Input) (machine : Machine) (_frameId : FrameId) (_node : Node) (call : Call)
    (operands : List Operand) : Except Rejection (Machine × Operand) := do
  let values ← liftRuntime (readArguments machine call operands)
  match call.target.primitive with
  | .codeLookup =>
      let recipientValue ← liftRuntime (values.get? 0 |>.toExcept "missing code lookup recipient")
      let recipient ← liftRuntime (asAddress recipientValue)
      let followValue ← liftRuntime (values.get? 1 |>.toExcept "missing code lookup flag")
      let follow ← liftRuntime (asBool followValue)
      let request := Request.codeLookup recipient follow
      let (machine, reply) ← takeReply machine request (fun | .codeInfo empty delegation => some (empty, delegation) | _ => none)
      let delegationParameter ← liftRuntime (call.target.member.parameters.get? 3 |>.toExcept "missing delegation parameter")
      let delegation := reply.2.map Value.address |>.getD (.null delegationParameter.typeName)
      let machine ← liftRuntime (writeArgument machine call operands 3 delegation)
      pure (machine, .immediate (.struct call.target.member.typeName [("IsEmpty", .boolean reply.1)]))
  | .isDeadAccount =>
      let recipientValue ← liftRuntime (values.get? 0 |>.toExcept "missing dead-account recipient")
      let recipient ← liftRuntime (asAddress recipientValue)
      let request := Request.isDeadAccount recipient
      let (machine, value) ← takeReply machine request (fun | .boolean value => some value | _ => none)
      pure (machine, .immediate (.boolean value))
  | .subtractBalance =>
      let addressValue ← liftRuntime (values.get? 0 |>.toExcept "missing subtract address")
      let address ← liftRuntime (asAddress addressValue)
      let amountValue ← liftRuntime (values.get? 1 |>.toExcept "missing subtract amount")
      let amount ← liftRuntime (asUInt256 amountValue)
      let request := Request.subtractBalance address amount
      let (machine, _) ← takeReply machine request (fun | .unit => some () | _ => none)
      pure (machine, .immediate .unit)
  | .addBalance =>
      let addressValue ← liftRuntime (values.get? 0 |>.toExcept "missing add address")
      let address ← liftRuntime (asAddress addressValue)
      let amountValue ← liftRuntime (values.get? 1 |>.toExcept "missing add amount")
      let amount ← liftRuntime (asUInt256 amountValue)
      let request := Request.addBalance address amount
      let (machine, value) ← takeReply machine request (fun | .boolean value => some value | _ => none)
      pure (machine, .immediate (.boolean value))
  | .commit =>
      let tracerValue ← liftRuntime (values.get? 1 |>.toExcept "missing commit tracer")
      let tracingState := match tracerValue with | .reference _ identity => identity == "tracer" | _ => false
      let commitRootsValue ← liftRuntime (values.reverse.head?.toExcept "missing commit-roots flag")
      let commitRoots ← liftRuntime (asBool commitRootsValue)
      let request := Request.commit tracingState commitRoots
      let (machine, _) ← takeReply machine request (fun | .unit => some () | _ => none)
      pure (machine, .immediate .unit)
  | .trace =>
      let request := Request.incrementEmptyCalls
      let (machine, _) ← takeReply machine request (fun | .unit => some () | _ => none)
      pure (machine, .immediate .unit)
  | .addressEquality =>
      let left ← liftRuntime (values.get? 0 |>.toExcept "missing equality left")
      let right ← liftRuntime (values.get? 1 |>.toExcept "missing equality right")
      pure (machine, .immediate (.boolean (valueEq left right)))
  | .enumHasFlag => pure (machine, .immediate (.boolean false))
  | .uint256Min =>
      let leftValue ← liftRuntime (values.get? 0 |>.toExcept "missing min left")
      let left ← liftRuntime (asUInt256 leftValue)
      let rightValue ← liftRuntime (values.get? 1 |>.toExcept "missing min right")
      let right ← liftRuntime (asUInt256 rightValue)
      pure (machine, .immediate (.uint256 (min left right)))
  | .journalConstructor => pure (machine, .immediate (.struct call.target.member.declaringType []))
  | primitive => throw { code := .unexpected, detail := s!"unsupported external primitive {repr primitive}" }

private def initResult (values : List Value) : Except String Value := do
  let gasLimitValue ← values.get? 0 |>.toExcept "missing initialization gas limit"
  let gasLimit ← asUnsigned gasLimitValue
  let intrinsicExecutionValue ← values.get? 1 |>.toExcept "missing initialization execution gas"
  let intrinsicExecution ← asUnsigned intrinsicExecutionValue
  let intrinsicStateValue ← values.get? 2 |>.toExcept "missing initialization state gas"
  let intrinsicState ← asSigned intrinsicStateValue
  let enabledValue ← values.get? 3 |>.toExcept "missing initialization flag"
  let enabled ← asBool enabledValue
  let capValue ← values.get? 4 |>.toExcept "missing initialization cap"
  let cap ← asUnsigned capValue
  let result := Eip803x.Generated.TransactionGasInitializationKernel.tryCreate gasLimit intrinsicExecution intrinsicState enabled cap
  let outcome : Int := match result.outcome with | .success => 0 | .intrinsicGasExceedsLimit => 1
  pure (.struct "global::Nethermind.Evm.GasPolicy.TransactionGasInitializationResult"
    [("Outcome", .enum "global::Nethermind.Evm.GasPolicy.TransactionGasInitializationOutcome" outcome),
     ("Value", .unsigned result.value), ("StateReservoir", .signed result.stateReservoir),
     ("StateGasUsed", .signed result.stateGasUsed), ("StateGasSpill", .signed result.stateGasSpill),
     ("StateGasSpillRefunded", .signed result.stateGasSpillRefunded)])

private def chargeResult (values : List Value) : Except String Value := do
  let valueValue ← values.get? 0 |>.toExcept "missing charge value"
  let value ← asUnsigned valueValue
  let reservoirValue ← values.get? 1 |>.toExcept "missing charge reservoir"
  let reservoir ← asSigned reservoirValue
  let usedValue ← values.get? 2 |>.toExcept "missing charge used"
  let used ← asSigned usedValue
  let spillValue ← values.get? 3 |>.toExcept "missing charge spill"
  let spill ← asSigned spillValue
  let refundedValue ← values.get? 4 |>.toExcept "missing charge refunded"
  let refunded ← asSigned refundedValue
  let costValue ← values.get? 5 |>.toExcept "missing charge cost"
  let cost ← asSigned costValue
  let result := Eip803x.Generated.StateGasChargeKernel.tryCharge value reservoir used spill refunded cost
  let outcome : Int := match result.outcome with | .success => 0 | .outOfGas => 1
  pure (.struct "global::Nethermind.Evm.GasPolicy.StateGasChargeResult"
    [("Outcome", .enum "global::Nethermind.Evm.GasPolicy.StateGasChargeOutcome" outcome),
     ("Value", .unsigned result.value), ("StateReservoir", .signed result.stateReservoir),
     ("StateGasUsed", .signed result.stateGasUsed), ("StateGasSpill", .signed result.stateGasSpill),
     ("StateGasSpillRefunded", .signed result.stateGasSpillRefunded)])

private def passingMode : ArgumentMode → PassingMode
  | .readOnlyLocation => .readOnlyLocation
  | _ => .value

private def refundOperands (machine : Machine) (call : Call) (operands : List Operand) : Except String (List RefundOperand) :=
  call.arguments.mergeSort (fun left right => left.ordinal <= right.ordinal) |>.mapM (fun argument => do
    let operand ← operands.get? argument.child |>.toExcept s!"missing refund child {argument.child}"
    let value ← readOperand machine operand
    let location ← match operand with
      | .location location => some <$> resolveLocation machine location
      | _ => pure none
    pure {
      ordinal := argument.ordinal,
      mode := passingMode argument.mode,
      value := value,
      location := location,
      provenance := location.map (·.provenance) })

private def bindCallArguments
    (machine : Machine) (function : Function) (call : Call) (operands : List Operand)
    (thisOperand : Operand) : Except String (Machine × FrameId) := do
  let bindings ← if call.arguments.isEmpty then
      if function.signature.parameters.isEmpty then pure []
      else if function.signature.parameters.length != operands.length then throw "operator arity changed"
      else pure ((function.signature.parameters.zip operands).map (fun item =>
        ({ item.1 with refKind := .none }, item.2, ArgumentMode.value)))
    else call.arguments.mapM (fun argument => do
      let parameter ← function.signature.parameters.get? argument.ordinal |>.toExcept s!"missing parameter {argument.ordinal}"
      let operand ← operands.get? argument.child |>.toExcept s!"missing child {argument.child}"
      pure (parameter, operand, argument.mode))
  createFrame machine function thisOperand bindings

private theorem mapM_except_projection {α β γ ε : Type} (items : List α)
    (action : α → Except ε β) (selection : α → Option γ) (projection : β → γ)
    (result : List β) (succeeded : items.mapM action = .ok result)
    (agree : ∀ item value, action item = .ok value → selection item = some (projection value)) :
    items.mapM selection = some (result.map projection) ∧ result.length = items.length := by
  induction items generalizing result with
  | nil =>
      have empty : result = [] := by simpa [pure, Except.pure] using succeeded.symm
      simp [empty]
  | cons item items induction =>
      simp only [List.mapM_cons] at succeeded
      cases first : action item with
      | error reason => simp [first, bind, Except.bind] at succeeded
      | ok value =>
          cases rest : items.mapM action with
          | error reason => simp [first, rest, bind, Except.bind] at succeeded
          | ok values =>
              have equal : value :: values = result := by
                simpa [first, rest, bind, Except.bind, pure, Except.pure] using succeeded
              subst result
              obtain ⟨selected, length⟩ := induction values rest
              simp [List.mapM_cons, agree item value first, selected, length]

theorem bindCallArguments_explicit_byValue_layout (before after : Machine) (function : Function)
    (call : Call) (operands : List Operand) (receiver : Operand) (frameId : FrameId)
    (parameters : List Parameter) (explicit : call.arguments ≠ [])
    (selected : call.arguments.mapM (fun argument => function.signature.parameters[argument.ordinal]?) =
      some parameters)
    (byValue : ∀ parameter ∈ parameters, parameter.refKind = .none)
    (succeeded : bindCallArguments before function call operands receiver = .ok (after, frameId)) :
    let layout := (parameterAllocationOrder before.nextCell (parameters.map (·.symbol))).reverse
    ParameterCellsAllocated before after frameId call.arguments.length ∧
      ∃ frame added,
        findFrame? after frameId = some frame ∧ after.cells = added ++ before.cells ∧
        added.map (fun cell => (cell.symbol, cell.id)) = layout ∧
        (∀ cell ∈ added, cell.alias = none) ∧
        ∀ symbol, frame.cells.find? (fun binding => binding.1 == symbol) =
          layout.find? (fun binding => binding.1 == symbol) := by
  unfold bindCallArguments at succeeded
  split at succeeded
  · have empty : call.arguments = [] := by simpa using ‹call.arguments.isEmpty = true›
    exact False.elim (explicit empty)
  · generalize resolved : (call.arguments.mapM (m := Except String) _ :
        Except String (List (Parameter × Operand × ArgumentMode))) = bindings at succeeded
    cases bindings with
    | error reason => simp [bind, Except.bind] at succeeded
    | ok bindings =>
        have projection := mapM_except_projection call.arguments _
          (fun argument => function.signature.parameters[argument.ordinal]?) (·.1) bindings resolved
          (by
            intro argument binding completed
            cases parameter : function.signature.parameters[argument.ordinal]? with
            | none => simp [List.get?, parameter, Option.toExcept, bind, Except.bind] at completed
            | some value =>
                cases operand : operands[argument.child]? with
                | none =>
                    simp [List.get?, parameter, operand, Option.toExcept, bind, Except.bind,
                      pure, Except.pure] at completed
                | some input =>
                    have equal : (value, input, argument.mode) = binding := by
                      simpa [List.get?, parameter, operand, Option.toExcept, bind, Except.bind,
                        pure, Except.pure] using completed
                    simp [equal.symm])
        have parameterOrder : bindings.map (·.1) = parameters := by
          rw [selected] at projection
          exact Option.some.inj projection.1.symm
        have kinds : ∀ binding ∈ bindings, binding.1.refKind = .none := by
          intro binding member
          apply byValue binding.1
          rw [← parameterOrder]
          exact List.mem_map.mpr ⟨binding, member, rfl⟩
        have layout := createFrame_success_byValue_layout before after function receiver bindings
          frameId kinds succeeded
        have symbols : bindings.map (fun binding => binding.1.symbol) = parameters.map (·.symbol) := by
          rw [← parameterOrder, List.map_map]
          rfl
        simpa only [projection.2, symbols] using layout

theorem bindCallArguments_explicit_byValue_unique_lookup (before after : Machine) (function : Function)
    (call : Call) (operands : List Operand) (receiver : Operand) (frameId : FrameId)
    (parameters : List Parameter) (explicit : call.arguments ≠ [])
    (selected : call.arguments.mapM (fun argument => function.signature.parameters[argument.ordinal]?) =
      some parameters)
    (byValue : ∀ parameter ∈ parameters, parameter.refKind = .none)
    (unique : (parameters.map (·.symbol)).Nodup)
    (succeeded : bindCallArguments before function call operands receiver = .ok (after, frameId)) :
    ParameterCellsAllocated before after frameId call.arguments.length ∧
      ∃ frame, findFrame? after frameId = some frame ∧
        ∀ index parameter, parameters[index]? = some parameter →
          frame.cells.find? (fun binding => binding.1 == parameter.symbol) =
            some (parameter.symbol, before.nextCell + index) := by
  obtain ⟨allocated, frame, _, present, _, _, _, lookups⟩ :=
    bindCallArguments_explicit_byValue_layout before after function call operands receiver frameId
      parameters explicit selected byValue succeeded
  refine ⟨allocated, frame, present, ?_⟩
  intro index parameter parameterAt
  rw [lookups]
  exact parameterAllocationOrder_reverse_find before.nextCell (parameters.map (·.symbol)) index
    parameter.symbol unique (by simp [parameterAt])

theorem bindCallArguments_transactionResult_entry_exact (before : Machine) (function : Function)
    (call : Call) (receiver : Operand) (error exception description : Parameter)
    (errorValue exceptionValue descriptionValue : Value)
    (parameters : function.signature.parameters = [error, exception, description])
    (descriptors : call.arguments =
      [{ child := 0, ordinal := 0, mode := .value, implicit := false, kind := "Explicit" },
       { child := 1, ordinal := 2, mode := .value, implicit := false, kind := "Explicit" },
       { child := 2, ordinal := 1, mode := .value, implicit := true, kind := "DefaultValue" }])
    (errorKind : error.refKind = .none) (exceptionKind : exception.refKind = .none)
    (descriptionKind : description.refKind = .none)
    (symbols : error.symbol ≠ exception.symbol ∧ error.symbol ≠ description.symbol ∧
      exception.symbol ≠ description.symbol)
    (freshFrame : ∀ frame ∈ before.frames, frame.id ≠ before.nextFrame) :
    let frameId := before.nextFrame
    let errorCell : Cell :=
      { id := before.nextCell, frame := frameId, symbol := error.symbol,
        provenance := error.symbol, value := errorValue, alias := none }
    let descriptionCell : Cell :=
      { id := before.nextCell + 1, frame := frameId, symbol := description.symbol,
        provenance := description.symbol, value := descriptionValue, alias := none }
    let exceptionCell : Cell :=
      { id := before.nextCell + 2, frame := frameId, symbol := exception.symbol,
        provenance := exception.symbol, value := exceptionValue, alias := none }
    let frame : RuntimeFrame :=
      { id := frameId, functionSymbol := function.signature.symbol, thisOperand := receiver,
        cells := [(exception.symbol, exceptionCell.id), (description.symbol, descriptionCell.id),
          (error.symbol, errorCell.id)], captures := [], carried := .unit }
    bindCallArguments before function call
      [.immediate errorValue, .immediate descriptionValue, .immediate exceptionValue] receiver =
      .ok ({ before with
          frames := frame :: before.frames,
          cells := [exceptionCell, descriptionCell, errorCell] ++ before.cells,
          nextFrame := before.nextFrame + 1, nextCell := before.nextCell + 3 }, frameId) := by
  obtain ⟨errorException, errorDescription, exceptionDescription⟩ := symbols
  simp [bindCallArguments, descriptors, parameters, List.get?, createFrame, readOperand, allocateCell,
    bindCell, findFrame?, replaceFrame, Option.toExcept, bind, Except.bind, pure, Except.pure,
    errorKind, exceptionKind, descriptionKind, errorException, errorDescription,
    Ne.symm exceptionDescription, Nat.add_assoc]
  conv => rhs; rw [← List.map_id before.frames]
  apply List.map_congr_left
  intro old member
  simp [Function.comp_def, freshFrame old member]

theorem bindCallArguments_descriptorFree_value_copy (machine : Machine) (function : Function)
    (call : Call) (operands : List Operand) (thisOperand : Operand)
    (descriptorFree : call.arguments = [])
    (arity : function.signature.parameters.length = operands.length) :
    bindCallArguments machine function call operands thisOperand =
      createFrame machine function thisOperand
        ((function.signature.parameters.zip operands).map (fun item =>
          ({ item.1 with refKind := .none }, item.2, ArgumentMode.value))) := by
  cases parameters : function.signature.parameters with
  | nil =>
      have empty : operands = [] := by simpa [parameters] using arity.symm
      simp [bindCallArguments, descriptorFree, parameters, empty]
  | cons first rest =>
      simp [parameters] at arity
      simp [bindCallArguments, descriptorFree, parameters, arity]

theorem bindCallArguments_descriptorFree_arity_rejected (machine : Machine) (function : Function)
    (call : Call) (operands : List Operand) (thisOperand : Operand)
    (descriptorFree : call.arguments = [])
    (parameters : function.signature.parameters ≠ [])
    (arity : function.signature.parameters.length ≠ operands.length) :
    bindCallArguments machine function call operands thisOperand = .error "operator arity changed" := by
  simp [bindCallArguments, descriptorFree, parameters, arity]
  rfl

theorem bindCallArguments_descriptorFree_noParameters (machine : Machine) (function : Function)
    (call : Call) (operands : List Operand) (thisOperand : Operand)
    (descriptorFree : call.arguments = [])
    (parameters : function.signature.parameters = []) :
    bindCallArguments machine function call operands thisOperand =
      createFrame machine function thisOperand [] := by
  simp [bindCallArguments, descriptorFree, parameters]

theorem bindCallArguments_success_establishes (before after : Machine) (function : Function)
    (call : Call) (operands : List Operand) (receiver : Operand) (frameId : FrameId)
    (succeeded : bindCallArguments before function call operands receiver = .ok (after, frameId)) :
    CallFrameEstablished before after frameId function receiver := by
  unfold bindCallArguments at succeeded
  split at succeeded
  · split at succeeded
    · exact createFrame_success_establishes before after function receiver [] frameId succeeded
    · split at succeeded
      · simp [bind, Except.bind] at succeeded
      · exact createFrame_success_establishes before after function receiver _ frameId succeeded
  · generalize resolved : (call.arguments.mapM (m := Except String) _ :
        Except String (List (Parameter × Operand × ArgumentMode))) = bindings at succeeded
    cases bindings with
    | error reason => simp [bind, Except.bind] at succeeded
    | ok bindings =>
        exact createFrame_success_establishes before after function receiver bindings frameId succeeded

theorem bindCallArguments_success_cellAllocation (before after : Machine) (function : Function)
    (call : Call) (operands : List Operand) (receiver : Operand) (frameId : FrameId)
    (succeeded : bindCallArguments before function call operands receiver = .ok (after, frameId)) :
    ∃ count, ParameterCellsAllocated before after frameId count := by
  unfold bindCallArguments at succeeded
  split at succeeded
  · split at succeeded
    · exact ⟨_, createFrame_success_cellAllocation before after function receiver [] frameId succeeded⟩
    · split at succeeded
      · simp [bind, Except.bind] at succeeded
      · exact ⟨_, createFrame_success_cellAllocation before after function receiver _ frameId succeeded⟩
  · generalize resolved : (call.arguments.mapM (m := Except String) _ :
        Except String (List (Parameter × Operand × ArgumentMode))) = bindings at succeeded
    cases bindings with
    | error reason => simp [bind, Except.bind] at succeeded
    | ok bindings =>
        exact ⟨_, createFrame_success_cellAllocation before after function receiver _ frameId succeeded⟩

theorem bindCallArguments_success_preserves_read (before after : Machine) (function : Function)
    (call : Call) (operands : List Operand) (receiver : Operand) (frameId : FrameId)
    (succeeded : bindCallArguments before function call operands receiver = .ok (after, frameId))
    (fresh : ∀ cell ∈ before.cells, cell.id < before.nextCell)
    (operand : Operand) (value : Value) (read : readOperand before operand = .ok value) :
    readOperand after operand = .ok value := by
  obtain ⟨count, allocated⟩ := bindCallArguments_success_cellAllocation before after function call
    operands receiver frameId succeeded
  exact ParameterCellsAllocated.preserves_read before after frameId count allocated fresh operand value read

theorem bindCallArguments_descriptorFree_cellCount (before after : Machine) (function : Function)
    (call : Call) (operands : List Operand) (receiver : Operand) (frameId : FrameId)
    (descriptorFree : call.arguments = [])
    (arity : function.signature.parameters.length = operands.length)
    (succeeded : bindCallArguments before function call operands receiver = .ok (after, frameId)) :
    ParameterCellsAllocated before after frameId operands.length := by
  rw [bindCallArguments_descriptorFree_value_copy before function call operands receiver
    descriptorFree arity] at succeeded
  have allocated := createFrame_success_cellAllocation before after function receiver _ frameId succeeded
  simpa [ParameterCellCount, List.map_map, Function.comp_def, List.map_const', List.sum_replicate_nat,
    arity] using allocated

theorem bindCallArguments_noParameters_noCells (before after : Machine) (function : Function)
    (call : Call) (operands : List Operand) (receiver : Operand) (frameId : FrameId)
    (descriptorFree : call.arguments = []) (parameters : function.signature.parameters = [])
    (succeeded : bindCallArguments before function call operands receiver = .ok (after, frameId)) :
    after.cells = before.cells ∧ after.nextCell = before.nextCell := by
  rw [bindCallArguments_descriptorFree_noParameters before function call operands receiver
    descriptorFree parameters] at succeeded
  obtain ⟨added, cells, length, next, _, _⟩ :=
    createFrame_success_cellAllocation before after function receiver [] frameId succeeded
  have empty : added = [] := by simpa using length
  exact ⟨by simpa [empty] using cells, by simpa using next⟩

def localCallPreparation (machine : Machine) (caller : FrameId) (call : Call)
    (operands : List Operand) (constructing : Bool) : Machine × Operand :=
  if constructing then
    let provenance := "new:" ++ call.target.member.symbol
    let (machine, id) := allocateCell machine caller call.target.member.symbol provenance
      (defaultValue call.target.member.declaringType)
    (machine, .location { root := id, fields := [], readOnly := false, provenance })
  else (machine, operand? operands call.receiverChild |>.getD (.immediate .unit))

theorem localCallPreparation_preserves (machine : Machine) (caller : FrameId) (call : Call)
    (operands : List Operand) (constructing : Bool) :
    CallContextPreserved machine (localCallPreparation machine caller call operands constructing).1 ∧
      (localCallPreparation machine caller call operands constructing).1.nextFrame = machine.nextFrame := by
  cases constructing <;> simp [localCallPreparation, CallContextPreserved, allocateCell]

theorem localCallPreparation_constructor_exact (machine : Machine) (caller : FrameId)
    (call : Call) (operands : List Operand) :
    let provenance := "new:" ++ call.target.member.symbol
    let receiver : Cell :=
      { id := machine.nextCell, frame := caller, symbol := call.target.member.symbol,
        provenance, value := defaultValue call.target.member.declaringType, alias := none }
    localCallPreparation machine caller call operands true =
      ({ machine with cells := receiver :: machine.cells, nextCell := machine.nextCell + 1 },
       .location { root := machine.nextCell, fields := [], readOnly := false, provenance }) := by
  rfl

theorem localCall_transactionResult_entry_exact (before : Machine) (caller : FrameId)
    (function : Function) (call : Call) (operands : List Operand)
    (error exception description : Parameter) (errorValue exceptionValue descriptionValue : Value)
    (parameters : function.signature.parameters = [error, exception, description])
    (descriptors : call.arguments =
      [{ child := 0, ordinal := 0, mode := .value, implicit := false, kind := "Explicit" },
       { child := 1, ordinal := 2, mode := .value, implicit := false, kind := "Explicit" },
       { child := 2, ordinal := 1, mode := .value, implicit := true, kind := "DefaultValue" }])
    (errorKind : error.refKind = .none) (exceptionKind : exception.refKind = .none)
    (descriptionKind : description.refKind = .none)
    (symbols : error.symbol ≠ exception.symbol ∧ error.symbol ≠ description.symbol ∧
      exception.symbol ≠ description.symbol)
    (freshFrame : ∀ frame ∈ before.frames, frame.id ≠ before.nextFrame) :
    let callee := before.nextFrame
    let receiverProvenance := "new:" ++ call.target.member.symbol
    let receiver : Cell :=
      { id := before.nextCell, frame := caller, symbol := call.target.member.symbol,
        provenance := receiverProvenance, value := defaultValue call.target.member.declaringType,
        alias := none }
    let receiverOperand : Operand := .location
      { root := receiver.id, fields := [], readOnly := false, provenance := receiverProvenance }
    let errorCell : Cell :=
      { id := before.nextCell + 1, frame := callee, symbol := error.symbol,
        provenance := error.symbol, value := errorValue, alias := none }
    let descriptionCell : Cell :=
      { id := before.nextCell + 2, frame := callee, symbol := description.symbol,
        provenance := description.symbol, value := descriptionValue, alias := none }
    let exceptionCell : Cell :=
      { id := before.nextCell + 3, frame := callee, symbol := exception.symbol,
        provenance := exception.symbol, value := exceptionValue, alias := none }
    let frame : RuntimeFrame :=
      { id := callee, functionSymbol := function.signature.symbol, thisOperand := receiverOperand,
        cells := [(exception.symbol, exceptionCell.id), (description.symbol, descriptionCell.id),
          (error.symbol, errorCell.id)], captures := [], carried := .unit }
    bindCallArguments (localCallPreparation before caller call operands true).1 function call
      [.immediate errorValue, .immediate descriptionValue, .immediate exceptionValue]
      (localCallPreparation before caller call operands true).2 =
      .ok ({ before with
          frames := frame :: before.frames,
          cells := [exceptionCell, descriptionCell, errorCell, receiver] ++ before.cells,
          nextFrame := before.nextFrame + 1, nextCell := before.nextCell + 4 }, callee) := by
  let receiver : Cell :=
    { id := before.nextCell, frame := caller, symbol := call.target.member.symbol,
      provenance := "new:" ++ call.target.member.symbol,
      value := defaultValue call.target.member.declaringType, alias := none }
  let prepared := { before with cells := receiver :: before.cells, nextCell := before.nextCell + 1 }
  let receiverOperand : Operand := .location
    { root := before.nextCell, fields := [], readOnly := false,
      provenance := "new:" ++ call.target.member.symbol }
  have preparedFresh : ∀ frame ∈ prepared.frames, frame.id ≠ prepared.nextFrame := by
    simpa [prepared] using freshFrame
  have exact := bindCallArguments_transactionResult_entry_exact prepared function call
    receiverOperand
    error exception description errorValue exceptionValue descriptionValue parameters descriptors
    errorKind exceptionKind descriptionKind symbols preparedFresh
  simpa [localCallPreparation, allocateCell, receiver, prepared, receiverOperand, Nat.add_assoc] using exact

theorem localCall_constructor_binding_cells (before after : Machine) (caller callee : FrameId)
    (function : Function) (call : Call) (operands : List Operand)
    (fresh : ∀ cell ∈ before.cells, cell.id < before.nextCell)
    (bound : bindCallArguments (localCallPreparation before caller call operands true).1
      function call operands (localCallPreparation before caller call operands true).2 =
        .ok (after, callee)) :
    let prepared := localCallPreparation before caller call operands true
    let receiver : Cell :=
      { id := before.nextCell, frame := caller, symbol := call.target.member.symbol,
        provenance := "new:" ++ call.target.member.symbol,
        value := defaultValue call.target.member.declaringType, alias := none }
    ∃ count added,
      ParameterCellsAllocated prepared.1 after callee count ∧
      CallFrameEstablished prepared.1 after callee function prepared.2 ∧
      after.cells = added ++ receiver :: before.cells ∧ added.length = count ∧
      added.map (·.id) = (List.range count).reverse.map (before.nextCell + 1 + ·) ∧
      after.nextCell = before.nextCell + 1 + count ∧
      callee = before.nextFrame ∧ after.nextFrame = before.nextFrame + 1 ∧
      findCell? after before.nextCell = some receiver ∧
      ∀ cell ∈ after.cells, cell.id < after.nextCell := by
  let prepared := localCallPreparation before caller call operands true
  let receiver : Cell :=
    { id := before.nextCell, frame := caller, symbol := call.target.member.symbol,
      provenance := "new:" ++ call.target.member.symbol,
      value := defaultValue call.target.member.declaringType, alias := none }
  have preparedFresh : ∀ cell ∈ prepared.1.cells, cell.id < prepared.1.nextCell := by
    intro cell member
    change cell ∈ receiver :: before.cells at member
    change cell.id < before.nextCell + 1
    rcases List.mem_cons.mp member with rfl | member
    · exact Nat.lt_succ_self _
    · exact Nat.lt_trans (fresh cell member) (Nat.lt_succ_self _)
  obtain ⟨count, allocated⟩ := bindCallArguments_success_cellAllocation prepared.1 after
    function call operands prepared.2 callee bound
  have established := bindCallArguments_success_establishes prepared.1 after function call
    operands prepared.2 callee bound
  have receiverPresent : findCell? prepared.1 before.nextCell = some receiver := by
    simp [prepared, localCallPreparation, allocateCell, findCell?, receiver]
  have receiverPreserved := ParameterCellsAllocated.preserves_cell prepared.1 after callee count
    allocated preparedFresh before.nextCell receiver receiverPresent
  obtain ⟨added, cells, length, next, ids, bounds⟩ := allocated
  have calleeId : callee = before.nextFrame := established.2.1
  refine ⟨count, added, ⟨added, cells, length, next, ids, bounds⟩, established,
    cells, length, ids, next, calleeId, ?_, receiverPreserved, ?_⟩
  · simpa [calleeId] using established.2.2.1
  · intro cell member
    rw [cells] at member
    rcases List.mem_append.mp member with member | member
    · exact (bounds cell member).2.2
    · have oldBound := preparedFresh cell member
      have nextBound : prepared.1.nextCell ≤ after.nextCell := by
        rw [next]
        exact Nat.le_add_right _ _
      exact Nat.lt_of_lt_of_le oldBound nextBound

def LocalCallIndicesValid (function : Function) (call : Call) (operands : List Operand)
    (constructing : Bool) : Prop :=
  (constructing = true ∨ call.receiverChild < 0 ∨ call.receiverChild.toNat < operands.length) ∧
    ∀ argument ∈ call.arguments,
      argument.ordinal < function.signature.parameters.length ∧ argument.child < operands.length

private def applyCall
    (program : Program) (input : Input) (machine : Machine) (frameId : FrameId)
    (node : Node) (call : Call) (operands : List Operand) (constructing : Bool) : StepResult :=
  match call.target.kind with
  | .refund =>
      match refundOperands machine call operands with
      | .error reason => reject reason machine
      | .ok operands => .done { outcome := .suspended {
          operands := operands,
          requests := requests machine,
          remainingTape := machine.tape,
          remainingCSharpFuel := machine.csharpFuel }, remainingCSharpFuel := machine.csharpFuel }
  | .initialization =>
      match readArguments machine call operands >>= initResult with
      | .error reason => reject reason machine
      | .ok value => .next { machine with operands := .immediate value :: machine.operands }
  | .stateCharge =>
      match readArguments machine call operands >>= chargeResult with
      | .error reason => reject reason machine
      | .ok value => .next { machine with operands := .immediate value :: machine.operands }
  | .external =>
      match externalCall input machine frameId node call operands with
      | .error reason => rejectExternal reason machine
      | .ok (machine, operand) => .next { machine with operands := operand :: machine.operands }
  | .defaultValue =>
      let value := defaultValue call.target.member.typeName
      if constructing && node.mode != .value then
        let (machine, id) := allocateCell machine frameId call.target.member.symbol ("new:" ++ call.target.member.symbol) value
        .next { machine with operands := (.location {
          root := id,
          fields := [],
          readOnly := false,
          provenance := "new:" ++ call.target.member.symbol }) :: machine.operands }
      else .next { machine with operands := .immediate value :: machine.operands }
  | .staticField =>
      match machine.statics.find? (fun item => item.1 == call.target.member.symbol) with
      | some (_, id) =>
          let location : Location := { root := id, fields := [], readOnly := true, provenance := "static:" ++ call.target.member.symbol }
          if node.mode == .value then
            match readLocation machine location with
            | .ok value => .next { machine with operands := .immediate value :: machine.operands }
            | .error reason => reject reason machine
          else .next { machine with operands := .location location :: machine.operands }
      | none =>
          match findFunction? program call.target.body with
          | none => reject "missing static initializer" machine
          | some function =>
              match createFrame machine function (.immediate .unit) [] with
              | .error reason => reject reason machine
              | .ok (machine, callee) => .next { machine with work :=
                  (.enterBlock callee function.signature.symbol function.entryBlock) ::
                  (.resume frameId callee (.staticField node.mode call.target.member.symbol ("static:" ++ call.target.member.symbol))) :: machine.work }
  | .local =>
      match findFunction? program call.target.body with
      | none => reject "missing local function" machine
      | some function =>
          let receiver := if constructing then .immediate (defaultValue call.target.member.declaringType)
            else operand? operands call.receiverChild |>.getD (.immediate .unit)
          let result := do
            let (machine, receiver) ← if constructing then
                let (machine, id) := allocateCell machine frameId call.target.member.symbol ("new:" ++ call.target.member.symbol)
                  (defaultValue call.target.member.declaringType)
                pure (machine, Operand.location {
                  root := id,
                  fields := [],
                  readOnly := false,
                  provenance := "new:" ++ call.target.member.symbol })
              else pure (machine, receiver)
            let (machine, callee) ← bindCallArguments machine function call operands receiver
            pure (machine, receiver, callee)
          match result with
          | .error reason => reject reason machine
          | .ok (machine, receiver, callee) => .next { machine with work :=
              (.enterBlock callee function.signature.symbol function.entryBlock) ::
              (.resume frameId callee (.local constructing receiver node.mode)) :: machine.work }

theorem applyCall_static_cached_value_success (program : Program) (input : Input)
    (machine : Machine) (frameId : FrameId) (node : Node) (call : Call)
    (cell : CellId) (value : Value)
    (target : call.target.kind = .staticField)
    (cached : machine.statics.find? (fun item => item.1 == call.target.member.symbol) =
      some (call.target.member.symbol, cell))
    (mode : node.mode = .value)
    (readable : readLocation machine {
      root := cell, fields := [], readOnly := true,
      provenance := "static:" ++ call.target.member.symbol } = .ok value) :
    applyCall program input machine frameId node call [] false =
      .next { machine with operands := .immediate value :: machine.operands } := by
  simp [applyCall, target, cached, mode, readable]

theorem applyCall_static_cached_value_failure (program : Program) (input : Input)
    (machine : Machine) (frameId : FrameId) (node : Node) (call : Call)
    (cell : CellId) (reason : String)
    (target : call.target.kind = .staticField)
    (cached : machine.statics.find? (fun item => item.1 == call.target.member.symbol) =
      some (call.target.member.symbol, cell))
    (mode : node.mode = .value)
    (unreadable : readLocation machine {
      root := cell, fields := [], readOnly := true,
      provenance := "static:" ++ call.target.member.symbol } = .error reason) :
    applyCall program input machine frameId node call [] false = reject reason machine := by
  simp [applyCall, target, cached, mode, unreadable]

private def applyNode
    (program : Program) (input : Input) (machine : Machine) (frameId : FrameId)
    (node : Node) (children : List Operand) : StepResult :=
  let immediate (machine : Machine) (value : Value) := StepResult.next { machine with operands := .immediate value :: machine.operands }
  let push (machine : Machine) (operand : Operand) := StepResult.next { machine with operands := operand :: machine.operands }
  match node.kind with
  | .expressionStatement | .parenthesized | .argument | .declarationExpression | .conversion =>
      match children with
      | [operand] =>
          if node.kind == .conversion then
            match node.call with
            | some call => applyCall program input machine frameId node call [operand] false
            | none => match readOperand machine operand >>= conversionValue node.typeName with
              | .ok value => if node.mode == .value then immediate machine value else push machine operand
              | .error reason => reject reason machine
          else if node.kind == .argument || node.kind == .declarationExpression || node.mode != .value then push machine operand
          else match readOperand machine operand with | .ok value => immediate machine value | .error reason => reject reason machine
      | _ => reject "transparent arity changed" machine
  | .returnValue => reject "unsupported return operation" machine
  | .assignment =>
      match children with
      | [target, source] =>
          if node.binding.isRef then
            let result : Except String Machine := match target, source with
              | .location target, .location source => do
                  if !target.fields.isEmpty then throw "ref assignment target is a field"
                  let cell ← findCell? machine target.root |>.toExcept "missing ref target cell"
                  pure (replaceCell machine { cell with alias := some source })
              | _, _ => throw "ref assignment requires two locations"
            match result with
            | .error reason => reject reason machine
            | .ok updated => push updated source
          else
            match readOperand machine source with
            | .error reason => reject reason machine
            | .ok value =>
                match writeOperand machine target value with
                | .error reason => reject reason machine
                | .ok updated =>
                    match readOperand updated source with
                    | .error reason => reject reason updated
                    | .ok result => immediate updated result
      | _ => reject "assignment arity changed" machine
  | .invocation | .objectCreation =>
      match node.call with
      | none => reject "call metadata missing" machine
      | some call => applyCall program input machine frameId node call children (node.kind == .objectCreation)
  | .collection => if children.isEmpty then immediate machine (.struct node.typeName []) else reject "nonempty collection" machine
  | .field | .property =>
      match node.call with
      | none => reject "member metadata missing" machine
      | some call =>
          if call.target.kind == .staticField then applyCall program input machine frameId node call [] false
          else
            let receiver := children.head?.getD (.immediate .unit)
            if call.target.kind == .local then applyCall program input machine frameId node call [receiver] false
            else match projection input machine frameId node call receiver with
              | .error reason => reject reason machine
              | .ok (machine, operand) => push machine operand
  | .local | .parameter =>
      match findFrame? machine frameId with
      | none => reject "binding frame missing" machine
      | some frame =>
          match frame.cells.find? (fun item => item.1 == node.symbol) with
          | some (_, cell) =>
              let location : Location := { root := cell, fields := [], readOnly := node.mode == .readOnlyLocation, provenance := node.symbol }
              if node.mode == .value then match readLocation machine location with
                | .ok value => immediate machine value | .error reason => reject reason machine
              else push machine (.location location)
          | none =>
              if node.mode == .value && node.operator != "declaration=True" then reject "uninitialized binding" machine
              else match allocateBinding machine frameId node.symbol node.symbol (defaultValue node.typeName) with
                | .error reason => reject reason machine
                | .ok (machine, location) => if node.mode == .value then immediate machine (defaultValue node.typeName) else push machine (.location location)
  | .instance =>
      if node.operator == "ContainingTypeInstance" then
        match findFrame? machine frameId with
        | none => reject "instance frame missing" machine
        | some frame => if node.mode == .value then match readOperand machine frame.thisOperand with
            | .ok value => immediate machine value | .error reason => reject reason machine
          else push machine frame.thisOperand
      else reject "unsupported instance reference" machine
  | .literal | .defaultValue => immediate machine (literalValue node.typeName node.literal)
  | .binary =>
      match node.call with | some call => applyCall program input machine frameId node call children false | none => reject "binary call metadata missing" machine
  | .unary =>
      match children with
      | [operand] => match readOperand machine operand >>= asBool with
        | .ok value => immediate machine (.boolean (!value)) | .error reason => reject reason machine
      | _ => reject "unary arity changed" machine
  | .isPattern | .constantPattern | .negatedPattern => reject "pattern wrapper reached generic apply" machine
  | .isNull => match children with
      | [operand] => match readOperand machine operand with
        | .ok (.null _) => immediate machine (.boolean true) | .ok _ => immediate machine (.boolean false) | .error reason => reject reason machine
      | _ => reject "null-test arity" machine
  | .capture =>
      match children with
      | [operand] =>
          match findFunction? program (findFrame? machine frameId |>.map (·.functionSymbol) |>.getD "") with
          | none => reject "capture function missing" machine
          | some function =>
              let mode := function.captureModes.find? (fun item => item.1 == node.binding.capture) |>.map (·.2) |>.getD .value
              let result := if mode == .value then readOperand machine operand |>.map Operand.immediate else pure operand
              match result >>= setCapture machine frameId node.binding.capture with
              | .error reason => reject reason machine
              | .ok machine => push machine operand
      | _ => reject "capture arity" machine
  | .captureReference =>
      match findFrame? machine frameId >>= fun frame => frame.captures.find? (fun item => item.1 == node.binding.capture) with
      | none => reject "capture read before write" machine
      | some (_, operand) => push machine operand
  | .discard =>
      let (machine, id) := allocateCell machine frameId "discard" ("discard:" ++ node.typeName) (.null node.typeName)
      push machine (.location { root := id, fields := [], readOnly := false, provenance := "discard:" ++ node.typeName })

theorem applyNode_ref_assignment_does_not_read_source (program : Program) (input : Input)
    (machine : Machine) (frameId : FrameId) (node : Node) (target source : Location) (cell : Cell)
    (assignment : node.kind = .assignment) (isRef : node.binding.isRef = true)
    (rootTarget : target.fields = []) (present : findCell? machine target.root = some cell) :
    applyNode program input machine frameId node [.location target, .location source] =
      StepResult.next { replaceCell machine { cell with alias := some source } with
        operands := .location source :: machine.operands } := by
  simp [applyNode, assignment, isRef, rootTarget, present, Option.toExcept, pure, Except.pure,
    bind, Except.bind, replaceCell]

theorem applyNode_value_assignment_rereads_source (program : Program) (input : Input)
    (machine updated : Machine) (frameId : FrameId) (node : Node) (target source : Operand)
    (first result : Value) (assignment : node.kind = .assignment)
    (notRef : node.binding.isRef = false) (firstRead : readOperand machine source = .ok first)
    (written : writeOperand machine target first = .ok updated)
    (secondRead : readOperand updated source = .ok result) :
    applyNode program input machine frameId node [target, source] =
      StepResult.next { updated with operands := .immediate result :: updated.operands } := by
  simp [applyNode, assignment, notRef, firstRead, written, secondRead]

private def finishEdge (block : Block) (carried : Value) : Except String (Option Edge) :=
  if block.condition == .none then .ok block.fallThrough
  else match asBool carried with
    | .error reason => .error reason
    | .ok condition =>
        let takeConditional := (block.condition == ConditionKind.whenTrue && condition) ||
          (block.condition == ConditionKind.whenFalse && !condition)
        .ok (if takeConditional && block.conditional.isSome then block.conditional else block.fallThrough)

def step (program : Program) (input : Input) (machine : Machine) : StepResult :=
  match machine.work with
  | [] => reject "work stack exhausted" machine
  | task :: rest =>
      let machine := { machine with work := rest }
      match task with
      | .eval frame node =>
          match tick machine with
          | .error outcome => .done { outcome, remainingCSharpFuel := machine.csharpFuel }
          | .ok machine =>
              if !nodeTagsValid node then reject "node primitive binding changed" machine
              else if node.kind == .isPattern then
                match node.children with
                | [inputNode, pattern] =>
                    match patternLeaf? pattern with
                    | .error reason => reject reason machine
                    | .ok (constant, negated) => .next { machine with work :=
                        (.eval frame inputNode) :: (.startPattern frame constant negated) :: machine.work }
                | _ => reject "pattern arity changed" machine
              else .next { machine with work := node.children.map (Task.eval frame) ++ [.apply frame node node.children.length] ++ machine.work }
      | .apply frame node count =>
          match popOperands count machine.operands with
          | none => reject "operand stack underflow" machine
          | some (children, tail) => applyNode program input { machine with operands := tail } frame node children
      | .enterBlock frameId functionSymbol ordinal =>
          match tick machine with
          | .error outcome => .done { outcome, remainingCSharpFuel := machine.csharpFuel }
          | .ok machine =>
              match findFunction? program functionSymbol, findFrame? machine frameId with
              | some function, some frame =>
                  match findBlock? function ordinal with
                  | none => reject s!"missing CFG block {ordinal}" machine
                  | some block =>
                      if block.exit == .outside then .done {
                        outcome := .outside (requests machine) machine.tape
                        remainingCSharpFuel := machine.csharpFuel }
                      else
                        let machine := replaceFrame machine { frame with carried := frame.carried }
                        let evaluations := block.operations.flatMap (fun node => [.eval frameId node, .setLast frameId]) ++
                          (match block.branchValue with | none => [] | some node => [.eval frameId node, .setLast frameId])
                        .next { machine with work := evaluations ++ [.finishBlock frameId functionSymbol block] ++ machine.work }
              | _, _ => reject "function or frame missing" machine
      | .setLast frameId =>
          match machine.operands with
          | [] => reject "missing block result" machine
          | operand :: tail => match readOperand machine operand >>= setFrameCarried { machine with operands := tail } frameId with
            | .error reason => reject reason machine
            | .ok machine => .next machine
      | .finishBlock frameId functionSymbol block =>
          match findFrame? machine frameId with
          | none => reject "finish frame missing" machine
          | some frame =>
              if block.exit == .returnValue then scheduleReturn machine frame.carried
              else if block.exit == .suspend then reject "missing suspension" machine
              else
                match finishEdge block frame.carried with
                | .error reason => reject reason machine
                | .ok none => reject "missing CFG edge" machine
                | .ok (some edge) =>
                    if edge.destination < 0 then
                      if edge.semantics == "Return" then scheduleReturn machine frame.carried else reject "invalid CFG edge" machine
                    else .next { machine with work := (.enterBlock frameId functionSymbol edge.destination) :: machine.work }
      | .startPattern frame constant negated =>
          match machine.operands with
          | [] => reject "missing pattern input" machine
          | operand :: tail =>
              match readOperand machine operand with
              | .error reason => reject reason machine
              | .ok value =>
                  let machine := { machine with operands := tail }
                  .next { machine with work := (Task.eval frame constant) :: (Task.finishPattern value negated) :: machine.work }
      | .finishPattern inputValue negated =>
          match machine.operands with
          | [] => reject "missing pattern constant" machine
          | operand :: tail =>
              match readOperand machine operand with
              | .error reason => reject reason machine
              | .ok constant =>
                  let matched := valueEq inputValue constant
                  .next { machine with operands := .immediate (.boolean (if negated then !matched else matched)) :: tail }
      | .resume _caller _callee kind =>
          match machine.returned with
          | none => reject "local call returned no value" machine
          | some returned =>
              let machine := { machine with returned := none }
              match kind with
              | .local constructing receiver mode =>
                  if constructing then
                    if mode == .value then match readOperand machine receiver with
                      | .error reason => reject reason machine
                      | .ok value => .next { machine with operands := .immediate value :: machine.operands }
                    else .next { machine with operands := receiver :: machine.operands }
                  else .next { machine with operands := .immediate returned :: machine.operands }
              | .staticField mode symbol provenance =>
                  let (machine, id) := allocateCell machine 0 symbol provenance returned
                  let machine := { machine with statics := (symbol, id) :: machine.statics }
                  let location : Location := { root := id, fields := [], readOnly := true, provenance }
                  if mode == .value then .next { machine with operands := .immediate returned :: machine.operands }
                  else .next { machine with operands := .location location :: machine.operands }

def steps (program : Program) (input : Input) : Nat → Machine → StepResult
  | 0, machine => .next machine
  | count + 1, machine =>
      match step program input machine with
      | .next machine => steps program input count machine
      | .done execution => .done execution

theorem staticField_resume_value_step (program : Program) (input : Input)
    (before : Machine) (caller callee : FrameId) (symbol provenance : String)
    (tail : List Task) (value : Value) :
    step program input { before with
      work := Task.resume caller callee (.staticField .value symbol provenance) :: tail
      returned := some value } =
    .next { before with
      work := tail
      operands := .immediate value :: before.operands
      cells := { id := before.nextCell, frame := 0, symbol, provenance, value, alias := none } ::
        before.cells
      statics := (symbol, before.nextCell) :: before.statics
      returned := none
      nextCell := before.nextCell + 1 } := by
  rfl

theorem steps_add (program : Program) (input : Input) (first second : Nat)
    (machine : Machine) :
    steps program input (first + second) machine =
      match steps program input first machine with
      | .next after => steps program input second after
      | .done execution => .done execution := by
  induction first generalizing machine with
  | zero => simp only [Nat.zero_add, steps]
  | succ first induction =>
      simp only [Nat.succ_add, steps]
      cases result : step program input machine with
      | next after => exact induction after
      | done execution => rfl

theorem steps_next (program : Program) (input : Input) (count : Nat)
    (machine beforeLast after : Machine)
    (prefixResult : steps program input count machine = .next beforeLast)
    (last : step program input beforeLast = .next after) :
    steps program input (count + 1) machine = .next after := by
  rw [steps_add, prefixResult]
  simp only [steps, last]

private theorem popOperands_reverse_append (children tail : List Operand) :
    popOperands children.length (children.reverse ++ tail) = some (children, tail) := by
  unfold popOperands
  have lengthEq : children.length = children.reverse.length := (List.length_reverse (as := children)).symm
  rw [lengthEq, List.take_left, List.drop_left]
  simp

private theorem applyCall_local_success (program : Program) (input : Input) (before after : Machine)
    (caller callee : FrameId) (function : Function) (node : Node) (call : Call)
    (children : List Operand) (constructing : Bool)
    (localTarget : call.target.kind = .local)
    (found : findFunction? program call.target.body = some function)
    (bound : bindCallArguments (localCallPreparation before caller call children constructing).1
      function call children (localCallPreparation before caller call children constructing).2 =
        .ok (after, callee)) :
    applyCall program input before caller node call children constructing =
      .next { after with
        work := Task.enterBlock callee function.signature.symbol function.entryBlock ::
          Task.resume caller callee (.local constructing
            (localCallPreparation before caller call children constructing).2 node.mode) :: after.work } := by
  cases constructing <;>
    simp only [localCallPreparation, Bool.false_eq_true, if_false, if_true] at bound ⊢
  all_goals simp [applyCall, localTarget, found, bound] <;> rfl

theorem localCall_apply_success_step (program : Program) (input : Input) (machine after : Machine)
    (caller callee : FrameId) (function : Function) (node : Node) (call : Call)
    (children operandTail : List Operand) (tail : List Task)
    (kind : node.kind = .invocation ∨ node.kind = .objectCreation)
    (metadata : node.call = some call) (localTarget : call.target.kind = .local)
    (found : findFunction? program call.target.body = some function)
    (arity : children.length = node.children.length)
    (_indices : LocalCallIndicesValid function call children (node.kind == .objectCreation))
    (bound : bindCallArguments
      (localCallPreparation { machine with work := tail, operands := operandTail }
        caller call children (node.kind == .objectCreation)).1 function call children
      (localCallPreparation { machine with work := tail, operands := operandTail }
        caller call children (node.kind == .objectCreation)).2 = .ok (after, callee)) :
    let before := { machine with work := tail, operands := operandTail }
    let prepared := localCallPreparation before caller call children (node.kind == .objectCreation)
    CallContextPreserved before after ∧
      CallFrameEstablished prepared.1 after callee function prepared.2 ∧
      step program input { machine with
        work := Task.apply caller node node.children.length :: tail
        operands := children.reverse ++ operandTail } =
        .next { after with
          work := Task.enterBlock callee function.signature.symbol function.entryBlock ::
            Task.resume caller callee (.local (node.kind == .objectCreation) prepared.2 node.mode) :: tail } := by
  dsimp only
  have established := bindCallArguments_success_establishes _ after function call children _ callee bound
  have prepared := (localCallPreparation_preserves
    { machine with work := tail, operands := operandTail } caller call children
    (node.kind == .objectCreation)).1
  have context := prepared.trans _ _ _ established.1
  refine ⟨context, established, ?_⟩
  have applied := applyCall_local_success program input _ after caller callee function node call children
    (node.kind == .objectCreation) localTarget found bound
  rw [context.1] at applied
  simp only [step, ← arity, popOperands_reverse_append]
  rcases kind with kind | kind <;> simpa [applyNode, kind, metadata] using applied

