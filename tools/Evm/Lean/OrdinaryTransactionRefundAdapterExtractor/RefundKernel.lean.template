  { transactionGasLimit := {{settlement.0}}, preRefundGas := {{settlement.1}},
    refundCounter := {{settlement.2}}, destroyCount := {{settlement.3}}, destroyRefund := {{settlement.4}},
    codeInsertExecutionRefund := {{settlement.5}}, calldataFloorGas := {{settlement.6}},
    stateGasUsed := {{settlement.7}}, refundQuotient := {{settlement.8}},
    isError := {{settlement.9}}, shouldRevert := {{settlement.10}},
