inductive ValueResult where
  | word (value : UInt256)
  | stackUnderflow
  | badInstruction
  deriving DecidableEq, Repr

def lookupBlockHash : Nat → List (Nat × UInt256) → Option UInt256
  | _, [] => none
  | number, (candidate, hash) :: tail =>
    if number = candidate then some hash else lookupBlockHash number tail

def blockHash (context : Context) (query : UInt256) : UInt256 :=
  if query.val < 2 ^ 64 ∧ query.val < context.number ∧ context.number ≤ query.val + 256 then
    (lookupBlockHash query.val context.blockHashes).getD Word.zero
  else Word.zero

def blobHash (context : Context) (query : UInt256) : UInt256 :=
  context.blobVersionedHashes[query.val]?.getD Word.zero

def value (context : Context) : Opcode → Option UInt256 → ValueResult
  | .address, _argument => .word context.executingAccount
  | .origin, _argument => .word context.origin
  | .caller, _argument => .word context.caller
  | .callvalue, _argument => .word context.callValue
  | .calldatasize, _argument => .word (Word.ofNat context.calldataSize)
  | .codesize, _argument => .word (Word.ofNat context.codeSize)
  | .gasprice, _argument => .word context.gasPrice
  | .returndatasize, _argument => .word (Word.ofNat context.returnDataSize)
  | .blockhash, argument => match argument with | some query => .word (blockHash context query) | none => .stackUnderflow
  | .coinbase, _argument => .word context.coinbase
  | .timestamp, _argument => .word (Word.ofNat context.timestamp)
  | .number, _argument => .word (Word.ofNat context.number)
  | .prevrandao, _argument => .word context.prevRandao
  | .gaslimit, _argument => .word (Word.ofNat context.gasLimit)
  | .chainid, _argument => .word context.chainId
  | .selfbalance, _argument => .word context.selfBalance
  | .basefee, _argument => .word context.baseFee
  | .blobhash, argument => match argument with | some query => .word (blobHash context query) | none => .stackUnderflow
  | .blobbasefee, _argument => match context.excessBlobGas with | some _ => .word context.blobBaseFee | none => .badInstruction
  | .slotnum, _argument => match context.slotNumber with | some slot => .word (Word.ofNat slot) | none => .badInstruction

def contextAvailable (context : Context) : Opcode → Bool
  | .address => true
  | .origin => true
  | .caller => true
  | .callvalue => true
  | .calldatasize => true
  | .codesize => true
  | .gasprice => true
  | .returndatasize => true
  | .blockhash => true
  | .coinbase => true
  | .timestamp => true
  | .number => true
  | .prevrandao => true
  | .gaslimit => true
  | .chainid => true
  | .selfbalance => true
  | .basefee => true
  | .blobhash => true
  | .blobbasefee => context.excessBlobGas.isSome
  | .slotnum => context.slotNumber.isSome

structure State where
  gasLeft : Nat
  pc : Nat
  stack : Stack
  deriving Repr

inductive Status where
  | ok | outOfGas | stackUnderflow | stackOverflow | badInstruction
  deriving DecidableEq, Repr

structure Outcome where
  status : Status
  state : State
  deriving Repr

def withGas (state : State) (gas : Nat) : State := { state with gasLeft := gas }
def advancePc (state : State) : State := { state with pc := state.pc + 1 }

def applyValue (state : State) : ValueResult → Outcome
  | .stackUnderflow => { status := .stackUnderflow, state }
  | .badInstruction => { status := .badInstruction, state }
  | .word word =>
    match state.stack.push word with
    | some stack => { status := .ok, state := { state with stack } }
    | none => { status := .stackOverflow, state }

def executePaid (context : Context) (opcode : Opcode) (state : State) : Outcome :=
  if semanticPops opcode = 1 then
    match state.stack.pop with
    | none => { status := .stackUnderflow, state }
    | some (argument, stack) => applyValue { state with stack } (value context opcode (some argument))
  else applyValue state (value context opcode none)

def execute (context : Context) (opcode : Opcode) (state : State) : Outcome :=
  let advanced := advancePc state
  if !contextAvailable context opcode then
    { status := .badInstruction, state := advanced }
  else if fixedGas opcode ≤ advanced.gasLeft then
    executePaid context opcode (withGas advanced (advanced.gasLeft - fixedGas opcode))
  else
    { status := .outOfGas, state := withGas advanced 0 }

def executeAmsterdam (table : DispatchTable) (context : Context) (opcode : Opcode)
    (state : State) : Outcome :=
  match table with
  | .noTrace => execute context opcode state
  | .noTraceCancelable => execute context opcode state
  | .traced => execute context opcode state
  | .tracedCancelable => execute context opcode state

