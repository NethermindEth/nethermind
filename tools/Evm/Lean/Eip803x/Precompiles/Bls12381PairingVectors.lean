def compactionProbeOracle : PairingOracle :=
  { knownAnswerOracle with
    millerLoopProduct := fun active => if active.contains rawInfinityPair then 0 else 1 }

def runWithoutCompaction (oracle : PairingOracle) (pairs : List Pair) : Result :=
  if pairs.all (fun pair => validPair oracle pair) then
    .ok (encodedBoolean (oracle.finalExponentiationIsOne (oracle.millerLoopProduct pairs)))
  else .error .invalidPoint

example : resultEq (runWithoutCompaction compactionProbeOracle [rawInfinityPair])
    (run compactionProbeOracle (inputFor [rawInfinityPair])) = false := by native_decide
example : resultEq (runPairs knownAnswerOracle (compactRaw [g1SubgroupInfinityPair]))
    (run knownAnswerOracle (inputFor [g1SubgroupInfinityPair])) = false := by native_decide

def allInfinityReturnsFalse (oracle : PairingOracle) (pairs : List Pair) : Result :=
  match collectActivePairs oracle pairs with
  | none => .error .invalidPoint
  | some [] => .ok (encodedBoolean false)
  | some active => .ok (encodedBoolean (oracle.finalExponentiationIsOne (oracle.millerLoopProduct active)))

example : resultEq (allInfinityReturnsFalse knownAnswerOracle threeInfinityPairs)
    (run knownAnswerOracle (inputFor threeInfinityPairs)) = false := by native_decide

