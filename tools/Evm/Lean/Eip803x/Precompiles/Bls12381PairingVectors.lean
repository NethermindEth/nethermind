def rawInfinityPair : Pair := ⟨g1Infinity, g2Infinity⟩

def encodePair (pair : Pair) : List Byte := pair.g1.bytes ++ pair.g2.bytes
def inputFor (pairs : List Pair) : List Byte := pairs.flatMap encodePair

def decodedPairs (input : List Byte) : List Pair :=
  match decodeInput? input with
  | some pairs => pairs
  | none => []

def firstPair (input : List Byte) : Pair :=
  match decodedPairs input with
  | pair :: _ => pair
  | [] => rawInfinityPair

def compactRaw (pairs : List Pair) : List Pair :=
  pairs.filter (fun pair => !pairHasInfinity pair)

def finitePair : Pair := firstPair (successInput 7)
def invalidG1Top : G1Point := (firstPair (failureInput 3)).g1
def invalidG1Field : G1Point := (firstPair (failureInput 4)).g1
def invalidG1Curve : G1Point := (firstPair (failureInput 5)).g1
def invalidG1Subgroup : G1Point := (firstPair (failureInput 7)).g1
def invalidG2Curve : G2Point := (firstPair (failureInput 6)).g2
def invalidG2Subgroup : G2Point := (firstPair (failureInput 8)).g2
def invalidG2Top : G2Point :=
  ⟨byte 0x10 :: finitePair.g2.bytes.drop 1, by native_decide⟩

def g1FieldFailures : List G1Point := [invalidG1Top, invalidG1Field]
def g1CurveFailures : List G1Point := [invalidG1Curve]
def g1SubgroupFailures : List G1Point := [invalidG1Subgroup]
def g2FieldFailures : List G2Point := [invalidG2Top]
def g2CurveFailures : List G2Point := [invalidG2Curve]
def g2SubgroupFailures : List G2Point := [invalidG2Subgroup]

def falseFixtureIndices : List Nat := [4, 5, 7, 14]
def falseActivePatterns : List (List Pair) :=
  falseFixtureIndices.map (fun index => compactRaw (decodedPairs (successInput index)))

/-- These placeholders make native boundaries explicit without claiming equivalence. -/
def unsupportedNative : List Byte → Result := fun _ => .error .invalidInputLength

def knownAnswerOracle : PairingOracle :=
  { validG1Field := fun point => !(g1FieldFailures.contains point)
    validG1Curve := fun point => !(g1CurveFailures.contains point)
    validG1Subgroup := fun point => !(g1SubgroupFailures.contains point)
    validG2Field := fun point => !(g2FieldFailures.contains point)
    validG2Curve := fun point => !(g2CurveFailures.contains point)
    validG2Subgroup := fun point => !(g2SubgroupFailures.contains point)
    millerLoopProduct := fun active => if falseActivePatterns.contains active then 0 else 1
    finalExponentiationIsOne := fun value => value == 1
    nativeStandard := unsupportedNative
    nativeZkEvm := unsupportedNative }

def g1SubgroupInfinityPair : Pair := ⟨invalidG1Subgroup, g2Infinity⟩
def g2SubgroupInfinityPair : Pair := ⟨g1Infinity, invalidG2Subgroup⟩
def g2TopPair : Pair := ⟨finitePair.g1, invalidG2Top⟩
def threeInfinityPairs : List Pair := [rawInfinityPair, rawInfinityPair, rawInfinityPair]
def finiteWithInfinity : List Pair := [finitePair, rawInfinityPair]
def finiteThenG1SubgroupInfinity : List Pair := [finitePair, g1SubgroupInfinityPair]
def finiteThenG2SubgroupInfinity : List Pair := [finitePair, g2SubgroupInfinityPair]

def resultEq : Result → Result → Bool
  | .error left, .error right => left == right
  | .ok left, .ok right => left == right
  | _, _ => false

structure Vector where
  name : String
  input : List Byte
  expected : Result
  oracle : Result
  expectedGas : Nat

def runMatchesOracle (vector : Vector) : Bool :=
  resultEq (run knownAnswerOracle vector.input) vector.oracle

def oracleMatchesExpected (vector : Vector) : Bool :=
  resultEq vector.oracle vector.expected

def passes (vector : Vector) : Bool :=
  runMatchesOracle vector && oracleMatchesExpected vector &&
    totalGasCost vector.input == vector.expectedGas

