theorem focused_boolean_oracle_results :
    resultEq (run knownAnswerOracle (inputFor threeInfinityPairs)) (.ok oracleTrue) = true ∧
    resultEq (.ok oracleTrue) (.ok expectedTrue) = true ∧
    resultEq (run knownAnswerOracle (inputFor finiteWithInfinity)) (.ok oracleFalse) = true ∧
    resultEq (.ok oracleFalse) (.ok expectedFalse) = true := by native_decide

theorem source_framing_is_exact :
