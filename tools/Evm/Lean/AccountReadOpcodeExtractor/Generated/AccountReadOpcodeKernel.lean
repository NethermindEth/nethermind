def addressOfWord (word : UInt256) : UInt256 := Word.ofNat (word.val % (2 ^ 160))
def enter (state : State) : State := { state with pc := state.pc + 1, opcodeCount := state.opcodeCount + 1 }
def exhaust (state : State) : State := { state with gas := { state.gas with gasLeft := 0 } }
def charge (amount : Nat) (state : State) : Except Outcome State :=
