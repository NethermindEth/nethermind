        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "opcodePackage" }, "name": { "const": "AccountReadOpcodeExtractor" } } }] },
        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "opcodePackage" }, "name": { "const": "MemoryCopyOpcodeExtractor" } } }] },
        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "opcodePackage" }, "name": { "const": "PersistentStorageOpcodeExtractor" } } }] },
