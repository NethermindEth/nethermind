  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "roslynSyntaxSha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "roslynSyntaxSha256": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "admissionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "namespace",
        "ownerPath",
        "memberKind",
        "memberName",
        "memberGenericArity",
        "parameterTypes",
        "syntaxKind",
        "sha256"
      ],
      "properties": {
        "sourcePath": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "ownerPath": { "type": "string", "minLength": 1 },
        "memberKind": { "type": "string", "minLength": 1 },
        "memberName": { "type": "string", "minLength": 1 },
        "memberGenericArity": { "type": "integer", "minimum": 0 },
        "parameterTypes": { "type": "string" },
        "syntaxKind": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dependencyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "path",
        "sha256",
        "proofModule",
        "proofModulePath",
        "proofModuleSha256",
        "requiredTheorems",
        "admitted"
      ],
      "properties": {
        "kind": { "enum": ["opcodePackage", "precompileWrapper"] },
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "proofModule": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "proofModulePath": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "proofModuleSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "requiredTheorems": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/proofTheoremIdentity" }
        },
        "admitted": { "type": "boolean" }
      }
    },
    "proofTheoremIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullyQualifiedName", "signatureSha256"],
      "properties": {
        "fullyQualifiedName": { "type": "string", "minLength": 1 },
        "signatureSha256": { "$ref": "#/$defs/sha256" }
      }
    }
