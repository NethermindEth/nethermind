        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "precompileWrapper" }, "name": { "const": "SHA256" } } }] },
        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "precompileWrapper" }, "name": { "const": "RIPEMD160" } } }] },
        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "precompileWrapper" }, "name": { "const": "IDENTITY" } } }] },
        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "precompileWrapper" }, "name": { "const": "MODEXP" } } }] },
