        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "opcodePackage" }, "name": { "const": "ControlFlowOpcodeExtractor" } } }] },
        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "opcodePackage" }, "name": { "const": "ExtendedStackOpcodeExtractor" } } }] },
        { "allOf": [{ "$ref": "#/$defs/dependencyIdentity" }, { "properties": { "kind": { "const": "opcodePackage" }, "name": { "const": "CallDataLoadOpcodeExtractor" } } }] },
