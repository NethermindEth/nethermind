    <ProjectReference Include="..\..\..\src\Nethermind\Nethermind.State\Nethermind.State.csproj" />
    <ProjectReference Include="..\..\..\src\Nethermind\Nethermind.Specs\Nethermind.Specs.csproj" />
    <ProjectReference Include="..\..\..\src\Nethermind\Nethermind.Blockchain\Nethermind.Blockchain.csproj" />
  </ItemGroup>

</Project>
