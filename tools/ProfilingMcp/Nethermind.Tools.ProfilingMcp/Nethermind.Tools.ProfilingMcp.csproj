<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Restores the runtime packs for the Linux builds that PublishLinuxBuildsForContainers publishes. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nethermind.Tools.ProfilingMcp.Test" />
  </ItemGroup>

  <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('linux'))">
    <None Include="sidecar.Dockerfile" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Container mode (ContainerSidecar) runs a Linux build for the engine's architecture in a sidecar container, so a publish that is not one includes both. -->
  <ItemGroup>
    <ContainerRuntimeIdentifier Include="linux-x64;linux-arm64" />
  </ItemGroup>

  <Target Name="PublishLinuxBuildsForContainers" AfterTargets="Publish" Condition="!$(RuntimeIdentifier.StartsWith('linux'))">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish" Properties="RuntimeIdentifier=%(ContainerRuntimeIdentifier.Identity);SelfContained=true;Configuration=$(Configuration);PublishDir=$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))%(ContainerRuntimeIdentifier.Identity)/" />
  </Target>

</Project>
