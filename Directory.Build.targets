<Project>

  <!-- Disable R2R for test projects - they don't need it and composite R2R is slow -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('Test'))">
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishReadyToRun)' == 'true'">
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <OptimizationPreference>Speed</OptimizationPreference>
    <NethermindPgoProfile>$(MSBuildThisFileDirectory)src/Nethermind/Nethermind.Runner/pgo/nethermind.mibc</NethermindPgoProfile>
    <!-- Inline framework methods (Dictionary, Span, Memory, etc.) into Nethermind R2R code.
         Safe because Docker images pin the framework version via base image hash.
         The * wildcard enables inlining from all referenced modules. -->
    <!-- Split methods into hot/cold sections using SPGO block counts from .mibc.
         Cold basic blocks (error paths, rare branches) go to .text.cold section,
         keeping the hot working set smaller and improving I-cache density. -->
    <!-- PettisHansen method layout from CallWeights in the .mibc. The richer
         --callchain-profile:nethermind.callchain.json + --method-layout:callfrequency pair crashes
         crossgen2 (TypeLoadException in CallChainProfile.ResolveMethodName on truncated method-name
         entries) — do not re-enable until the profile is regenerated with fixed name formatting. -->
    <!-- Match file layout to method ordering so hot methods are on adjacent pages on disk. -->
    <!-- The SDK forwards $(PublishReadyToRunCrossgen2ExtraArgs) to crossgen2; the task-internal
         Crossgen2ExtraCommandLineArgs name is not user-settable. -->
    <PublishReadyToRunCrossgen2ExtraArgs>$(PublishReadyToRunCrossgen2ExtraArgs);--opt-cross-module:*;--hot-cold-splitting;--file-layout:methodorder;--method-layout:pettishansen</PublishReadyToRunCrossgen2ExtraArgs>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishReadyToRun)' == 'true' and Exists('$(NethermindPgoProfile)')">
    <PublishReadyToRunPgoFiles Include="$(NethermindPgoProfile)" />
  </ItemGroup>

</Project>
