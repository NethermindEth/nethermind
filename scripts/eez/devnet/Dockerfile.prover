ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG PROFILE
ENV EEZ_CI_PROFILE=${PROFILE}
ARG STREAMING_WIRE
ENV EEZ_STREAMING_WIRE=${STREAMING_WIRE}
ARG SKIP_CONSENSUS_LAYER_CALLS
ENV EEZ_SKIP_CONSENSUS_LAYER_CALLS=${SKIP_CONSENSUS_LAYER_CALLS}
ENV EEZ_CI_STREAMING=true
USER root
RUN sed -i 's|URIs: http://|URIs: https://|' /etc/apt/sources.list.d/ubuntu.sources && \
    apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=20 update && \
    apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=20 install -y --no-install-recommends haproxy openssl jq && \
    rm -rf /var/lib/apt/lists/*
COPY --chmod=0555 start-streaming.sh /attester/start-streaming.sh
COPY --chmod=0555 start-prover.sh /attester/eez-proof-signer
RUN mkdir -p /data && chown app:app /data
ENV PATH="/attester:${PATH}"
USER app
ENTRYPOINT ["/attester/eez-proof-signer"]
