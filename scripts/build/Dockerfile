FROM mcr.microsoft.com/dotnet/sdk:11.0.100-rc.2-resolute@sha256:a607f30172eaf61248b0847e5f99f65d6cfd1cbddbee60afe5e2c4f0e3cd5ac3

ARG COMMIT_HASH
ARG SOURCE_DATE_EPOCH

ENV CI=true

WORKDIR /nethermind

COPY src/Nethermind src/Nethermind
COPY Directory.*.props .
COPY Directory.Build.targets .
COPY global.json .
COPY nuget.config .
COPY --chmod=0755 scripts/build/build.sh .

RUN ./build.sh $COMMIT_HASH

VOLUME /output

CMD ["cp", "-r", "output/.", "/output"]
