FROM mcr.microsoft.com/dotnet/sdk:10.0.401-resolute@sha256:0b6fba3f50b4800082d4b1f07bc8d938c9a140c4ecb00238eb1b47aeaa8d502d

ARG COMMIT_HASH
ARG SOURCE_DATE_EPOCH

ENV CI=true

WORKDIR /nethermind

COPY src/Nethermind src/Nethermind
COPY Directory.*.props .
COPY Directory.Build.targets .
COPY global.json .
COPY nuget.config .
COPY --chmod=0755 scripts/build/build.sh .

RUN ./build.sh $COMMIT_HASH

VOLUME /output

CMD ["cp", "-r", "output/.", "/output"]
